{
  "schema": 1,
  "rules": [
    {
      "sources": ["package.json", "package-lock.json"],
      "lanes": ["unit", "integration", "slow"],
      "reason": "dependency or command-surface change"
    },
    {
      "sources": [
        ".markdownlint-cli2.jsonc",
        ".prettierrc.json",
        "cspell.json",
        "eslint.config.mjs"
      ],
      "lanes": ["unit", "integration", "slow"],
      "reason": "global verification configuration change"
    },
    {
      "sources": [
        "scripts/run-tests.mjs",
        "scripts/run-tests-lanes.mjs",
        "scripts/task-tracker/lib/discover-test-files.mjs",
        "scripts/task-tracker/lib/test-lanes.mjs"
      ],
      "lanes": ["unit", "integration", "slow"],
      "reason": "test runner or lane classifier change"
    },
    {
      "sources": [
        "scripts/task-tracker/find-unit-tests.mjs",
        "scripts/task-tracker/lib/test-impact-selector.mjs",
        "scripts/task-tracker/test-impact-manifest.json"
      ],
      "lanes": ["unit", "integration", "slow"],
      "reason": "test-impact authority change"
    },
    {
      "sources": ["scripts/task-tracker/lib/scratch-dir.mjs"],
      "lanes": ["unit", "integration", "slow"],
      "reason": "global test sandbox helper change"
    },
    {
      "sources": [
        "scripts/task-tracker/lib/decomposition-policy.mjs",
        "scripts/task-tracker/verbs/decompose-check.mjs"
      ],
      "tests": ["scripts/tests/unit/task-tracker/lib/decomposition-policy.test.mjs"],
      "reason": "decomposition classification and linked-plan policy"
    },
    {
      "sources": [
        "scripts/task-tracker/lib/decomposition-plan-exit-guard.mjs",
        "scripts/task-tracker/states/plan.mjs",
        "scripts/task-tracker/verbs/promote.mjs"
      ],
      "tests": ["scripts/tests/unit/task-tracker/lib/decomposition-plan-exit-gate.test.mjs"],
      "reason": "Plan-exit decomposition enforcement"
    },
    {
      "sources": [
        "scripts/task-tracker/lib/split-plan.mjs",
        "scripts/task-tracker/verbs/split-plan.mjs"
      ],
      "tests": ["scripts/tests/unit/task-tracker/verbs/split-plan.test.mjs"],
      "reason": "sanctioned plan-to-child proposal and creation workflow"
    },
    {
      "sources": [
        "scripts/task-tracker/task-tracker.mjs",
        "scripts/task-tracker/lib/command-surface/routing.mjs",
        "scripts/task-tracker/lib/command-surface/catalog.mjs",
        "scripts/task-tracker/verbs/help-data.mjs"
      ],
      "tests": [
        "scripts/tests/unit/task-tracker/core/command-manifest.test.mjs",
        "scripts/tests/unit/task-tracker/lib/command-catalog-policy.test.mjs",
        "scripts/tests/unit/task-tracker/lib/command-catalog-parser-policy.test.mjs",
        "scripts/tests/unit/task-tracker/lib/decomposition-plan-exit-gate.test.mjs",
        "scripts/tests/unit/task-tracker/verbs/split-plan.test.mjs"
      ],
      "reason": "decomposition command routing, help, and parser surface"
    },
    {
      "sources": ["scripts/task-tracker/verbs/*.mjs"],
      "tests": ["scripts/tests/unit/task-tracker/verbs/*.test.mjs"],
      "reason": "CLI subprocess coverage is not completely visible through static imports"
    },
    {
      "sources": [
        "scripts/tests/**/*.test.mjs",
        "scripts/tests/fixtures/test-corpus-post-snapshot/**/*.json"
      ],
      "tests": ["scripts/tests/integration/meta/test-corpus-membership.test.mjs"],
      "reason": "test corpus membership authority change"
    },
    {
      "sources": ["scripts/tests/fixtures/test-corpus-pre-move.json"],
      "tests": [
        "scripts/tests/integration/meta/test-corpus-membership.test.mjs",
        "scripts/tests/integration/meta/package-test-corpus.test.mjs"
      ],
      "reason": "frozen test corpus authority change"
    },
    {
      "sources": [
        "scripts/tests/fixtures/test-corpus-frozen-retirements/**/*.json",
        "docs/evidence/temporary-test-retirements/**/*.md",
        "scripts/maintenance/graduate-frozen-test-retirements.mjs",
        ".github/workflows/graduate-frozen-test-retirements.yml"
      ],
      "tests": [
        "scripts/tests/integration/meta/test-corpus-membership.test.mjs",
        "scripts/tests/integration/meta/package-test-corpus.test.mjs",
        "scripts/tests/integration/meta/test-tree-layout.test.mjs",
        "scripts/tests/integration/meta/frozen-test-retirements.test.mjs",
        "scripts/tests/integration/maintenance/graduate-frozen-test-retirements.test.mjs"
      ],
      "reason": "frozen retirement authority and graduation workflow change"
    },
    {
      "sources": [
        "bin/cli.mjs",
        "scripts/task-tracker/activity-guard.mjs",
        "scripts/task-tracker/bash-guard.mjs",
        "scripts/task-tracker/source-edit-gate.mjs",
        "scripts/task-tracker/lib/apply-patch-targets.mjs",
        "scripts/review/co-review.mjs",
        "scripts/review/lib/provider-session.mjs",
        "scripts/review/lib/runtime-root.mjs",
        "scripts/review/lib/repository-boundary.mjs",
        "scripts/review/lib/protocol.mjs",
        "scripts/review/lib/start.mjs",
        "scripts/review/lib/index.mjs",
        "scripts/review/lib/archive.mjs",
        "docs/guides/github-native-coordination.md",
        "docs/guides/grok-provider.md"
      ],
      "tests": [
        "scripts/tests/integration/task-tracker/lib/co-review-reviewer-capability.test.mjs",
        "scripts/tests/slow/review/co-review-boundaries.test.mjs",
        "scripts/tests/integration/review/co-review-provider-session.test.mjs",
        "scripts/tests/unit/review/co-review-index.test.mjs",
        "scripts/tests/integration/review/co-review-fixture-cost.test.mjs",
        "scripts/tests/integration/review/co-review.test.mjs",
        "scripts/tests/integration/review/co-review-finalization.test.mjs",
        "scripts/tests/unit/task-tracker/lib/apply-patch-targets.test.mjs",
        "scripts/tests/integration/task-tracker/lib/coverage-cli.test.mjs"
      ],
      "reason": "SHA-bound one-worktree co-review authority, provider-session evidence, and installed guard behavior"
    }
  ]
}
