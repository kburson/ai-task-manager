#!/usr/bin/env node
// @story #1295 #1857
// Capture is a whole runtime writer from durable intent through child exit and
// outcome publication. Unavailable authority refuses before launching the child.
import { spawn } from 'node:child_process';
import path from 'node:path';
import { resolveRuntimeRoot } from '../lib/runtime-storage.mjs';
import { withRuntimeWrite } from '../lib/runtime-writer.mjs';
import { withLock } from '../locks.mjs';
import {
  beginCapturedAction,
  captureIssueDir,
  collectGhRequestFiles,
  completeCapturedAction,
} from '../lib/action-capture.mjs';

function requiredEnvironment(name) {
  const value = process.env[name];
  if (!value) throw new Error('missing ' + name);
  return value;
}
function expectsPipedStdin(args) {
  return args.some((argument, index) =>
    ['--input', '--body-file'].includes(argument)
      ? args[index + 1] === '-'
      : argument === '--input=-' || argument === '--body-file=-'
  );
}
