#!/usr/bin/env node
// @story #1295

import { spawn } from 'node:child_process';
import { resolveRuntimeRoot } from '../lib/runtime-storage.mjs';

import {
  classifyGhUsage,
  beginCapturedAction,
  collectGhRequestFiles,
  completeCapturedAction,
} from '../lib/action-capture.mjs';

import {
  beginObservation,
  parseGhArguments,
  readDispatchContext,
} from '../lib/graphql-usage/collection.mjs';

function warning(message) {
  process.stderr.write(
    `[aitm] action capture unavailable; continuing without capture: ${message}\n`
  );
}

function expectsPipedStdin(args) {
  return args.some((argument, index) => {
    if (['--input', '--body-file'].includes(argument)) return args[index + 1] === '-';
    return argument === '--input=-' || argument === '--body-file=-';
  });
}

async function readPipedStdin(args) {
  if (process.stdin.isTTY || !expectsPipedStdin(args)) return null;
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(Buffer.from(chunk));
  return Buffer.concat(chunks);
}

function requiredEnvironment(name) {
  const value = process.env[name];
  if (!value) throw new Error(`missing ${name}`);
  return value;
}

function startCapture(args, stdin) {
  const projectDir = resolveRuntimeRoot().projectRoot;
  try {
    return beginCapturedAction({
      projectDir,
      repository: requiredEnvironment('AITM_CAPTURE_REPOSITORY'),
      issue: requiredEnvironment('AITM_CAPTURE_ISSUE'),
      invocationId: requiredEnvironment('AITM_CAPTURE_INVOCATION_ID'),
      command: process.env.AITM_CAPTURE_COMMAND || '',
      args,
      stdin: stdin || Buffer.alloc(0),
      files: collectGhRequestFiles(args, projectDir),
    });
  } catch (error) {
    warning(error.message);
    return null;
  }
}

function finishCapture(handle, result) {
  if (!handle) return;
  try {
    completeCapturedAction(handle, result);
  } catch (error) {
    warning(error.message);
  }
}

function endpointHost(args, env) {
  const parsed = parseGhArguments(args);
  let urlHost = null;
  if (!parsed.ambiguous && ['issue', 'pr'].includes(args[0])) {
    for (const operand of parsed.operands) {
      if (!/^https?:\/\//.test(operand)) continue;
      try {
        const url = new URL(operand);
        if (/\/(issues|pull)\/\d+(?:\/|$)/.test(url.pathname)) urlHost = url.hostname;
      } catch {
        /* invalid URL is not trusted host context */
      }
    }
  }
  const repoParts = String(parsed.repository || '').split('/');
  const repositoryHost = repoParts.length === 3 ? repoParts[0] : null;
  const host = parsed.hostname || repositoryHost || urlHost || env.GH_HOST;
  if (!host) return 'api.github.com';
  if (!/^[A-Za-z0-9.-]{1,253}$/.test(host)) return null;
  return host.toLowerCase() === 'github.com' ? 'api.github.com' : host.toLowerCase();
}

async function run() {
  const args = process.argv.slice(2);
  const stdin = await readPipedStdin(args);
  const handle = process.env.AITM_CAPTURE_ISSUE ? startCapture(args, stdin) : null;
  const usage = classifyGhUsage(args, stdin);
  let privateContext = {};
  try {
    privateContext = JSON.parse(process.env.AITM_GRAPHQL_USAGE_PRIVATE || '{}');
  } catch {
    /* unavailable */
  }
  const finishUsage = usage
    ? await beginObservation({
        ...usage,
        alias: privateContext?.alias,
        context: {
          ...readDispatchContext(process.env.AITM_GRAPHQL_USAGE_DISPATCH_CONTEXT),
          args,
          variables: usage.variables,
        },
        endpointHost: endpointHost(args, process.env),
      })
    : null;
  const realGh = requiredEnvironment('AITM_CAPTURE_REAL_GH');
  const child = spawn(realGh, args, {
    cwd: process.cwd(),
    env: process.env,
    stdio: [stdin === null ? 'inherit' : 'pipe', 'pipe', 'pipe'],
  });
  if (stdin !== null) child.stdin.end(stdin);

  const stdout = [];
  const stderr = [];
  child.stdout.on('data', (chunk) => {
    const bytes = Buffer.from(chunk);
    stdout.push(bytes);
    process.stdout.write(bytes);
  });
  child.stderr.on('data', (chunk) => {
    const bytes = Buffer.from(chunk);
    stderr.push(bytes);
    process.stderr.write(bytes);
  });

  const forwardedSignals = ['SIGINT', 'SIGTERM', 'SIGHUP'];
  const signalHandlers = new Map(
    forwardedSignals.map((signal) => [
      signal,
      () => {
        if (child.exitCode === null && child.signalCode === null) child.kill(signal);
      },
    ])
  );
  for (const [signal, handler] of signalHandlers) process.on(signal, handler);
  const removeSignalHandlers = () => {
    for (const [signal, handler] of signalHandlers) process.removeListener(signal, handler);
  };

  return new Promise((resolve) => {
    let settled = false;
    child.on('error', async (error) => {
      if (settled) return;
      settled = true;
      removeSignalHandlers();
      finishCapture(handle, {
        exitCode: null,
        signal: null,
        stdout: Buffer.concat(stdout),
        stderr: Buffer.concat(stderr),
      });
      await finishUsage?.({ error });
      warning(`failed to launch gh: ${error.message}`);
      resolve(1);
    });
    child.on('close', async (code, signal) => {
      if (settled) return;
      settled = true;
      removeSignalHandlers();
      finishCapture(handle, {
        exitCode: code,
        signal,
        stdout: Buffer.concat(stdout),
        stderr: Buffer.concat(stderr),
      });
      let response = null;
      try {
        response = JSON.parse(Buffer.concat(stdout).toString());
      } catch {
        /* opaque output */
      }
      await finishUsage?.({ response, processExitCode: code, signal });
      if (signal) {
        try {
          process.kill(process.pid, signal);
          return;
        } catch (error) {
          warning(`could not preserve gh signal ${signal}: ${error.message}`);
        }
      }
      resolve(Number.isInteger(code) ? code : 1);
    });
  });
}

process.exitCode = await run();
