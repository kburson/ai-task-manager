{
  "permissions": {
    "allow": [
      "Bash(node */claude-gh-task-manager/scripts/task-tracker/task-tracker.mjs*)",
      "Bash(*/claude-gh-task-manager/scripts/gh/move-state.sh*)",
      "Bash(*/claude-gh-task-manager/scripts/gh/set-priority.sh*)",
      "Bash(gh issue create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue reopen*)",
      "Bash(gh label create*)",
      "Bash(gh api graphql*)",
      "Bash(gh project item-edit*)",
      "Bash(cat > /tmp/*)",
      "Bash(yes | cp *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/task-tracker.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/task-tracker.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/task-tracker.sh"
          }
        ]
      }
    ]
  }
}
