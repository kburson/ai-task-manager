+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+import * as launcher from '../../src/provider/claude-launch.mjs';
+const root='/Users/kpburson/.codex/worktrees/planning/ai-task-manager';
+const ws=path.join(root,'.scratch/peer-review/review-cf0c320256eb77ed12fe9e531ed9744f');
+const state=JSON.parse(readFileSync(path.join(ws,'provider/claude/launch-state.json')));
+const invitation=state.invitation;
+const text=readFileSync(invitation,'utf8');
+const routing=JSON.parse(Buffer.from(text.match(/data="([A-Za-z0-9_-]+)"/)[1],'base64url'));
+const input={repositoryRoot:root,invitation,routing};
+test('resume grants only current response, preserves model/effort/session and does not rejoin',()=>{
+ const c=launcher.buildClaudeReviewerCurrentResume(input);
+ assert.match(c.response,/-reviewer-response-2\.md$/);
+ assert.equal(c.model,'claude-opus-5'); assert.equal(c.effort,'medium');
+ const edit=c.permissions.allow.filter(x=>x.startsWith('Edit(')); assert.equal(edit.length,1);
+ assert.equal(launcher.matchesClaudeEditRule(edit[0],c.response,{projectRoot:root}),true);
+ assert.equal(launcher.matchesClaudeEditRule(edit[0],routing.response,{projectRoot:root}),false);
+ assert.equal(launcher.matchesClaudeEditRule(edit[0],routing.artifact,{projectRoot:root}),false);
+ assert.equal(c.command.args.join(' ').includes('peer-review join '),false);
+ assert.ok(c.command.args.join(' ').includes('peer-review resume '));
+ assert.equal(c.resume_previous.response,state.response);
+ assert.equal(c.resume_fingerprint,state.session_fingerprint);
+});
+test('resume refuses a changed reviewer identity',()=>{
+ assert.throws(()=>launcher.buildClaudeReviewerCurrentResume({...input,inspectAuthority:()=>({state:{protocol:{review_id:routing.review_id},participants:{reviewer:{session_fingerprint:'sha256:wrong'}}}})}),{code:'APR_IDENTITY_CONFLICT'});
+});
+test('resume refuses a non-reviewer current turn',()=>{
+ assert.throws(()=>launcher.buildClaudeReviewerCurrentResume({...input,status:()=>({state:'author-revision',paths:{response:routing.response}})}),{code:'APR_INVALID_TRANSITION'});
+});
