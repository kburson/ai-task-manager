+export function buildClaudeReviewerCurrentResume({
+  repositoryRoot, invitation, routing,
+  inspectAuthority = defaultInspectAuthority, status = defaultStatusReview,
+} = {}) {
+  const workspace = contained(realpathSync(repositoryRoot), routing.workspace, 'workspace');
+  const savedFile = path.join(workspace.absolute, 'provider', 'claude', 'launch-state.json');
+  regularFile(savedFile, 'private resume state');
+  const saved = JSON.parse(readFileSync(savedFile, 'utf8'));
+  const previous = buildClaudeReviewerResume({
+    repositoryRoot, invitation, routing: { ...routing, response: saved.response },
+  });
+  const authority = inspectAuthority(workspace.absolute);
+  const reviewer = authority.state.participants.reviewer;
+  if (!reviewer || reviewer.session_fingerprint !== saved.session_fingerprint ||
+      reviewer.model_id !== saved.model || reviewer.provider !== 'anthropic') {
+    throw new AprError('APR_IDENTITY_CONFLICT', 'Resume must retain the registered Claude reviewer.', { recovery: 'Read current protocol status and preserve the registered session.' });
+  }
+  const current = status(workspace.absolute);
+  if (current.state !== 'reviewer-turn' || current.claim?.status !== 'active') {
+    throw new AprError('APR_INVALID_TRANSITION', 'Resume requires an active reviewer turn.', { recovery: 'Read current protocol status and preserve the registered session.' });
+  }
+  if (current.review_id !== routing.review_id || current.paths.invitation !== invitation ||
+      path.resolve(repositoryRoot, authority.state.protocol.artifact.path) !== routing.artifact) {
+    throw new AprError('APR_INVITATION_INVALID', 'Resume routing differs from event authority.', { recovery: 'Read current protocol status and preserve the registered session.' });
+  }
+  const base = buildClaudeReviewerLaunch({
+    repositoryRoot, invitation, routing: { ...routing, response: current.paths.response },
+    model: saved.model, effort: saved.effort,
+  });
+  regularFile(base.response, 'pending response');
+  const resumeCommand = renderCommand(['peer-review', 'resume', base.workspace]);
+  const submitCommand = renderCommand(['peer-review', 'submit', base.workspace]);
+  const allow = Object.freeze(['Read', 'Glob', 'Grep',
+    encodeClaudeBashRule(['peer-review', 'status', base.workspace, '--next']),
+    encodeClaudeBashRule(['peer-review', 'resume', base.workspace]),
+    encodeClaudeBashRule(['peer-review', 'submit', base.workspace]),
+    encodeClaudeEditRule(base.response)]);
+  const args = [...base.command.args.slice(0, base.command.args.indexOf('--allowedTools') + 1), ...allow];
+  args[1] = `Continue your existing reviewer session. Run exactly: ${resumeCommand}. ` +
+    `The current authorized response is ${base.response}. Read the latest Author response and ` +
+    `updated artifact, finish your review, and edit only this pending response. Preserve protected metadata. ` +
+    `Do not rejoin through the original invitation, edit the artifact, or use Git. ` +
+    `Then run exactly: ${submitCommand}.`;
+  return Object.freeze({ ...base, permissions: Object.freeze({ allow }),
+    command: Object.freeze({ ...base.command, args: Object.freeze(args) }),
+    resume_previous: previous, resume_revision: authority.state.protocol.revision,
+    resume_fingerprint: saved.session_fingerprint });
+}
