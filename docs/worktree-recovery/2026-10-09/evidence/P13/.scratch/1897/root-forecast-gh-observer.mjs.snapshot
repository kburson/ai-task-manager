import fs from 'node:fs';
import {ghClient} from '../../scripts/gh/lib/gh-client.mjs';
const output=new URL('./root-forecast-gh-trace.jsonl',import.meta.url);
const actualSpawn=ghClient.spawn;
let count=0;
ghClient.spawn=function(...args){
 const child=Reflect.apply(actualSpawn,this,args);
 if(args[0]!=='gh')return child;
 const id=process.pid+':'+(++count), started=Date.now();
 const base={id,argv:args[1],timeoutMs:args[2]?.timeout??null};
 const log=row=>fs.appendFileSync(output,JSON.stringify({...base,...row})+'\n');
 log({phase:'spawn',at:new Date().toISOString()});
 let outBytes=0,errBytes=0;
 child.stdout?.on('data',b=>{outBytes+=Buffer.byteLength(b)});
 child.stderr?.on('data',b=>{errBytes+=Buffer.byteLength(b)});
 if(child.stdin){
  const actualEnd=child.stdin.end;
  child.stdin.end=function(...endArgs){
   if(typeof endArgs[0]==='string'||Buffer.isBuffer(endArgs[0])){
    try{const v=JSON.parse(String(endArgs[0]));const queryName=v.query?.match(/\b(?:query|mutation)\s+(\w+)/)?.[1]??'anonymous';const variablesShape=Object.fromEntries(Object.entries(v.variables??{}).map(([k,v])=>[k,Array.isArray(v)?{type:'array',length:v.length}:{type:typeof v}]));log({phase:'graphql-input',queryName,inputBytes:Buffer.byteLength(endArgs[0]),variablesShape});}catch{log({phase:'non-json-input',inputBytes:Buffer.byteLength(endArgs[0])});}
   }
   return Reflect.apply(actualEnd,this,endArgs);
  };
 }
 child.on('error',e=>log({phase:'error',code:e.code??null,elapsedMs:Date.now()-started}));
 child.on('close',(code,signal)=>log({phase:'close',code,signal,elapsedMs:Date.now()-started,outBytes,errBytes}));
 return child;
};
