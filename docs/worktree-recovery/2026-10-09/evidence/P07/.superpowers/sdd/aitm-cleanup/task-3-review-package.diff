+    '.git',
+    'objects',
+    blob.slice(0, 2),
+    blob.slice(2)
+  );
+  assert.equal(existsSync(looseBlob), true);
+  rmSync(looseBlob);
+
+  assert.throws(
+    () => hydrate(history),
