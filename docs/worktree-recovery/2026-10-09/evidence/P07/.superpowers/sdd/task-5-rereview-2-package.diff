+export function pngDimensions(png) {
+  if (
+    png.length < PNG_SIGNATURE.length ||
+    !png.subarray(0, PNG_SIGNATURE.length).equals(PNG_SIGNATURE)
+  ) {
+    throw new Error('EPUB cover image is not a PNG');
