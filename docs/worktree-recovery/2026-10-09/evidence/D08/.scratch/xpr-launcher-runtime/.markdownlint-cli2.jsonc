{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
  },
  "ignores": [
    "node_modules/**",
    "coverage/**",
    ".scratch/**",
    ".ai-task-manager/memory/**",
    ".ai-task-manager/templates/**",
    ".claude/commands/task.md",
    "AGENTS.md",
    "templates/author-response.md",
    "templates/reviewer-response.md",
    "templates/human-decision.md",
    "test/golden/templates/**",
    "docs/peer-reviews/**/*author-response-*.md",
    "docs/peer-reviews/**/*reviewer-response-*.md",
  ],
}
