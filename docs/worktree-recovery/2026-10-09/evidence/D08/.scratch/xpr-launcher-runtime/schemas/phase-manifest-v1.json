{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.phase-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "record_id",
    "phase_index",
    "phase_kind",
    "phase_status",
    "commit_mode",
    "authority_assurance",
    "residual_risk",
    "phase_start_commit",
    "final_commit",
    "artifact_path",
    "artifact_history",
    "participants",
    "turns",
    "identity_changes",
    "claims",
    "recoveries",
    "supplements",
    "authority"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.phase-manifest/v1" },
    "review_id": { "$ref": "event-v1.json#/$defs/id" },
    "record_id": { "$ref": "event-v1.json#/$defs/id" },
    "phase_index": { "$ref": "event-v1.json#/$defs/nonNegative" },
    "phase_kind": { "enum": ["spec", "plan"] },
    "phase_status": { "const": "accepted" },
    "commit_mode": { "enum": ["normal", "no-commit"] },
    "authority_assurance": { "type": "string", "minLength": 1 },
    "residual_risk": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "phase_start_commit": { "type": ["string", "null"] },
    "final_commit": { "type": ["string", "null"] },
    "artifact_path": { "$ref": "event-v1.json#/$defs/path" },
    "artifact_history": { "type": "array" },
    "participants": { "type": "object" },
    "turns": { "type": "array" },
    "identity_changes": { "type": "array" },
    "claims": { "type": "array" },
    "recoveries": { "type": "array" },
    "supplements": { "type": "array" },
    "authority": { "type": "object" }
  }
}
