{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.protocol/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "sequence",
    "revision",
    "state",
    "current_actor",
    "commit_mode",
    "max_turns",
    "claim_ttl_ms",
    "authority",
    "startup",
    "reviewer_boundary",
    "transports",
    "turns_used",
    "artifact",
    "claims",
    "challenges",
    "supplements",
    "deliveries",
    "intervention",
    "terminal_evidence",
    "next_action"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.protocol/v1" },
    "review_id": { "type": ["string", "null"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 0 },
    "state": { "type": ["string", "null"] },
    "current_actor": { "type": ["string", "null"] },
    "commit_mode": { "type": ["string", "null"] },
    "max_turns": { "type": "integer", "minimum": 0 },
    "claim_ttl_ms": { "type": "integer", "minimum": 0 },
    "authority": { "type": ["object", "null"] },
    "startup": {
      "$comment": "The referenced event startup admits optional sealed runtime-v1 authority for new records while preserving legacy records without runtime.",
      "anyOf": [{ "type": "null" }, { "$ref": "event-v1.json#/$defs/startup" }]
    },
    "reviewer_boundary": {
      "anyOf": [{ "type": "null" }, { "$ref": "event-v1.json#/$defs/repositoryBoundary" }]
    },
    "transports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer"],
      "properties": {
        "author": { "enum": ["manual", "resume-only", "live-wait", "native-push", null] },
        "reviewer": { "enum": ["manual", "resume-only", "live-wait", "native-push", null] }
      }
    },
    "turns_used": { "type": "integer", "minimum": 0 },
    "artifact": { "type": ["object", "null"] },
    "claims": { "type": "object" },
    "challenges": { "type": "array" },
    "supplements": { "type": "array" },
    "deliveries": { "type": "array" },
    "intervention": { "type": ["object", "null"] },
    "terminal_evidence": { "type": ["object", "null"] },
    "next_action": { "type": ["string", "null"] },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "cursor", "current_kind", "phase_turns_used", "completed"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["spec", "plan"] }
        },
        "cursor": { "type": "integer", "minimum": 0 },
        "current_kind": { "enum": ["spec", "plan"] },
        "phase_turns_used": { "type": "integer", "minimum": 0 },
        "completed": { "type": "array" }
      }
    }
  }
}
