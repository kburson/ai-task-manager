{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "record_id",
    "status",
    "acceptance_basis",
    "commit_mode",
    "authority_assurance",
    "residual_risk",
    "startup_commit",
    "final_commit",
    "artifact_path",
    "artifact_history",
    "participants",
    "turns",
    "identity_changes",
    "claims",
    "recoveries",
    "supplements",
    "authority",
    "human_decision"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.manifest/v1" },
    "review_id": { "$ref": "#/$defs/id" },
    "record_id": { "$ref": "#/$defs/id" },
    "status": {
      "enum": [
        "accepted",
        "accepted-uncommitted",
        "accepted-over-objections",
        "accepted-over-objections-uncommitted"
      ]
    },
    "acceptance_basis": { "enum": ["reviewer-consensus", "human-override"] },
    "commit_mode": { "enum": ["normal", "no-commit"] },
    "authority_assurance": { "$ref": "#/$defs/strength" },
    "residual_risk": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "uncommitted-test-evidence",
          "human-authority-unavailable",
          "detection-grade-authority"
        ]
      }
    },
    "startup_commit": { "$ref": "#/$defs/gitObject" },
    "final_commit": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/gitObject" }]
    },
    "artifact_path": { "$ref": "#/$defs/path" },
    "artifact_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactHistory" }
    },
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer"],
      "properties": {
        "author": { "$ref": "#/$defs/participant" },
        "reviewer": { "$ref": "#/$defs/participant" }
      }
    },
    "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
    "identity_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/identityChange" }
    },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "recoveries": { "type": "array", "items": { "$ref": "#/$defs/recovery" } },
    "supplements": {
      "type": "array",
      "items": { "$ref": "#/$defs/supplement" }
    },
    "authority": { "$ref": "#/$defs/authority" },
    "human_decision": {
      "anyOf": [{ "type": "null" }, { "$ref": "human-decision-v1.json" }]
    },
    "runtime": { "$ref": "runtime-v1.json" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "positive": { "type": "integer", "minimum": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "strength": {
      "enum": [
        "unavailable",
        "cryptographic-external",
        "hardware-presence",
        "host-verified",
        "cryptographic-local",
        "unverified-test"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "path", "commit", "blob", "digest", "snapshot"],
      "properties": {
        "turn": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/path" },
        "commit": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/gitObject" }]
        },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" },
        "snapshot": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/response" }]
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "host",
        "provider",
        "model_id",
        "model_display",
        "session_fingerprint",
        "identity_source",
        "joined_at"
      ],
      "properties": {
        "role": { "enum": ["author", "reviewer"] },
        "host": { "enum": ["codex", "claude-code", "grok", "other"] },
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_display": { "type": "string", "minLength": 1 },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "identity_source": { "type": "string", "minLength": 1 },
        "joined_at": { "$ref": "#/$defs/time" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "decision",
        "reviewer_response",
        "finding_ids",
        "author_response",
        "artifact",
        "commit",
        "snapshot"
      ],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "decision": { "enum": ["accepted", "revisions-requested"] },
        "reviewer_response": { "$ref": "#/$defs/response" },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "author_response": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/response" }]
        },
        "artifact": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        },
        "commit": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/gitObject" }]
        },
        "snapshot": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/response" }]
        }
      }
    },
    "identityChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "role", "identity"],
      "properties": {
        "sequence": { "$ref": "#/$defs/positive" },
        "role": { "enum": ["author", "reviewer"] },
        "identity": { "$ref": "#/$defs/participant" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "role",
        "session_fingerprint",
        "host",
        "claimed_at",
        "last_activity_at",
        "expires_at"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["author", "reviewer"] },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "host": { "enum": ["codex", "claude-code", "grok", "other"] },
        "claimed_at": { "$ref": "#/$defs/time" },
        "last_activity_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "type",
        "role",
        "outgoing_session_fingerprint",
        "incoming_session_fingerprint",
        "attestation"
      ],
      "properties": {
        "sequence": { "$ref": "#/$defs/positive" },
        "type": {
          "enum": [
            "same-session-reclaim",
            "participant-replaced",
            "continued-to-reviewer",
            "continued-to-author"
          ]
        },
        "role": { "enum": ["author", "reviewer", null] },
        "outgoing_session_fingerprint": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "incoming_session_fingerprint": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "attestation": {
          "anyOf": [{ "type": "null" }, { "$ref": "event-v1.json#/$defs/attestation" }]
        }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_id",
        "digest",
        "target_role",
        "target_turn",
        "content_retention",
        "acknowledged_at",
        "parameters",
        "attestation",
        "acknowledgment_response"
      ],
      "properties": {
        "supplement_id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" },
        "target_role": { "enum": ["author", "reviewer"] },
        "target_turn": { "$ref": "#/$defs/positive" },
        "content_retention": { "const": "scratch-only" },
        "acknowledged_at": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/time" }]
        },
        "parameters": { "$ref": "event-v1.json#/$defs/supplementParameters" },
        "attestation": { "$ref": "event-v1.json#/$defs/attestation" },
        "acknowledgment_response": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/response" }]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "verifier_id",
        "verifier_fingerprint",
        "assurance_grade",
        "signer_strength"
      ],
      "properties": {
        "kind": { "enum": ["ed25519", "host"] },
        "verifier_id": { "type": "string", "minLength": 1 },
        "verifier_fingerprint": { "$ref": "#/$defs/digest" },
        "assurance_grade": { "enum": ["hardened", "mutable-local", "test-fixture"] },
        "signer_strength": { "$ref": "#/$defs/strength" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "verifier", "acceptance_attestation"],
      "properties": {
        "policy": { "enum": ["prevention-required", "detection-allowed", "unavailable"] },
        "verifier": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/verifier" }]
        },
        "acceptance_attestation": {
          "anyOf": [{ "type": "null" }, { "$ref": "event-v1.json#/$defs/attestation" }]
        }
      }
    }
  }
}
