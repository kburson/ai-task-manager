{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.response/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "role",
    "turn",
    "commit_mode",
    "authority_assurance",
    "artifact_path",
    "artifact_commit",
    "artifact_blob",
    "artifact_digest",
    "agent",
    "started_at",
    "submitted_at",
    "finding_ids",
    "answered_finding_ids",
    "acknowledged_supplement_ids"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.response/v1" },
    "review_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "role": { "enum": ["author", "reviewer"] },
    "turn": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "commit_mode": { "enum": ["normal", "no-commit"] },
    "authority_assurance": {
      "enum": [
        "unavailable",
        "cryptographic-external",
        "hardware-presence",
        "host-verified",
        "cryptographic-local",
        "unverified-test"
      ]
    },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_commit": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      ]
    },
    "artifact_blob": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      ]
    },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "provider",
        "model_id",
        "model_display",
        "session_fingerprint",
        "identity_source"
      ],
      "properties": {
        "host": { "enum": ["codex", "claude-code", "grok", "other"] },
        "provider": { "enum": ["openai", "anthropic", "xai", "other"] },
        "model_id": { "type": "string", "minLength": 1 },
        "model_display": { "type": "string", "minLength": 1 },
        "session_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "identity_source": { "enum": ["runtime", "declared"] }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "submitted_at": {
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^R[1-9][0-9]*-F[0-9]{3}$" }
    },
    "answered_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^R[1-9][0-9]*-F[0-9]{3}$" }
    },
    "acknowledged_supplement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    }
  }
}
