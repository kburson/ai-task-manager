        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "overrideCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "terminal", "parameters", "attestation"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "terminal": { "$ref": "#/$defs/terminalCommitted" },
        "parameters": { "$ref": "#/$defs/overrideParameters" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "overrideUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "terminal", "parameters", "attestation"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "terminal": { "$ref": "#/$defs/terminalUncommitted" },
        "parameters": { "$ref": "#/$defs/overrideParameters" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "abandonment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "reason", "retained_paths"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "retained_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "successor_review_id", "retained_paths"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "successor_review_id": { "$ref": "#/$defs/id" },
        "retained_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "claimPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim"],
      "properties": { "claim": { "$ref": "#/$defs/claim" } }
    },
    "identityChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "identity": { "$ref": "#/$defs/participant" }
      }
    },
    "challengePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge"],
      "properties": { "challenge": { "$ref": "#/$defs/challenge" } }
    },
    "challengeIdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id"],
      "properties": { "challenge_id": { "$ref": "#/$defs/id" } }
    },
    "supplementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplement"],
      "properties": { "supplement": { "$ref": "#/$defs/supplement" } }
    },
    "deliveryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery"],
      "properties": { "delivery": { "$ref": "#/$defs/delivery" } }
