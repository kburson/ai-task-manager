{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "sequence", "revision", "type", "actor", "at", "payload"],
  "properties": {
    "schema": { "const": "ai-peer-review.event/v1" },
    "review_id": { "$ref": "#/$defs/id" },
    "sequence": { "$ref": "#/$defs/positive" },
    "revision": { "$ref": "#/$defs/nonNegative" },
    "type": { "type": "string" },
    "actor": { "anyOf": [{ "const": "system" }, { "$ref": "#/$defs/digest" }] },
    "at": { "$ref": "#/$defs/time" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "review-created" },
        "payload": { "$ref": "#/$defs/reviewCreated" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-joined" },
        "payload": { "$ref": "#/$defs/reviewerJoined" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-revisions-requested" },
        "payload": { "$ref": "#/$defs/reviewDecision" }
      }
    },
    {
      "properties": {
        "type": { "const": "reviewer-accepted" },
        "payload": { "$ref": "#/$defs/reviewDecision" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-revision-committed" },
        "payload": { "$ref": "#/$defs/authorRevision" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-revision-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/authorRevisionUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-closing-round-committed" },
        "payload": { "$ref": "#/$defs/authorClosing" }
      }
    },
    {
      "properties": {
        "type": { "const": "author-closing-round-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/authorClosingUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "finalization-started" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    {
      "properties": {
        "type": { "const": "acceptance-committed" },
        "payload": { "$ref": "#/$defs/terminalCommittedPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "acceptance-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/terminalUncommittedPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "phase-acceptance-committed" },
        "payload": { "$ref": "#/$defs/phaseAcceptanceCommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "phase-acceptance-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/phaseAcceptanceUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "phase-artifact-committed" },
        "payload": { "$ref": "#/$defs/phaseArtifactCommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "phase-artifact-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/phaseArtifactUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "intervention-entered" },
        "payload": { "$ref": "#/$defs/intervention" }
      }
    },
    {
      "properties": {
        "type": { "const": "continued-to-reviewer" },
        "payload": { "$ref": "#/$defs/continuation" }
      }
    },
    {
      "properties": {
        "type": { "const": "continued-to-author" },
        "payload": { "$ref": "#/$defs/continuation" }
      }
    },
    {
      "properties": {
        "type": { "const": "same-session-reclaim" },
        "payload": { "$ref": "#/$defs/reclaim" }
      }
    },
    {
      "properties": {
        "type": { "const": "participant-replaced" },
        "payload": { "$ref": "#/$defs/replacement" }
      }
    },
    {
      "properties": {
        "type": { "const": "override-committed" },
        "payload": { "$ref": "#/$defs/overrideCommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "override-sealed-no-commit" },
        "payload": { "$ref": "#/$defs/overrideUncommitted" }
      }
    },
    {
      "properties": {
        "type": { "const": "abandoned" },
        "payload": { "$ref": "#/$defs/abandonment" }
      }
    },
    {
      "properties": {
        "type": { "const": "superseded" },
        "payload": { "$ref": "#/$defs/supersession" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn-claimed" },
        "payload": { "$ref": "#/$defs/claimPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "identity-changed" },
        "payload": { "$ref": "#/$defs/identityChange" }
      }
    },
    {
      "properties": {
        "type": { "const": "challenge-requested" },
        "payload": { "$ref": "#/$defs/challengePayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "challenge-superseded" },
        "payload": { "$ref": "#/$defs/challengeIdPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "supplement-registered" },
        "payload": { "$ref": "#/$defs/supplementPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "delivery-written" },
        "payload": { "$ref": "#/$defs/deliveryPayload" }
      }
    },
    {
      "properties": {
        "type": { "const": "delivery-acknowledged" },
        "payload": { "$ref": "#/$defs/deliveryIdPayload" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "time": { "type": "string", "format": "date-time" },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonNegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "role": { "enum": ["author", "reviewer"] },
    "host": { "enum": ["codex", "claude-code", "grok", "other"] },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "host",
        "provider",
        "model_id",
        "model_display",
        "session_fingerprint",
        "identity_source",
        "joined_at"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "host": { "$ref": "#/$defs/host" },
        "provider": { "enum": ["openai", "anthropic", "xai", "other"] },
        "model_id": { "type": "string", "minLength": 1 },
        "model_display": { "type": "string", "minLength": 1 },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "identity_source": { "enum": ["runtime", "declared"] },
        "joined_at": { "$ref": "#/$defs/time" }
      }
    },
    "initialArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "head", "blob", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "head": { "$ref": "#/$defs/gitObject" },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "role",
        "session_fingerprint",
        "host",
        "claimed_at",
        "last_activity_at",
        "expires_at",
        "pid"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "session_fingerprint": { "$ref": "#/$defs/digest" },
        "host": { "$ref": "#/$defs/host" },
        "claimed_at": { "$ref": "#/$defs/time" },
        "last_activity_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "pid": { "$ref": "#/$defs/positive" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "strength",
        "signer_id",
        "signer_fingerprint",
        "challenge_digest",
        "verified_at"
      ],
      "properties": {
        "source": { "enum": ["detached-signature", "host-approval", "test-fixture"] },
        "strength": {
          "enum": [
            "cryptographic-external",
            "hardware-presence",
            "host-verified",
            "cryptographic-local",
            "unverified-test"
          ]
        },
        "signer_id": { "type": "string", "minLength": 1 },
        "signer_fingerprint": { "type": "string", "minLength": 1 },
        "challenge_digest": { "$ref": "#/$defs/digest" },
        "verified_at": { "$ref": "#/$defs/time" }
      }
    },
    "terminalCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifest_digest"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "terminalUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_digest", "manifest_digest"],
      "properties": {
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "challenge_id",
        "review_id",
        "intervention_id",
        "protocol_revision",
        "action",
        "parameters_digest",
        "nonce",
        "expires_at"
      ],
      "properties": {
        "schema": { "const": "ai-peer-review.grant-challenge/v1" },
        "challenge_id": { "$ref": "#/$defs/id" },
        "review_id": { "$ref": "#/$defs/id" },
        "intervention_id": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "protocol_revision": { "$ref": "#/$defs/nonNegative" },
        "action": {
          "enum": [
            "pin-verifier",
            "continue",
            "supplement",
            "accept-over-objections",
            "replace-participant"
          ]
        },
        "parameters_digest": { "$ref": "#/$defs/digest" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "expires_at": { "$ref": "#/$defs/time" }
      }
    },
    "continueParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additional_turns",
        "resulting_effective_maximum",
        "resume_role",
        "focus_path",
        "focus_digest"
      ],
      "properties": {
        "additional_turns": { "$ref": "#/$defs/positive" },
        "resulting_effective_maximum": { "$ref": "#/$defs/positive" },
        "resume_role": { "$ref": "#/$defs/role" },
        "focus_path": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }] },
        "focus_digest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
      }
    },
    "supplementParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "target_role", "target_turn"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "target_role": { "$ref": "#/$defs/role" },
        "target_turn": { "$ref": "#/$defs/positive" }
      }
    },
    "replacementParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "outgoing_claim_id",
        "outgoing_session_fingerprint",
        "incoming_session_fingerprint"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "outgoing_claim_id": { "$ref": "#/$defs/id" },
        "outgoing_session_fingerprint": { "$ref": "#/$defs/digest" },
        "incoming_session_fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "overrideParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_blob",
        "artifact_digest",
        "final_round",
        "reviewer_response_path",
        "reviewer_response_digest",
        "unresolved_finding_ids",
        "human_rationale_digest"
      ],
      "properties": {
        "artifact_path": { "$ref": "#/$defs/path" },
        "artifact_blob": { "$ref": "#/$defs/gitObject" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "final_round": { "$ref": "#/$defs/positive" },
        "reviewer_response_path": { "$ref": "#/$defs/path" },
        "reviewer_response_digest": { "$ref": "#/$defs/digest" },
        "unresolved_finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "human_rationale_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_id",
        "digest",
        "target_role",
        "target_turn",
        "content_retention",
        "acknowledged_at",
        "parameters",
        "attestation"
      ],
      "properties": {
        "supplement_id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" },
        "target_role": { "$ref": "#/$defs/role" },
        "target_turn": { "$ref": "#/$defs/positive" },
        "content_retention": { "const": "scratch-only" },
        "acknowledged_at": { "type": "null" },
        "parameters": { "$ref": "#/$defs/supplementParameters" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_id", "recipient", "digest"],
      "properties": {
        "delivery_id": { "$ref": "#/$defs/id" },
        "recipient": { "$ref": "#/$defs/role" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_mode",
        "max_turns",
        "claim_ttl_ms",
        "authority",
        "artifact",
        "author",
        "startup"
      ],
      "properties": {
        "commit_mode": { "enum": ["normal", "no-commit"] },
        "max_turns": { "$ref": "#/$defs/positive" },
        "claim_ttl_ms": {
          "type": "integer",
          "minimum": 3600000,
          "maximum": 9007199254740991,
          "multipleOf": 3600000
        },
        "authority": { "$ref": "#/$defs/authority" },
        "artifact": { "$ref": "#/$defs/initialArtifact" },
        "author": { "$ref": "#/$defs/participant" },
        "startup": { "$ref": "#/$defs/startup" },
        "phases": { "$ref": "#/$defs/phases" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["spec", "plan"] }
        }
      }
    },
    "startupContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "repository_root",
        "artifact_kind",
        "artifact_name",
        "review_date",
        "reviews_root",
        "review_path_template",
        "issue"
      ],
      "properties": {
        "schema": { "const": "ai-peer-review.context/v1" },
        "review_id": { "$ref": "#/$defs/id" },
        "repository_root": { "type": "string", "minLength": 1 },
        "artifact_kind": { "enum": ["spec", "plan"] },
        "artifact_name": { "$ref": "#/$defs/id" },
        "review_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reviews_root": { "$ref": "#/$defs/path" },
        "review_path_template": { "type": "string", "minLength": 1 },
        "issue": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/positive" }] }
      }
    },
    "noCommitBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "index_digest", "worktree_digest", "changed_paths"],
      "properties": {
        "head": { "$ref": "#/$defs/gitObject" },
        "index_digest": { "$ref": "#/$defs/digest" },
        "worktree_digest": { "$ref": "#/$defs/digest" },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "source_path", "digest"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "status": { "type": "string", "minLength": 2, "maxLength": 2 },
              "source_path": {
                "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }]
              },
              "digest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
            }
          }
        }
      }
    },
    "repositoryBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "index_digest", "refs_digest", "worktree_digest"],
      "properties": {
        "head": { "$ref": "#/$defs/gitObject" },
        "branch": { "type": "string", "minLength": 1 },
        "index_digest": { "$ref": "#/$defs/digest" },
        "refs_digest": { "$ref": "#/$defs/digest" },
        "worktree_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "bootstrapEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge", "parameters", "attestation"],
      "properties": {
        "challenge": { "$ref": "#/$defs/challenge" },
        "parameters": { "$ref": "#/$defs/pinVerifierParameters" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "pinVerifierParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_fingerprint",
        "assurance_grade",
        "authority_policy",
        "artifact_path",
        "artifact_kind",
        "reviews_root",
        "path_template",
        "issue_id",
        "maximum_turns",
        "commit_mode"
      ],
      "properties": {
        "verifier_fingerprint": { "$ref": "#/$defs/digest" },
        "assurance_grade": { "enum": ["hardened", "mutable-local", "test-fixture"] },
        "authority_policy": {
          "enum": ["prevention-required", "detection-allowed", "unavailable"]
        },
        "artifact_path": { "$ref": "#/$defs/path" },
        "artifact_kind": { "enum": ["spec", "plan"] },
        "reviews_root": { "$ref": "#/$defs/path" },
        "path_template": { "type": "string", "minLength": 1 },
        "issue_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/positive" }] },
        "maximum_turns": { "$ref": "#/$defs/positive" },
        "commit_mode": { "enum": ["normal", "no-commit"] }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "context_digest",
        "destination",
        "author_startup_digest",
        "reviewer_invitation_digest",
        "transport_mode",
        "author_transport_capability",
        "no_commit_baseline",
        "bootstrap"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/startupContext" },
        "context_digest": { "$ref": "#/$defs/digest" },
        "destination": { "$ref": "#/$defs/path" },
        "author_startup_digest": { "$ref": "#/$defs/digest" },
        "reviewer_invitation_digest": { "$ref": "#/$defs/digest" },
        "transport_mode": { "enum": ["manual", "resume-only", "automatic-required"] },
        "author_transport_capability": {
          "enum": ["manual", "resume-only", "live-wait", "native-push"]
        },
        "no_commit_baseline": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/noCommitBaseline" }]
        },
        "bootstrap": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/bootstrapEvidence" }]
        },
        "runtime": { "$ref": "runtime-v1.json" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_policy", "challenge_ttl_ms", "verifier"],
      "properties": {
        "authority_policy": {
          "enum": ["prevention-required", "detection-allowed", "unavailable"]
        },
        "challenge_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "verifier": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "verifier_id",
                "verifier_fingerprint",
                "public_key",
                "assurance_grade",
                "signer_strength"
              ],
              "properties": {
                "kind": { "enum": ["ed25519", "host"] },
                "verifier_id": { "type": "string", "minLength": 1 },
                "verifier_fingerprint": { "$ref": "#/$defs/digest" },
                "public_key": { "type": ["string", "null"] },
                "assurance_grade": {
                  "enum": ["hardened", "mutable-local", "test-fixture"]
                },
                "signer_strength": {
                  "enum": [
                    "cryptographic-external",
                    "hardware-presence",
                    "host-verified",
                    "cryptographic-local",
                    "unverified-test"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "reviewerJoined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "transport_capability", "repository_boundary"],
      "properties": {
        "reviewer": { "$ref": "#/$defs/participant" },
        "transport_capability": {
          "enum": ["manual", "resume-only", "live-wait", "native-push"]
        },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" }
      }
    },
    "reviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "response", "finding_ids"],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "authorRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "response", "artifact", "commit", "repository_boundary"],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "commit": { "$ref": "#/$defs/gitObject" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" }
      }
    },
    "authorClosing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "response",
        "artifact",
        "commit",
        "repository_boundary",
        "intervention_id",
        "reason",
        "interrupted_state"
      ],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "commit": { "$ref": "#/$defs/gitObject" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" },
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "const": "turn-budget-exhausted" },
        "interrupted_state": { "const": "reviewer-turn" }
      }
    },
    "authorRevisionUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "response", "artifact", "snapshot", "repository_boundary"],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "snapshot": { "$ref": "#/$defs/response" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" }
      }
    },
    "authorClosingUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "response",
        "artifact",
        "snapshot",
        "repository_boundary",
        "intervention_id",
        "reason",
        "interrupted_state"
      ],
      "properties": {
        "turn": { "$ref": "#/$defs/positive" },
        "response": { "$ref": "#/$defs/response" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "snapshot": { "$ref": "#/$defs/response" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" },
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "const": "turn-budget-exhausted" },
        "interrupted_state": { "const": "reviewer-turn" }
      }
    },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "terminalCommittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal"],
      "properties": { "terminal": { "$ref": "#/$defs/terminalCommitted" } }
    },
    "terminalUncommittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal"],
      "properties": { "terminal": { "$ref": "#/$defs/terminalUncommitted" } }
    },
    "phaseAcceptanceCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "kind", "artifact", "manifest", "commit"],
      "properties": {
        "cursor": { "$ref": "#/$defs/nonNegative" },
        "kind": { "enum": ["spec", "plan"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "manifest": { "$ref": "#/$defs/response" },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "phaseAcceptanceUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "kind", "artifact", "manifest", "snapshot"],
      "properties": {
        "cursor": { "$ref": "#/$defs/nonNegative" },
        "kind": { "enum": ["spec", "plan"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "manifest": { "$ref": "#/$defs/response" },
        "snapshot": { "$ref": "#/$defs/response" }
      }
    },
    "phaseArtifactCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "kind", "artifact", "commit", "repository_boundary"],
      "properties": {
        "cursor": { "$ref": "#/$defs/nonNegative" },
        "kind": { "enum": ["spec", "plan"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "commit": { "$ref": "#/$defs/gitObject" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" }
      }
    },
    "phaseArtifactUncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "kind", "artifact", "snapshot", "repository_boundary"],
      "properties": {
        "cursor": { "$ref": "#/$defs/nonNegative" },
        "kind": { "enum": ["spec", "plan"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "snapshot": { "$ref": "#/$defs/response" },
        "repository_boundary": { "$ref": "#/$defs/repositoryBoundary" }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "reason", "interrupted_state"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "reason": { "enum": ["turn-budget-exhausted", "stale-claim", "participant-loss"] },
        "interrupted_state": { "enum": ["reviewer-turn", "author-revision"] }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_id",
        "additional_turns",
        "effective_max_turns",
        "parameters",
        "attestation"
      ],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "additional_turns": { "$ref": "#/$defs/positive" },
        "effective_max_turns": { "$ref": "#/$defs/positive" },
        "parameters": { "$ref": "#/$defs/continueParameters" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "reclaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "old_claim", "new_claim"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/id" },
        "old_claim": { "$ref": "#/$defs/claim" },
        "new_claim": { "$ref": "#/$defs/claim" }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_id",
