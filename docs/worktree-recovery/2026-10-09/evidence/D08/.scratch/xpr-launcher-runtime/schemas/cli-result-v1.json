{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-peer-review.cli-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "review_id",
    "record_id",
    "state",
    "next_action",
    "review",
    "paths"
  ],
  "properties": {
    "schema": { "const": "ai-peer-review.cli-result/v1" },
    "command": {
      "enum": [
        "start",
        "advance",
        "join",
        "status",
        "resume",
        "submit",
        "supplement",
        "continue",
        "finalize",
        "recover",
        "abandon",
        "supersede",
        "consolidate"
      ]
    },
    "review_id": { "$ref": "#/$defs/id" },
    "record_id": { "$ref": "#/$defs/id" },
    "state": { "$ref": "#/$defs/state" },
    "next_action": {
      "oneOf": [
        { "$ref": "#/$defs/action" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "command"],
          "properties": {
            "action": { "$ref": "#/$defs/action" },
            "command": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "phases": { "$ref": "#/$defs/phases" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_turns": { "$ref": "#/$defs/positive" },
        "claim_ttl_ms": { "$ref": "#/$defs/positive" },
        "commit_mode": { "enum": ["normal", "no-commit"] },
        "authority_assurance": {
          "enum": [
            "unavailable",
            "cryptographic-external",
            "hardware-presence",
            "host-verified",
            "cryptographic-local",
            "unverified-test"
          ]
        },
        "mode_notice": { "type": "string", "minLength": 1 },
        "owned_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/authority" },
            { "$ref": "#/$defs/attestation" }
          ]
        },
        "commit": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/gitObject" }]
        },
        "recovered": { "type": "boolean" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "acceptance_basis": { "enum": ["reviewer-consensus", "human-override"] },
        "authority_warning": { "type": ["string", "null"] },
        "transport_mode": { "enum": ["manual", "resume-only", "automatic-required"] },
        "author_transport_capability": {
          "enum": ["manual", "resume-only", "live-wait", "native-push"]
        },
        "no_commit_baseline": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/baseline" }]
        },
        "bootstrap": {
          "anyOf": [{ "type": "null" }, { "$ref": "event-v1.json#/$defs/bootstrapEvidence" }]
        },
        "claim": { "$ref": "#/$defs/claim" },
        "delivery": { "$ref": "#/$defs/delivery" },
        "phase": { "$ref": "#/$defs/currentPhase" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "snapshot": { "$ref": "#/$defs/response" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "events": { "type": "string", "minLength": 1 },
        "author_startup": { "type": "string", "minLength": 1 },
        "reviewer_invitation": { "type": "string", "minLength": 1 },
        "invitation": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 },
        "human_decision": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "phase_manifest": { "type": "string", "minLength": 1 },
        "history": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 }
      }
    },
    "mode": { "enum": ["dry-run", "apply"] },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "source", "destination", "digest", "collision"],
        "properties": {
          "review_id": { "$ref": "#/$defs/id" },
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "collision": { "enum": ["none", "identical", "conflict"] }
        }
      }
    },
    "receipt": { "type": "string", "minLength": 1 },
    "receipt_digest": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
    },
    "claim": { "$ref": "#/$defs/statusClaim" },
    "role": { "enum": ["author", "reviewer", "human"] },
    "instructions": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "consolidate" } } },
      "then": { "required": ["mode", "mappings", "receipt", "receipt_digest"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "state": {
      "enum": [
        "awaiting-reviewer",
        "reviewer-turn",
        "author-revision",
        "acceptance-pending",
        "author-finalization",
        "awaiting-phase-artifact",
        "intervention-required",
        "accepted",
        "accepted-uncommitted",
        "accepted-over-objections",
        "accepted-over-objections-uncommitted",
        "abandoned",
        "superseded",
        "planned",
        "consolidated"
      ]
    },
    "action": {
      "enum": [
        "join-reviewer",
        "reviewer-submit",
        "author-submit",
        "finalize-acceptance",
        "commit-acceptance",
        "advance-phase-artifact",
        "human-intervention",
        null
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "verifier_id",
        "verifier_fingerprint",
        "public_key",
        "assurance_grade",
        "signer_strength"
      ],
      "properties": {
        "kind": { "enum": ["ed25519", "host"] },
        "verifier_id": { "type": "string", "minLength": 1 },
        "verifier_fingerprint": { "$ref": "#/$defs/digest" },
        "public_key": { "type": ["string", "null"] },
        "assurance_grade": { "enum": ["hardened", "mutable-local", "test-fixture"] },
        "signer_strength": {
          "enum": [
            "cryptographic-external",
            "hardware-presence",
            "host-verified",
            "cryptographic-local",
            "unverified-test"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_policy", "challenge_ttl_ms", "verifier"],
      "properties": {
        "authority_policy": {
          "enum": ["prevention-required", "detection-allowed", "unavailable"]
        },
        "challenge_ttl_ms": { "$ref": "#/$defs/positive" },
        "verifier": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/verifier" }] }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "strength",
        "signer_id",
        "signer_fingerprint",
        "challenge_digest",
        "verified_at"
      ],
      "properties": {
        "source": { "enum": ["detached-signature", "host-approval", "test-fixture"] },
        "strength": {
          "enum": [
            "cryptographic-external",
            "hardware-presence",
            "host-verified",
            "cryptographic-local",
            "unverified-test"
          ]
        },
        "signer_id": { "type": "string", "minLength": 1 },
        "signer_fingerprint": { "type": "string", "minLength": 1 },
        "challenge_digest": { "$ref": "#/$defs/digest" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "index_digest", "worktree_digest", "changed_paths"],
      "properties": {
        "head": { "$ref": "#/$defs/gitObject" },
        "index_digest": { "$ref": "#/$defs/digest" },
        "worktree_digest": { "$ref": "#/$defs/digest" },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "source_path", "digest"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 2, "maxLength": 2 },
              "source_path": { "type": ["string", "null"] },
              "digest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "host", "expires_at"],
      "properties": {
        "role": { "enum": ["author", "reviewer"] },
        "host": { "enum": ["codex", "claude-code", "grok", "other"] },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "statusClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "status", "host", "expires_at"],
      "properties": {
        "role": { "enum": ["author", "reviewer", null] },
        "status": {
          "enum": ["active", "stale", "unclaimed", "missing", "not-applicable"]
        },
        "host": { "enum": ["codex", "claude-code", "grok", "other", null] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "transport"],
      "properties": {
        "schema": { "const": "ai-peer-review.delivery/v1" },
        "status": { "enum": ["delivered", "delivery-pending"] },
        "transport": { "enum": ["manual", "resume-only", "native-push"] },
        "reason": {
          "enum": ["resume-command-failed", "resume-adapter-invalid", "native-push-failed"]
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "command"],
          "properties": {
            "available": { "const": true },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "cursor", "current_kind", "phase_turns_used", "completed"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["spec", "plan"] }
        },
        "cursor": { "type": "integer", "minimum": 0 },
        "current_kind": { "enum": ["spec", "plan"] },
        "phase_turns_used": { "type": "integer", "minimum": 0 },
        "completed": { "type": "array" }
      }
    },
    "currentPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "kind"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["spec", "plan"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "blob": { "$ref": "#/$defs/gitObject" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
