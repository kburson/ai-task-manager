import json,pathlib,hashlib,collections,datetime
ROOT=pathlib.Path('/Users/kpburson/.codex/worktrees/aitm-xpr-first-fresh/ai-task-manager')
OUT=ROOT/'docs/research/2026-09-20-review-order-experiment'
P=pathlib.Path('/Users/kpburson/.codex/sessions/2026/09/20')
cutoff='2026-09-20T22:57:24.856Z'
windows=[('A','SAR-r2-r5','19:37:53.168','20:14:23.475'),('A','SPR','20:21:54.798','20:45:08.761'),('A','XPR','20:48:32.449','21:33:08.539'),('B','XPR','21:46:22.430','22:17:08.032'),('B','SPR','22:17:08.032','22:34:55.537'),('B','SAR','22:34:55.537','22:57:24.856')]
windows=[dict(arm=a,stage=s,start='2026-09-20T'+lo+'Z',end_exclusive='2026-09-20T'+hi+'Z') for a,s,lo,hi in windows]
files={'root':'rollout-2026-09-20T14-35-08-01a0c050-aea6-7292-9933-f35602057961.jsonl','A-SPR-reviewer':'rollout-2026-09-20T15-27-45-01a0c080-dc82-78e1-8825-0a0931d7f4b4.jsonl','B-author':'rollout-2026-09-20T16-46-20-01a0c0c8-cd91-7511-983c-5403627fa61d.jsonl','B-SPR-reviewer':'rollout-2026-09-20T17-19-20-01a0c0e7-0420-7160-8d4c-388aa1d88e2d.jsonl'}
rates={'gpt-6-astra':{'uncached_input':10,'cached_input':1,'cache_write':12.5,'output':50},'gpt-5.6-sol':{'uncached_input':4,'cached_input':.4,'cache_write':5,'output':20},'claude-opus-5':{'uncached_input':5,'cached_input':.5,'cache_write_5m':6.25,'cache_write_1h':10,'output':25}}
groups={}; audits=[]
def add(a,s,role,model,effort,ts,u):
 k=(a,s,role,model,effort)
 if k not in groups:groups[k]={'arm':a,'stage':s,'role':role,'model':model,'effort':effort,'observations':0,'first_usage_at':ts,'last_usage_at':ts,'usage':{},'max_request_input_tokens':0}
 g=groups[k];g['observations']+=1;g['last_usage_at']=ts
 for n,v in u.items():g['usage'][n]=g['usage'].get(n,0)+v
 g['max_request_input_tokens']=max(g['max_request_input_tokens'],u['uncached_input']+u['cached_input']+u.get('cache_write_5m',0)+u.get('cache_write_1h',0))
for label,name in files.items():
 raw=(P/name).read_bytes(); rows=[json.loads(l) for l in raw.splitlines() if l]
 rows=[r for r in rows if r['timestamp']<cutoff]
 prev=None;dups=0;distinct=0;model=None;effort=None;meta=None
 for r in rows:
  q=r['payload']
  if r['type']=='session_meta':meta=q
  if r['type']=='turn_context':model=q['model'];effort=q.get('effort')
  if r['type']!='event_msg' or q.get('type')!='token_count' or not q.get('info'):continue
  i=q['info'];t=i['total_token_usage'];v=i['last_token_usage']
  if t==prev:dups+=1;continue
  assert not prev or all(t[k]-prev[k]==v[k] for k in t),(label,r['timestamp'])
  assert prev or t==v
  assert v['total_tokens']==v['input_tokens']+v['output_tokens']
  prev=t;distinct+=1
  ts=r['timestamp'];w=next((w for w in windows if w['start']<=ts<w['end_exclusive']),None)
  if label=='root':
   if not w:continue
   a,s,role=w['arm'],w['stage'],'author-and-orchestrator' if w['arm']=='A' else 'parent-orchestrator'
  elif label=='B-author':
   assert w and w['arm']=='B';a,s,role='B',w['stage'],'author'
  else:a,s,_=label.split('-');role='reviewer'
  u={'uncached_input':v['input_tokens']-v['cached_input_tokens'],'cached_input':v['cached_input_tokens'],'cache_write':v.get('cache_write_input_tokens',0),'output':v['output_tokens'],'reasoning_output_subset':v.get('reasoning_output_tokens',0)}
  assert u['cache_write']==0
  add(a,s,role,model,effort,ts,u)
 # Hash sanitized metadata-only evidence, never publish raw transcript or session identifiers.
 sanitized=[{'at':r['timestamp'],'usage':r['payload']['info']['total_token_usage']} for r in rows if r['type']=='event_msg' and r['payload'].get('type')=='token_count' and r['payload'].get('info')]
 audits.append({'source_label':label,'provider':'openai','cutoff_exclusive':cutoff,'distinct_usage_observations':distinct,'duplicate_cumulative_observations_ignored':dups,'cumulative_delta_mismatches':0,'counter_resets':0,'sanitized_usage_metadata_sha256':hashlib.sha256(json.dumps(sanitized,sort_keys=True).encode()).hexdigest(),'model':model,'effort':effort})
for a,base,rid in [('A','planning','review-cf0c320256eb77ed12fe9e531ed9744f'),('B','aitm-xpr-first-fresh','review-bf339e74f46697b4da5d2d19cb3c822e')]:
 state=json.loads((pathlib.Path('/Users/kpburson/.codex/worktrees')/base/'ai-task-manager/.scratch/peer-review'/rid/'provider/claude/launch-state.json').read_text())
 f=next(pathlib.Path('/Users/kpburson/.claude/projects').glob('*/'+state['session_handle']+'.jsonl'))
 rows=[json.loads(l) for l in f.read_bytes().splitlines() if l];messages={};counts=0;variation=0
 for r in rows:
  if r.get('type')!='assistant':continue
  m=r['message'];key=m['id'];counts+=1
  if key in messages and messages[key]['message']['usage']!=m['usage']:variation+=1
  messages[key]=r
 for r in sorted(messages.values(),key=lambda x:x['timestamp']):
  m=r['message'];v=m['usage'];cc=v.get('cache_creation',{})
  assert cc.get('ephemeral_1h_input_tokens',0)+cc.get('ephemeral_5m_input_tokens',0)==v.get('cache_creation_input_tokens',0)
  u={'uncached_input':v['input_tokens'],'cached_input':v.get('cache_read_input_tokens',0),'cache_write_5m':cc.get('ephemeral_5m_input_tokens',0),'cache_write_1h':cc.get('ephemeral_1h_input_tokens',0),'output':v['output_tokens'],'reasoning_output_subset':v.get('output_tokens_details',{}).get('thinking_tokens',0),'server_web_search_requests':v.get('server_tool_use',{}).get('web_search_requests',0),'server_web_fetch_requests':v.get('server_tool_use',{}).get('web_fetch_requests',0)}
  add(a,'XPR','reviewer',m['model'],'medium (launch/protocol declaration)',r['timestamp'],u)
 sanitized=[{'at':r['timestamp'],'model':r['message']['model'],'usage':r['message']['usage']} for r in sorted(messages.values(),key=lambda x:x['timestamp'])]
 audits.append({'source_label':a+'-XPR-reviewer','provider':'anthropic','assistant_records':counts,'unique_message_ids':len(messages),'duplicate_message_records_ignored':counts-len(messages),'same_id_usage_variations':variation,'deduplication':'Last observed usage per message ID; duplicate records have identical usage when variation is zero.','sanitized_usage_metadata_sha256':hashlib.sha256(json.dumps(sanitized,sort_keys=True).encode()).hexdigest(),'model':'claude-opus-5','effort':'medium declared by launch/protocol, not independently in usage'})
for g in groups.values():
 r=rates[g['model']];u=g['usage'];g['hypothetical_standard_api_usd']=round(sum(u.get(k,0)*v for k,v in r.items())/1e6,8)
 g['hypothetical_openai_fast_anthropic_standard_usd']=round(g['hypothetical_standard_api_usd']*(1 if g['model']=='claude-opus-5' else 2),8)
 g['actual_billed_usd']=None
stages=[]
for w in windows:
 rows=[g for g in groups.values() if g['arm']==w['arm'] and g['stage']==w['stage']]
 stages.append(dict(w,hypothetical_standard_api_usd=round(sum(g['hypothetical_standard_api_usd'] for g in rows),8),hypothetical_openai_fast_anthropic_standard_usd=round(sum(g['hypothetical_openai_fast_anthropic_standard_usd'] for g in rows),8),actual_billed_usd=None,coverage='Partial: excludes SAR r1 and gaps' if w['arm']=='A' else 'Observed author, reviewer where applicable, and parent orchestration within stated windows; not all-in billing'))
d={'schema':'aitm.review-order-cost-evidence/v1','captured_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'experiment_usage_cutoff_exclusive':cutoff,'currency':'USD','classification':'Sanitized observed token usage with hypothetical rate-card valuation; not an invoice or complete experiment cost','pricing_date':'2026-09-20','pricing_sources':['https://developers.openai.com/api/docs/pricing','https://developers.openai.com/api/docs/models/gpt-6-astra','https://developers.openai.com/api/docs/models/gpt-5.6-sol','https://platform.claude.com/docs/en/about-claude/pricing'],'rates_usd_per_million':rates,'pricing_assumptions':['Standard short-context OpenAI rate-card baseline; observed request inputs below 272000.','Second scenario doubles OpenAI rates for Fast mode, holding Anthropic standard. Codex usage lacks per-request service tier; priority is declared by host. Neither scenario is actual billing.','Anthropic cache-write TTL split preserved; no invented cache discount.','Output includes reasoning subset; never add reasoning again.','No taxes, negotiated rates, subscription allocation, human labor, separate tool/runtime charges, original spec authoring, abandoned reverse attempt, merge/CI, paper research, or unobserved calls.','No claim of all-in lower bound on actual paid cash. Unobserved costs are unknown, not zero.'],'windows':windows,'observed_usage_groups':list(groups.values()),'stage_subtotals':stages,'telemetry_audit':audits,'unknowns':['Initial A SAR r1 usage unavailable in inspected sources.','A preflight, metadata reorganization, integration, excluded attempt, and gaps are not valued.','Server-side or separate MCP/tool/runtime costs not comprehensively captured.','Actual billing, subscription utilization, retries absent from local usage, provider reconciliation, and final effort-effective compute are unavailable.','Timestamp attribution uses usage observation time and may place boundary-straddling requests in the next window.']}
OUT.mkdir(parents=True,exist_ok=True);(OUT/'cost-evidence.json').write_text(json.dumps(d,indent=2)+'\n')
for s in stages:print(s['arm'],s['stage'],s['hypothetical_standard_api_usd'],s['hypothetical_openai_fast_anthropic_standard_usd'])
for g in groups.values():print(g['arm'],g['stage'],g['role'],g['observations'],g['hypothetical_standard_api_usd'])
print('AUDITS',json.dumps(audits,indent=2))
