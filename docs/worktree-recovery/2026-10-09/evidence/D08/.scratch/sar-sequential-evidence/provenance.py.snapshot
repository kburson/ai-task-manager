from pathlib import Path
import hashlib,json,subprocess,re
root=Path('docs/superpowers/reviews/aitm-mcp-adapter-architecture/XPR-first/SAR')
spec='docs/superpowers/specs/2026-09-20-aitm-mcp-adapter-architecture-design.md'
sha=lambda x:hashlib.sha256(x).hexdigest()
git=lambda *args:subprocess.check_output(['git',*args])
commits=['0d2033b854e46db4bbab4424a2e798bc347f78a3','8e5fb7cf5886f8577f4de53d254ae26bd32fa2c5','20412884a31fc353096f826430c9da7962516792']
rounds=[]
for i,c in enumerate(commits,1):
 p=root/f'self-review-r{i}.md'
 text=p.read_text();head=text.split('---',2)[1]
 fields={k:v.strip().strip("'\"") for k,v in re.findall(r'^([^\n:]+): (.*)$',head,re.M)}
 digest=sha(git('show',f'{c}:{spec}'))
 assert fields['commit_sha']==c and fields['reviewed_file_sha256']==digest
 assert fields['model']=='gpt-6-astra' and fields['effort']=='high'
 assert fields['filepath']==spec and fields['turn_ordinal']==f'SAR r{i}'
 assert fields['turn_description']==f'Single Agent Review revision {i}'
 assert fields['input_worktree_status']=='clean' and fields['reviewed_input_matches_commit']=='true'
 result=commits[min(i,2)]
 rounds.append({'round':i,'review_file':str(p),'review_file_sha256':sha(p.read_bytes()),'input_commit_sha':c,'input_spec_sha256':digest,'result_spec_commit_sha':result,'result_spec_sha256':sha(git('show',f'{result}:{spec}')),'findings':[4,1,0][i-1],'spec_changed':i<3,'observed_review_recorded_at':fields['review_recorded_at']})
for i,c in [(1,commits[1]),(2,commits[2])]:
 p=root/f'self-review-r{i}.md';assert git('show',f'{c}:{p}')==p.read_bytes()
prior={}
for stage in ['XPR','SPR']:
 p=str(root.parent/stage)
 a=git('rev-parse',f'd9bc49d5d79f6c903af961439df4753127d45d6c:{p}').decode().strip()
 b=git('rev-parse',f'HEAD:{p}').decode().strip();assert a==b
 assert not git('diff','d9bc49d5d79f6c903af961439df4753127d45d6c','--',p)
 prior[stage]={'path':p,'baseline_and_final_git_tree':a,'unchanged':True}
assert Path(spec).read_bytes()==git('show',f'{commits[2]}:{spec}')
data={'sequence':['XPR','SPR','SAR'],'stage':'SAR','model':'gpt-6-astra','effort':'high','role':'same author; no delegated reviewer','genuine_author_session':'01a0c0c8-cd91-7511-983c-5403627fa61d','model_assurance':'Assigned agent model and effort, retained genuine runtime session; no independent provider attestation added by SAR','stage_start_commit':'d9bc49d5d79f6c903af961439df4753127d45d6c','baseline_spec_commit':'6edf917bdd2d0441ad9c296f69419da08307f758','baseline_spec_sha256':sha(git('show',f'6edf917bdd2d0441ad9c296f69419da08307f758:{spec}')),'setup_commit':commits[0],'artifact':spec,'rounds':rounds,'review_passes':3,'correction_cycles':2,'finding_records':5,'baseline_findings':4,'carried_forward_optional_findings':1,'introduced_by_sar_revision_findings':1,'terminal_clean':True,'final_spec_commit_sha':commits[2],'final_spec_sha256':sha(Path(spec).read_bytes()),'prior_collateral':prior,'token_cost_coverage':'unknown','active_reasoning_duration':'unknown','human_approval_claimed':False,'runtime_tests_implemented_or_executed':False}
(root/'provenance.json').write_text(json.dumps(data,indent=2)+'\n')
print('Three review-input hashes, result mappings, immutable r1/r2, final spec and prior stage trees verified')
