import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnTestChild } from '../../../scripts/run-tests-pool.mjs';
import { RUN_TESTS_MAX_BUFFER } from '../../../scripts/run-tests-report.mjs';
import { TEST_FILE_TIMEOUT_MS } from '../../../scripts/task-tracker/lib/process-timeouts.mjs';
const native = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
const root = JSON.parse(fs.readFileSync(path.join(native, '.superpowers/sdd/2026-10-02-1861-runtime-kernel/test-repair-isolation.json'))).root;
const selectionPath = path.join(native, '.scratch/1861-repair-tia-selection.json');
const selection = JSON.parse(fs.readFileSync(selectionPath));
if (selection.escalated || selection.lanes.length) throw new Error('Local full-lane escalation is prohibited');
const out = path.join(native, '.superpowers/sdd/2026-10-02-1861-runtime-kernel/tia-results-repaired');
fs.mkdirSync(out, { recursive: true });
fs.copyFileSync(selectionPath, path.join(out, 'selection.json'));
const baseEnv = Object.fromEntries(Object.entries(process.env).filter(([key]) => !['AITM_', 'AI_TASK_MANAGER_', 'TASK_TRACKER_', 'CODEX_', 'CLAUDE_', 'GIT_'].some(prefix => key.startsWith(prefix))));
process.chdir(root);
const results = [];
fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify(results));
for (const [index, file] of selection.tests.entries()) {
  fs.writeFileSync(path.join(out, 'progress.json'), JSON.stringify({ index, total: selection.tests.length, file, startedAt: new Date().toISOString() }));
  const started = Date.now();
  const result = await spawnTestChild({ full: path.join(root, file), timeout: TEST_FILE_TIMEOUT_MS, maxBuffer: RUN_TESTS_MAX_BUFFER,
    env: { ...baseEnv, AI_TASK_MANAGER_APP_NAME: 'claude', AI_TASK_MANAGER_SESSION_ID: 'fixture-tia-' + path.basename(file, '.mjs'), AITM_TEST_NO_GH_RETRY: '1', npm_config_cache: path.join(root, '.scratch/npm-cache') } });
  const log = path.join(out, String(index).padStart(4, '0') + '.log');
  fs.writeFileSync(log, result.stdout + result.stderr);
  results.push({ file, status: result.status, signal: result.signal, error: result.error ? { code: result.error.code, message: result.error.message } : null, durationMs: Date.now() - started, output: path.relative(native, log) });
  fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify(results, null, 2) + '\n');
  if (result.status !== 0 || (index + 1) % 25 === 0) console.log(JSON.stringify({ completed: index + 1, total: selection.tests.length, file, status: result.status }));
}
fs.writeFileSync(path.join(out, 'progress.json'), JSON.stringify({ completed: results.length, total: selection.tests.length, failures: results.filter(x => x.status !== 0).length, completedAt: new Date().toISOString() }));
console.log(JSON.stringify({ completed: results.length, failures: results.filter(x => x.status !== 0).length }));
process.exitCode = results.some(x => x.status !== 0) ? 1 : 0;
