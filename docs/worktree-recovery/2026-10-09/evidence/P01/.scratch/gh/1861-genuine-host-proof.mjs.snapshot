import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';import {execFileSync,spawnSync} from 'node:child_process';import {createHash} from 'node:crypto';
const cfg=JSON.parse(fs.readFileSync('.scratch/gh/1861-empty-candidate-root.json'));
const {detectProvider}=await import(pathToFileURL(path.join(cfg.root,'scripts/providers/index.mjs')));
const {resolveSessionId}=await import(pathToFileURL(path.join(cfg.root,'scripts/task-tracker/lib/session-id.mjs')));
const owner={provider:detectProvider({env:process.env}).name,sid:resolveSessionId()};
if(owner.provider!=='codex'||owner.sid!=='01a10321-abd4-7982-b7ce-73cb6f603283')throw Error('genuine host/session identity changed');
const root=fs.mkdtempSync(path.join(cfg.root,'.ai-task-manager/runtime/test-fixtures/genuine-host-'));
const childEnv={PATH:path.dirname(cfg.git)+':'+path.dirname(cfg.node)+':/usr/bin:/bin:/usr/sbin',TMPDIR:path.join(cfg.root,'output'),LANG:'en_US.UTF-8'};
for(const key of ['CODEX_THREAD_ID','CODEX_SESSION_ID','CODEX_INTERNAL_ORIGINATOR_OVERRIDE'])if(process.env[key]!==undefined)childEnv[key]=process.env[key];
const profile=path.join(cfg.root,'profile.sb'),executable=path.join(cfg.root,'bin/aitm.mjs');
const result={nativeRoot:process.cwd(),nativeHead:cfg.nativeHead,owner,fixtureRoot:root,profileSha256:createHash('sha256').update(fs.readFileSync(profile)).digest('hex'),genuineEnvKeys:Object.keys(childEnv).filter(k=>k.startsWith('CODEX_')),calls:[]};
const call=(args)=>{const child=spawnSync('/usr/bin/sandbox-exec',['-f',profile,cfg.node,executable,'migrate-runtime',...args],{cwd:root,env:childEnv,encoding:'utf8',timeout:60000});const row={args,status:child.status,signal:child.signal,stdout:child.stdout,stderr:child.stderr,error:child.error?.message};result.calls.push(row);fs.writeFileSync('.scratch/gh/1861-genuine-host-proof.json',JSON.stringify(result,null,2)+'\n');return row;};
execFileSync(cfg.git,['init','-q',root],{env:childEnv});
const first=call(['initialize-plan']);if(first.status!==0){console.log({status:'refused',...first});process.exit(1);}
const plan=JSON.parse(first.stdout);const second=call(['initialize-plan']);if(second.status!==0)throw Error('second genuine census refused');const next=JSON.parse(second.stdout);if(plan.observationDigest!==next.observationDigest)throw Error('cross-PID census projection changed');
const artifact=path.join(root,'approved.json');fs.writeFileSync(artifact,JSON.stringify(plan));const applied=call(['initialize-apply','--plan-file',artifact,'--approved-plan',plan.digest]);if(applied.status!==0){console.log({status:'apply refused',...applied});process.exit(1);}
const status=call(['status']);console.log({status:status.status===0?'complete':'status refused',owner,crossPidProjectionStable:true,fixtureRoot:root,calls:result.calls.map(x=>({args:x.args,status:x.status,signal:x.signal}))});
