import pathlib,json,subprocess,hashlib,shutil,sys,os
root=pathlib.Path.cwd()
candidate=root/'.ai-task-manager/runtime/test-fixtures/1861-pr-candidate'
backup=root/'.scratch/gh/1861-cloud-repair-original'
proof=root/'.scratch/gh/1861-cloud-repair-preservation.json'
manifest=json.loads((root/'.scratch/1861-pr-manifest.json').read_text())
def git(*args): return subprocess.check_output(['git',*args],cwd=root)
def identity(p):
 f=root/p
 if not f.exists() and not f.is_symlink(): return None
 return {'hash':hashlib.sha256(os.readlink(f).encode() if f.is_symlink() else f.read_bytes()).hexdigest(),'mode':f.lstat().st_mode}
if sys.argv[1]=='prepare':
 assert git('rev-parse','HEAD').decode().strip()=='926ed714bfb190e10368cf07fb82c64b04728781'
 paths=[p for p in manifest['paths'] if git('show','HEAD:'+p)!=(candidate/p).read_bytes()]
 (root/'.scratch/gh/1861-cloud-repair-paths.json').write_text(json.dumps(paths,indent=2)+'\n')
 print(json.dumps({'changedPaths':len(paths),'paths':paths}))
elif sys.argv[1]=='overlay':
 assert git('rev-parse','HEAD').decode().strip()=='926ed714bfb190e10368cf07fb82c64b04728781'
 assert git('branch','--show-current').decode().strip()=='codex/1857-continuation'
 assert not proof.exists(), 'Preservation proof already exists'
 paths=json.loads((root/'.scratch/gh/1861-cloud-repair-paths.json').read_text())
 dirty=set(filter(None,(git('diff','--name-only','-z','HEAD')+git('ls-files','--others','--exclude-standard','-z')).decode().split(chr(0))))
 refs=['refs/codex/snapshots/232c87b2fd75d966c874bf2b4db40e126d3826ce','codex/1857-draft']
 value={'dirty':{p:identity(p) for p in dirty},'original':{p:identity(p) for p in paths},'candidate':{p:hashlib.sha256((candidate/p).read_bytes()).hexdigest() for p in paths},'index':git('diff','--cached','--binary').decode(),'refs':{p:git('rev-parse',p).decode().strip() for p in refs}}
 proof.write_text(json.dumps(value,indent=2)+'\n')
 for p in paths:
  assert value['original'][p] is not None
  b=backup/p;b.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(root/p,b);shutil.copyfile(candidate/p,root/p)
 print(json.dumps({'overlaid':len(paths),'preserved':len(dirty)}))
elif sys.argv[1]=='restore':
 value=json.loads(proof.read_text())
 for p,v in value['original'].items(): shutil.copyfile(backup/p,root/p);os.chmod(root/p,v['mode'])
 assert all(identity(p)==v for p,v in value['dirty'].items()), 'original WIP mismatch'
 assert git('diff','--cached','--binary').decode()==value['index'], 'index changed'
 assert all(git('rev-parse',p).decode().strip()==v for p,v in value['refs'].items()), 'protected ref changed'
 assert all(hashlib.sha256(git('show','HEAD:'+p)).hexdigest()==v for p,v in value['candidate'].items()), 'commit candidate mismatch'
 original=json.loads((root/'.scratch/1861-pr-preservation-before.json').read_text())['paths']
 assert all(identity(p)==v for p,v in original.items()), 'recovered original WIP mismatch'
 print(json.dumps({'head':git('rev-parse','HEAD').decode().strip(),'preservedDirtyPaths':len(value['dirty']),'originalWipPaths':len(original),'indexPreserved':True,'refsPreserved':True}))
