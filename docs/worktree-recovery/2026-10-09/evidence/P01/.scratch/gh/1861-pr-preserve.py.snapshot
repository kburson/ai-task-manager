import pathlib,json,subprocess,hashlib,shutil,sys,os
root=pathlib.Path.cwd()
m=json.loads((root/'.scratch/1861-pr-manifest.json').read_text())
backup=root/'.scratch/1861-pr-original-bytes'
def git(*args): return subprocess.check_output(['git',*args],cwd=root)
def identity(p):
 f=root/p
 if not f.exists(): return None
 return {'hash':hashlib.sha256(os.readlink(f).encode() if f.is_symlink() else f.read_bytes()).hexdigest(),'mode':f.lstat().st_mode}
if sys.argv[1]=='capture':
 paths=set(filter(None,(git('diff','--name-only','-z','HEAD')+git('ls-files','--others','--exclude-standard','-z')).decode().split(chr(0))))
 original=[]
 for p in m['paths']:
  f=root/p;entry={'path':p,'existed':f.exists()}
  if f.exists():
   entry['mode']=f.stat().st_mode;b=backup/p;b.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(f,b)
  original.append(entry)
 refs=['refs/codex/snapshots/232c87b2fd75d966c874bf2b4db40e126d3826ce','codex/1857-draft']
 value={'paths':{p:identity(p) for p in paths},'original':original,'index':git('diff','--cached','--binary').decode(),'refs':{p:git('rev-parse',p).decode().strip() for p in refs},'head':git('rev-parse','HEAD').decode().strip()}
 (root/'.scratch/1861-pr-preservation-before.json').write_text(json.dumps(value,indent=2)+'\n')
elif sys.argv[1]=='overlay':
 before=json.loads((root/'.scratch/1861-pr-preservation-before.json').read_text())
 assert git('rev-parse','HEAD').decode().strip()==before['head']==m['base']
 assert git('branch','--show-current').decode().strip()=='codex/1857-continuation'
 for p in m['paths']:
  f=root/p;f.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(pathlib.Path(m['root'])/p,f)
elif sys.argv[1]=='restore':
 before=json.loads((root/'.scratch/1861-pr-preservation-before.json').read_text())
 for e in before['original']:
  if e['existed']: shutil.copyfile(backup/e['path'],root/e['path']);os.chmod(root/e['path'],e['mode'])
 mismatches=[p for p,v in before['paths'].items() if identity(p)!=v]
 assert not mismatches,mismatches
 assert git('diff','--cached','--binary').decode()==before['index'],'preserved index changed'
 for p,v in before['refs'].items(): assert git('rev-parse',p).decode().strip()==v
 for p in m['paths']: assert git('show','HEAD:'+p)==(pathlib.Path(m['root'])/p).read_bytes(),p
 result={'head':git('rev-parse','HEAD').decode().strip(),'verifiedOriginalPaths':len(before['paths']),'admittedPaths':len(m['paths']),'indexPreserved':True,'protectedRefsPreserved':True}
 (root/'.scratch/1861-pr-preservation-after.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
