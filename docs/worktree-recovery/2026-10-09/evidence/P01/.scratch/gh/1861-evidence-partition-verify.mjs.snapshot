
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
const cfg=JSON.parse(fs.readFileSync('.scratch/gh/1861-empty-candidate-root.json'));
const indexPath='docs/reviews/1857-remaining-work/2026-10-03-1861-empty-runtime-task2-local-tia-findings.json';
const index=JSON.parse(fs.readFileSync(path.join(cfg.root,indexPath)));
const sourceBytes=fs.readFileSync('.scratch/gh/1861-evidence-before-split.json');
const original=JSON.parse(sourceBytes);
const sha=x=>createHash('sha256').update(x).digest('hex');
assert.equal(sha(sourceBytes),index.source.sha256);
assert.equal(sourceBytes.length,index.source.bytes);
let references=0,maxBytes=0,rows=0;
const referencedFiles=new Set();
function read(ref){
 const relative=path.posix.join(path.posix.dirname(indexPath),ref.file);
 assert.ok(relative.startsWith('docs/reviews/1857-remaining-work/1861-empty-runtime-evidence/'));
 assert.ok(!referencedFiles.has(relative),'duplicate part');referencedFiles.add(relative);
 const bytes=fs.readFileSync(path.join(cfg.root,relative));
 assert.equal(bytes.length,ref.bytes);assert.equal(sha(bytes),ref.sha256);
 assert.ok(bytes.length<=index.partition.maxSubsetBytes);maxBytes=Math.max(maxBytes,bytes.length);references++;
 return JSON.parse(bytes);
}
const reconstructedRuns=index.runs.map((run,runIndex)=>{
 assert.equal(run.originalPath,runIndex===0?'':'/followupRuns/'+(runIndex-1));
 const findings=Array(run.locatedFindingCount);const seen=new Set();
 for(const ref of run.parts){const part=read(ref);assert.equal(part.issue,index.issue);assert.equal(part.runId,run.id);assert.equal(part.category,ref.category);assert.equal(part.positions.length,part.findings.length);assert.equal(part.findings.length,ref.findings);
  for(const [i,position]of part.positions.entries()){assert.ok(Number.isInteger(position)&&position>=0&&position<findings.length&&!seen.has(position),'invalid/duplicate position');seen.add(position);const row=part.findings[i];assert.equal(row.sandboxDenied===true,part.category==='recorded-eperm');findings[position]=row;rows++;}
 }
 assert.equal(seen.size,findings.length,'missing finding');
 return Object.fromEntries(run.originalKeys.filter(k=>!['followupRuns','supplementalFailureEvidence'].includes(k)).map(k=>[k,k==='findings'?findings:run.metadata[k]]));
});
const supplements=index.supplementalFailureEvidence.map((ref,i)=>{const part=read(ref);assert.equal(ref.originalPosition,i);assert.equal(part.originalPosition,i);return part.evidence;});
const reconstructed=Object.fromEntries(index.partition.originalRootKeys.map(k=>[k,k==='followupRuns'?reconstructedRuns.slice(1):k==='supplementalFailureEvidence'?supplements:reconstructedRuns[0][k]]));
assert.deepStrictEqual(reconstructed,original);
assert.equal(sha(JSON.stringify(reconstructed)),index.source.canonicalJSONSha256);
assert.equal(rows,index.partition.totalLocatedFindings);assert.equal(reconstructedRuns.length,index.partition.totalRuns);
const paths=JSON.parse(fs.readFileSync('.scratch/gh/1861-evidence-split-commit-paths.json'));
assert.equal(referencedFiles.size,paths.filter(f=>f.endsWith('.json')&&f!==indexPath).length);
for(const f of paths.filter(f=>f.endsWith('.json')&&f!==indexPath))assert.ok(referencedFiles.has(f),'unindexed evidence');
const readmePath=path.join(cfg.root,'docs/reviews/1857-remaining-work/1861-empty-runtime-evidence/README.md');
const readme=fs.readFileSync(readmePath,'utf8');
for(const match of readme.matchAll(/\]\(([^)]+)\)/g))assert.ok(fs.existsSync(path.resolve(path.dirname(readmePath),match[1])),'broken README link');
const receipt={status:'lossless',sourceBytes:sourceBytes.length,indexBytes:fs.statSync(path.join(cfg.root,indexPath)).size,sourceSha256:index.source.sha256,canonicalJSONSha256:index.source.canonicalJSONSha256,runs:reconstructedRuns.length,locatedFindings:rows,supplementalRecords:supplements.length,focusedSubsets:references,maxSubsetBytes:maxBytes,limitBytes:index.partition.maxSubsetBytes,completeObjectEqual:true,allSubsetHashesMatch:true,allSubsetLengthsMatch:true,allREADMEReferencesExist:true};
fs.writeFileSync('.scratch/gh/1861-evidence-split-verification.json',JSON.stringify(receipt,null,2)+'\n');
console.log(JSON.stringify(receipt,null,2));
