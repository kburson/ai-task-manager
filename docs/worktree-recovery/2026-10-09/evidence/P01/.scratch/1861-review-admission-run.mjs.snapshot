import fs from 'node:fs';
import path from 'node:path';
import { spawnTestChild } from '../scripts/run-tests-pool.mjs';
import { RUN_TESTS_MAX_BUFFER } from '../scripts/run-tests-report.mjs';
import { TEST_FILE_TIMEOUT_MS } from '../scripts/task-tracker/lib/process-timeouts.mjs';
const native=process.cwd();
const manifest=JSON.parse(fs.readFileSync('.scratch/1861-pr-manifest.json'));
const selection=JSON.parse(fs.readFileSync('.scratch/gh/1861-review-admission-tia.json'));
if(selection.escalated || selection.lanes.length) throw new Error('Full local lanes prohibited');
const selected=selection.tests;
fs.writeFileSync('.scratch/1861-pr-tia-run.pid',String(process.pid));

const out=path.join(native,process.argv.includes('--owned') ? '.scratch/1861-pr-tia-owned-final' : '.scratch/1861-review-admission-tia-tests');fs.mkdirSync(out,{recursive:true});
const baseEnv=Object.fromEntries(Object.entries(process.env).filter(([key])=>!['AITM_','AI_TASK_MANAGER_','TASK_TRACKER_','CODEX_','CLAUDE_','GIT_'].some(prefix=>key.startsWith(prefix))));
process.chdir(manifest.root);
const results=process.argv.includes('--resume') ? JSON.parse(fs.readFileSync(path.join(out,'results.json'))) : [];
const prior=new Set(results.map(x=>x.file));
for(const [index,file] of selected.entries()){
 if(process.argv.includes('--resume') && prior.has(file)) continue;
 fs.writeFileSync(path.join(out,'progress.json'),JSON.stringify({index,total:selected.length,file,startedAt:new Date().toISOString()}));
 const start=Date.now();
 const r=await spawnTestChild({full:path.join(manifest.root,file),timeout:TEST_FILE_TIMEOUT_MS,maxBuffer:RUN_TESTS_MAX_BUFFER,env:{...baseEnv,AITM_TEST_NO_GH_RETRY:'1',npm_config_cache:path.join(manifest.root,'.scratch/npm-cache'),npm_config_offline:'true'}});
 const log=String(index).padStart(4,'0')+'.log';fs.writeFileSync(path.join(out,log),r.stdout+r.stderr);
 results.push({file,status:r.status,signal:r.signal,durationMs:Date.now()-start,log});fs.writeFileSync(path.join(out,'results.json'),JSON.stringify(results,null,2));
 if(r.status!==0 || (index+1)%25===0) console.log(JSON.stringify({completed:index+1,total:selected.length,file,status:r.status}));
}
const receipt={completed:results.length,total:selected.length,failures:results.filter(x=>x.status!==0).length,completedAt:new Date().toISOString()};
fs.writeFileSync(path.join(out,'progress.json'),JSON.stringify(receipt));console.log(JSON.stringify(receipt));process.exitCode=receipt.failures?1:0;
