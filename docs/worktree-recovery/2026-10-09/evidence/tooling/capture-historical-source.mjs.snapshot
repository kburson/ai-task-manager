import fs from 'node:fs';
import path from 'node:path';
import {execFileSync} from 'node:child_process';
const input=JSON.parse(fs.readFileSync('.scratch/recovery-input.json'));
const plans=[
 {ids:['P04','P05'],issue:1859,sourceHead:'14154c2e264b5cdb7d4f8145baead7fd5b4f715e',branch:'codex/recovery-1859-ci-replay-20261009',base:'codex/1859-delivery-history-d3a92172',title:'Recover retained CI replay bytes and lane correction',purpose:'Three unpublished #1859 CI replay/lane/documentation commits retained by stale detached test registrations. The newer HEAD also contains the older dfed5558 snapshot. Original #1859 is closed; compare with delivered Scope evidence before deciding whether these CI fixes remain applicable.'},
 {ids:['P06'],issue:1725,sourceHead:'46952470a4f89a61bf7f689ea7937397ed8314d2',branch:'codex/recovery-1725-interrupted-review-planning-20261009',base:'trunk',title:'Recover interrupted reverse-review planning checkpoint',purpose:'Original planning checkpoint from the MCP adapter/reverse-review experiment, including two commits not reachable from current origin. Related architecture and evidence were delivered in PRs #1724 and #1726. This checkpoint is historical and does not approve the interrupted XPR setup or architecture implementation.'},
 {ids:['P10'],issue:1953,originalIssue:1728,sourceHead:'309f6fe5ea3206a6159893e76b8c4be01f8433f7',branch:'codex/recovery-1728-authority-observations-20261009',base:'trunk',title:'Recover authority-observation implementation for reconciliation',purpose:'Preserve original #1728/#1663 authority-observation source and inherited experimental characterization commits. Both original stories are closed, but these exact commits are absent from current origin. Reconcile the 102-file historical proposal with the subsequently shipped #1558 evaluator; do not merge duplicate or superseded behavior blindly.'},
 {ids:['P17'],issue:1955,sourceHead:'4f70500b60c78a090aefd9eea052122c04467480',branch:'codex/recovery-1955-hybrid-insights-proposals-20261009',base:'trunk',title:'Recover hybrid-ledger and Insights planning proposals',purpose:'Preserve the three July 28 proposed design/plan documents whose original commit had no issue. #1955 owns assessment against the later GitHub-native authority architecture (#1067/#1087/#1088), including a decision to supersede, retain research, or create current implementation stories. These documents are not current approved architecture.'}
];
const git=(args,o={})=>execFileSync('git',args,{encoding:'utf8',maxBuffer:32*1024*1024,...o});const gh=args=>execFileSync('gh',args,{encoding:'utf8',maxBuffer:8*1024*1024});
const receipts=[];
for(const p of plans){const temp=path.resolve(`.scratch/history-index-${p.ids[0]}`);if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};git(['read-tree',p.sourceHead],{env});const manifest={owner:'kburson',story:p.issue,originalStory:p.originalIssue??p.issue,sourceHead:p.sourceHead,protectedIds:p.ids,purpose:p.purpose,sourcePaths:p.ids.map(id=>input.groups.find(x=>x.id===id)?.path),validation:'Original object preservation only; current tests and review not run.'};const b=git(['hash-object','-w','--stdin'],{input:JSON.stringify(manifest,null,2)+'\n'}).trim();git(['update-index','--add','--cacheinfo',`100644,${b},docs/worktree-recovery/2026-10-09/${p.ids[0]}/source-provenance.json`],{env});const tree=git(['write-tree'],{env}).trim();const commit=git(['commit-tree',tree,'-p',p.sourceHead],{input:`[#${p.issue}] Recover original ${p.ids.join('/')} source provenance\n\n${p.purpose}\n\nRefs #1953\n`}).trim();git(['update-ref',`refs/heads/${p.branch}`,commit,'0000000000000000000000000000000000000000']);git(['push','origin',`${commit}:refs/heads/${p.branch}`]);const remote=git(['ls-remote','origin',`refs/heads/${p.branch}`]).trim().split('\t')[0];if(remote!==commit)throw Error('Remote mismatch');const file=`.scratch/recovery-pr-bodies/history-${p.ids[0]}.md`;fs.writeFileSync(file,`${p.purpose}\n\nOwner: @kburson. Refs #${p.issue}${p.originalIssue?` and #${p.originalIssue}`:''}; recovery coordination #1953.\n\nOriginal HEAD: ${p.sourceHead}. Protected content groups: ${p.ids.join(', ')}. This branch preserves the original commit ancestry, with source-provenance.json explaining the purpose. Original local branches/worktrees were not modified.\n\nReview decision: assess applicability and dependencies before any fix or integration. Functional tests, lint and current peer review have not been rerun. Draft status records preservation and triage only.\n`);const url=gh(['pr','create','--draft','--base',p.base,'--head',p.branch,'--title',`[#${p.issue}] ${p.title}`,'--body-file',file]).trim();receipts.push({...p,commit,url,verifiedOriginSha:remote});fs.writeFileSync('.scratch/published-historical-prs.json',JSON.stringify(receipts,null,2)+'\n');console.log(JSON.stringify(receipts.at(-1)));}
