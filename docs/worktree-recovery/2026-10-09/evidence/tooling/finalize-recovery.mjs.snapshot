import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import {execFileSync} from 'node:child_process';
const git=(args,opts={})=>{if(opts.input!==undefined){const file=path.resolve('.scratch/final-git-input');fs.writeFileSync(file,opts.input);const fd=fs.openSync(file,'r'),{input,...rest}=opts;try{return execFileSync('git',args,{encoding:'utf8',maxBuffer:64*1024*1024,timeout:60000,...rest,stdio:[fd,'pipe','pipe']});}finally{fs.closeSync(fd);}}return execFileSync('git',args,{encoding:'utf8',maxBuffer:64*1024*1024,timeout:60000,...opts});};
const gh=args=>execFileSync('gh',args,{encoding:'utf8',maxBuffer:16*1024*1024,timeout:60000});const prefix='docs/worktree-recovery/2026-10-09';
const parts=JSON.parse(fs.readFileSync('.scratch/published-evidence-parts.json'));const part=parts[0],extra=JSON.parse(fs.readFileSync('.scratch/published-1514-evidence.json'));
const env={...process.env,GIT_INDEX_FILE:path.resolve('.scratch/final-tooling-index')};if(fs.existsSync(env.GIT_INDEX_FILE))fs.unlinkSync(env.GIT_INDEX_FILE);git(['read-tree',part.commit],{env});const tooling=[];
for(const f of ['split-evidence-review.mjs','capture-1514-evidence.mjs','finalize-recovery.mjs']){const b=fs.readFileSync('.scratch/'+f),sha=git(['hash-object','-w','--stdin'],{input:b}).trim(),target=prefix+'/evidence/tooling/'+f+'.snapshot';git(['update-index','--add','--cacheinfo',`100644,${sha},${target}`],{env});part.paths.push(target);tooling.push({path:target,sha256:crypto.createHash('sha256').update(b).digest('hex'),blob:sha,branch:part.branch,PR:part.url});}
const toolTree=git(['write-tree'],{env}).trim(),toolCommit=git(['commit-tree',toolTree,'-p',part.commit],{input:'[#1953] Preserve the final recovery, evidence split and verification tooling\n'}).trim();git(['update-ref','refs/heads/'+part.branch,toolCommit,part.commit]);git(['push','origin',toolCommit+':refs/heads/'+part.branch]);part.commit=toolCommit;part.files+=tooling.length;fs.writeFileSync('.scratch/published-evidence-parts.json',JSON.stringify(parts,null,2)+'\n');
const branch='codex/1953-protected-wip-review-index',head=git(['rev-parse',branch]).trim();const index=JSON.parse(git(['show',head+':'+prefix+'/index.json']));index.evidencePRs=parts.map(({paths,...r})=>r);index.additionalPlanningEvidence={...extra,metadata:extra.metadata};index.toolingLatest=tooling;index.sourcePreservationVerification=JSON.parse(fs.readFileSync('.scratch/final-source-preservation-check.json'));index.queue.push({id:'D10',owner:'kburson',story:1514,recoveryStory:1953,originalStoryAssignees:[],sourcePR:extra.url,recoveryBranch:extra.branch,verifiedPublishedHead:extra.commit,sourceHead:extra.metadata.sourceHead,sourceBranch:extra.metadata.sourceBranch,priorPlanningPR:1515,decision:'Review local planning operator fragments before assigning or implementing open #1514.'});
let readme=git(['show',head+':'+prefix+'/README.md']);readme+='\n## Final coverage check\n\nD10 (#1514) was clean but contained seven ignored planning/AC operator fragments. [PR #1981]('+extra.url+') stores them individually and records their provenance. #1514 is open and unassigned; @kburson owns this recovery review through #1953. The original planning was already merged in PR #1515; no new implementation acceptance is inferred.\n\nThe final source-preservation check found unchanged original HEADs, unchanged staged state (including the original staged rename), and no content drift across all six uncommitted-source/collateral captures. Three final helper scripts are preserved as inert source copies in '+part.url+'.\n\nThere are 10 source/collateral recovery PRs, 15 evidence/planning review PRs, and this four-file index PR. All are drafts. Nothing was merged or deleted during recovery.\n';
const finalEnv={...process.env,GIT_INDEX_FILE:path.resolve('.scratch/final-index-update')};if(fs.existsSync(finalEnv.GIT_INDEX_FILE))fs.unlinkSync(finalEnv.GIT_INDEX_FILE);git(['read-tree',head],{env:finalEnv});for(const[name,bytes]of [[prefix+'/index.json',Buffer.from(JSON.stringify(index,null,2)+'\n')],[prefix+'/README.md',Buffer.from(readme)]]){const sha=git(['hash-object','-w','--stdin'],{input:bytes}).trim();git(['update-index','--add','--cacheinfo',`100644,${sha},${name}`],{env:finalEnv});}const tree=git(['write-tree'],{env:finalEnv}).trim(),commit=git(['commit-tree',tree,'-p',head],{input:'[#1953] Complete the review queue and source preservation verification\n'}).trim();git(['update-ref','refs/heads/'+branch,commit,head]);git(['push','origin',commit+':refs/heads/'+branch]);
const source=JSON.parse(fs.readFileSync('.scratch/published-recovery-prs.json')),history=JSON.parse(fs.readFileSync('.scratch/published-historical-prs.json')),originals=JSON.parse(fs.readFileSync('.scratch/published-delivered-originals.json')),archiveHeads=JSON.parse(fs.readFileSync('.scratch/published-archive-heads.json'));
const refs=git(['ls-remote','--heads','origin']);const all=[...source,...history,...parts,extra,{branch,commit}];for(const r of all){if(!refs.includes(r.commit+'\trefs/heads/'+r.branch+'\n'))throw Error('Remote SHA changed '+r.branch);}for(const r of originals){if(!refs.includes(r.sha+'\trefs/heads/'+r.branch+'\n'))throw Error('Original source missing '+r.id);}const peerRefs=git(['-C','/Users/kpburson/projects/Vibe-Coding/ai-peer-review','ls-remote','--heads','origin']);for(const r of archiveHeads){if(!(r.repository.endsWith('/ai-peer-review')?peerRefs:refs).includes(r.sha+'\trefs/heads/'+r.branch+'\n'))throw Error('Archived original missing '+r.branch);}
const prs=JSON.parse(gh(['pr','list','--state','open','--limit','100','--json','number,isDraft,headRefName,headRefOid,url,changedFiles','--jq','map(select(.number >= 1956 and .number <= 1981))']));if(prs.length!==26||prs.some(p=>!p.isDraft))throw Error('Draft PR coverage mismatch');for(const r of all){const p=prs.find(p=>p.headRefName===r.branch);if(!p||p.headRefOid!==r.commit)throw Error('PR head mismatch '+r.branch);}const idx=prs.find(p=>p.number===1966);if(idx.changedFiles!==4)throw Error('Index is not concise');
const result={story:1953,indexPR:'https://github.com/kburson/ai-task-manager/pull/1966',indexBranch:branch,indexCommit:commit,sourcePRs:source.length+history.length,evidencePlanningPRs:parts.length+1,totalDraftPRs:prs.length,protectedGroups:index.queue.filter(r=>r.id!=='D01'&&r.id!=='D10').length,archivedOriginalHeads:archiveHeads.length,archiveSnapshots:index.archiveRecords.length,sourcePreservationPassed:index.sourcePreservationVerification.every(r=>r.currentHeadUnchanged&&r.stagedStateUnchanged&&!r.contentDrift.length),remoteAndPRHeadsVerified:true,prs};fs.writeFileSync('.scratch/final-recovery-verification.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({...result,prs:undefined}));
