import fs from 'node:fs';
import {execFileSync} from 'node:child_process';
const rows=JSON.parse(fs.readFileSync('.scratch/recovery-captures.json'));
const run=(name,args)=>execFileSync(name,args,{encoding:'utf8',maxBuffer:8*1024*1024});
const output=[];fs.mkdirSync('.scratch/recovery-pr-bodies',{recursive:true});
for(const r of rows){
 const extra=r.id==='P01'?'Review this delta first; its base is the source branch of draft PR #1871. Merge or selectively integrate into that branch only after #1861 validation.':r.id==='P02'?'Stacked on the #1855 branch in draft PR #1907. Coordinate with #1919 / PR #1928; do not infer that earlier green logs cover this captured HEAD.':r.id==='D09'?'Temporary operational configuration only. Retain hooks disabled for the cleanup session, but do not merge this as a permanent default. The restore copies will be linked by the recovery index.':'Compare against current trunk before selecting any hunks to integrate. Historical story status is not evidence that this recovered delta was delivered.';
 const body=`${r.purpose}\n\nOwner: @kburson. Refs #${r.issue}${r.originalIssue?` and #${r.originalIssue}`:''}; recovery coordination: #1953.\n\nCaptured ${r.capturedPaths} changed/untracked paths from ${r.id}, original HEAD ${r.sourceHead}. The full purpose, original index hash, staged rename details and path/blob hashes are in docs/worktree-recovery/2026-10-09/${r.id}/capture.json. Original working files, branch and index remain unchanged.\n\n${extra}\n\nValidation: exact captured blob read-back and original-index hash preservation passed. Functional tests, lint and current peer review have not been run for this snapshot; this is a draft recovery PR, not a claim of completion or readiness to merge.\n`;
 const file=`.scratch/recovery-pr-bodies/${r.id}.md`;fs.writeFileSync(file,body);
 run('git',['push','origin',`${r.commit}:refs/heads/${r.branch}`]);
 const remote=run('git',['ls-remote','origin',`refs/heads/${r.branch}`]).trim().split('\t')[0];if(remote!==r.commit)throw Error('Remote SHA mismatch '+r.id);
 const title=`[#${r.issue}] Recover ${r.originalIssue?'#'+r.originalIssue+' ':''}${r.id==='P01'?'runtime kernel WIP':r.id==='P02'?'criteria-revision repair WIP':r.id==='P08'?'assignment-invariant WIP':r.id==='P09'?'manual review invitation':r.id==='P07'?'local test observations':'temporary cleanup hook settings'}`;
 const url=run('gh',['pr','create','--draft','--base',r.base,'--head',r.branch,'--title',title,'--body-file',file]).trim();
 output.push({...r,url,verifiedOriginSha:remote});fs.writeFileSync('.scratch/published-recovery-prs.json',JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify(output.at(-1)));
}
