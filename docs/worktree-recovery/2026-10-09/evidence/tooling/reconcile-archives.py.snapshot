import json,subprocess,tarfile,pathlib,hashlib,re,os
root=pathlib.Path('/Users/kpburson/projects/Vibe-Coding/ai-task-manager/.db/aitm/worktree-archives/2026-09-30')
out=pathlib.Path('.scratch/recovered-archive-evidence');out.mkdir(exist_ok=True)
def git(cwd,*args):return subprocess.check_output(['git',*args],cwd=cwd)
manifests=json.loads((root/'manifest.json').read_text())+json.loads((root/'delivered-cull/manifest.json').read_text())
extra=[('/Users/kpburson/projects/Vibe-Coding/ai-task-manager/.scratch/session-archives/01a10460-c0da-7c92-96cf-c90d6bd526ea/1872-local-evidence.tar.gz','session-1872-local-evidence'),('/Users/kpburson/projects/Vibe-Coding/ai-task-manager/.scratch/1857-delivered-control.tar','main-1857-delivered-control'),('/Users/kpburson/.codex/worktrees/8dae/ai-task-manager/.scratch/1857-delivered-control.tar','1861-1857-delivered-control')]
for file,slug in extra:
 if pathlib.Path(file).exists():manifests.append({'path':file,'main':'/Users/kpburson/projects/Vibe-Coding/ai-task-manager','archive':file,'slug':slug,'proof':'Needs current content reconciliation; no historical acceptance inferred'})
sets={};records=[];exports=[];pending=[]
for item in manifests:
 main=item['main'];repo='kburson/'+pathlib.Path(main).name
 if main not in sets:
  subprocess.run(['git','fetch','origin'],cwd=main,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  tips={line.split()[0] for line in git(main,'ls-remote','--heads','origin').decode().splitlines()}
  sets[main]={line.split()[0] for line in git(main,'rev-list','--objects',*tips).decode().splitlines()}
 archive=pathlib.Path(item['archive']);slug=item.get('slug',archive.name.removesuffix('.tar.gz'));rec={k:v for k,v in item.items() if k not in ('gitPointer',)}
 rec.update(repository=repo,owner='kburson',recoveryStory='kburson/ai-task-manager#1953',exports=[],alreadyOnOrigin=0,generated=0,secretPaths=[])
 with tarfile.open(archive,'r:*') as tf:
  for member in tf:
   if not member.isfile():continue
   f=pathlib.PurePosixPath(member.name)
   if f.is_absolute() or '..' in f.parts:raise RuntimeError('Unsafe archive entry '+member.name)
   name=str(f)
   if '/node_modules/' in '/'+name+'/' or '/.git/' in '/'+name+'/' or name in ('.git','./.git') or re.search(r'(^|/)(?:\.tmp|\.cache|coverage|\.task-test-[^/]+)(/|$)',name) or re.search(r'(^|/)\.scratch/(test|[^/]*compile-cache|[^/]*npm-cache|peer-review/runtimes|[0-9]+-runtime(?:-[^/]+)?)(/|$)',name) or re.search(r'(^|/)\.ai-task-manager/runtime(/|$)',name) or name.endswith(('.tgz','.tar','.tar.gz','.pack','.idx','.rev','.bundle')):
    rec['generated']+=1;continue
   data=tf.extractfile(member).read();oid=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()
   if oid in sets[main]:rec['alreadyOnOrigin']+=1;continue
   text=data.decode('utf-8',errors='replace').replace('github_pat_abcdefghijklmnopqrstuvwxyz','TEST_TOKEN').replace('ghp_abcdefghijklmnop','TEST_TOKEN')
   if re.search(r'-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|\b(ghp_|github_pat_|sk-proj-)[A-Za-z0-9_-]{20,}',text):rec['secretPaths'].append(name);continue
   dest=out/slug/f;dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(data)
   export={'archive':str(archive),'path':name,'repository':repo,'owner':'kburson','originalHead':item.get('freshHead',item.get('head')),'source':str(dest.resolve()),'gitBlob':oid,'sha256':hashlib.sha256(data).hexdigest(),'size':len(data),'group':slug}
   rec['exports'].append({'path':name,'sha256':export['sha256'],'size':len(data)});exports.append(export)
 records.append(rec);print(json.dumps({'archive':slug,'onOrigin':rec['alreadyOnOrigin'],'newEvidence':len(rec['exports']),'secrets':rec['secretPaths']}),flush=True)
pathlib.Path('.scratch/archive-reconciliation.json').write_text(json.dumps({'records':records,'exports':exports},indent=2)+'\n')
