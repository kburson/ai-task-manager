import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import {execFileSync} from 'node:child_process';
const git=(args,opts={})=>{if(opts.input!==undefined){const file=path.resolve('.scratch/1514-git-input');fs.writeFileSync(file,opts.input);const fd=fs.openSync(file,'r'),{input,...rest}=opts;try{return execFileSync('git',args,{encoding:'utf8',timeout:60000,...rest,stdio:[fd,'pipe','pipe']});}finally{fs.closeSync(fd);}}return execFileSync('git',args,{encoding:'utf8',timeout:60000,...opts});};
const source='/Users/kpburson/projects/Vibe-Coding/ai-task-manager/.worktrees/1514-externalize-forecast-comparables',prefix='docs/worktree-recovery/2026-10-09/evidence/D10',base=git(['rev-parse','origin/trunk']).trim(),branch='codex/1953-1514-planning-evidence';const files=execFileSync('git',['ls-files','--others','--ignored','--exclude-standard','-z','.scratch/gh'],{cwd:source}).toString().split('\0').filter(Boolean);const temp=path.resolve('.scratch/1514-evidence-index');if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};git(['read-tree',base],{env});const entries=[],proof=[];for(const f of files){const bytes=fs.readFileSync(path.join(source,f));if(/\b(ghp_|github_pat_|sk-proj-)[A-Za-z0-9_-]{20,}/.test(bytes.toString()))throw Error('Potential credential');const sha=git(['hash-object','-w','--stdin'],{input:bytes}).trim(),target=prefix+'/'+f;entries.push(`100644 ${sha}\t${target}\0`);proof.push({original:f,storedPath:target,blob:sha,sha256:crypto.createHash('sha256').update(bytes).digest('hex')});}const metadata={owner:'kburson',recoveryStory:1953,originalStory:1514,originalStoryAssignees:[],sourceHead:'477a0bf30756dee0e93008e76c7e9a85245b261c',sourceBranch:'codex/feature-1514-externalize-forecast-comparables',priorPlanningPR:1515,purpose:'Preserve seven local planning/acceptance-criteria operator fragments for the open forecast-comparables story. These records are not proof that an operation ran or that implementation is approved.',files:proof};const b=git(['hash-object','-w','--stdin'],{input:JSON.stringify(metadata,null,2)+'\n'}).trim();entries.push(`100644 ${b}\t${prefix}/provenance.json\0`);git(['update-index','-z','--index-info'],{env,input:entries.join('')});const tree=git(['write-tree'],{env}).trim(),commit=git(['commit-tree',tree,'-p',base],{input:'[#1953] Recover #1514 planning and AC operator collateral\n'}).trim();git(['update-ref','refs/heads/'+branch,commit,'0000000000000000000000000000000000000000']);git(['push','origin',commit+':refs/heads/'+branch]);const file='.scratch/recovery-pr-bodies/1514.md';fs.writeFileSync(file,'The final sweep found seven ignored planning/AC operator fragments in the clean #1514 worktree. Preserve them for review alongside the already merged planning PR #1515. Recovery owner: @kburson under #1953; original story #1514 is open and currently unassigned.\n\nRefs #1953 and #1514. These local JSON operations and draft PR text are historical collateral, not a new implementation, evidence of executed mutations, or Plan approval. provenance.json maps original paths, source HEAD, stored blobs and content hashes. Choose whether the fragments remain useful before picking up #1514. No functional tests or implementation review have been claimed.\n');const url=execFileSync('gh',['pr','create','--draft','--base','trunk','--head',branch,'--title','[#1953] Recover #1514 forecast-comparables planning collateral','--body-file',file],{encoding:'utf8'}).trim();fs.writeFileSync('.scratch/published-1514-evidence.json',JSON.stringify({branch,commit,url,metadata},null,2)+'\n');console.log(JSON.stringify({branch,commit,url,files:files.length}));
