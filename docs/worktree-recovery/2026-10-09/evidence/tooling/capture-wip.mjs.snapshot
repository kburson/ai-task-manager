import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import {execFileSync} from 'node:child_process';
const input=JSON.parse(fs.readFileSync('.scratch/recovery-input.json'));
const plans=[
 {id:'P01',issue:1861,branch:'codex/recovery-1861-wip-20261009',base:'codex/1857-continuation',purpose:'Preserve the uncommitted runtime kernel and writer adoption work for #1861; review this delta before updating PR #1871.'},
 {id:'P02',issue:1918,branch:'codex/recovery-1918-wip-20261009',base:'feature/epic/1847/child/1855',purpose:'Preserve the 35 unpublished #1918 repair commits and four current original-entry admission files. Depends on #1855 / PR #1907; PR #1928 remains the separate #1919 repair.'},
 {id:'P08',issue:1953,originalIssue:1207,branch:'codex/recovery-1207-assignment-wip-20261009',base:'trunk',purpose:'Recover the assignment invariant implementation and 15 uncommitted project-tether repairs associated with closed story #1207. Requires reconciliation against current trunk before any integration.'},
 {id:'P09',issue:1953,originalIssue:1558,branch:'codex/recovery-1558-review-invitation-20261009',base:'trunk',purpose:'Recover the uncommitted manual Opus reviewer invitation for the already-delivered #1558 Ask-the-Script design. Historical collateral, not an implementation approval.'},
 {id:'P07',issue:1953,originalIssue:1220,branch:'codex/recovery-1220-local-test-observations-20261009',base:'trunk',purpose:'Recover the local pool benchmark and test timing observations left in the cloud-test/articles worktree. Original branch naming references #1220 and #1485; the files are generated observations, not a verified production baseline.'},
 {id:'D09',issue:1953,branch:'codex/recovery-1953-cleanup-session-20261009',base:'trunk',purpose:'Preserve the user-requested temporary hook-disable settings from this cleanup chat. This PR is an operational record; do not merge disabled hooks as a permanent policy change.'}
];
const run=(cwd,args,opts={})=>execFileSync('git',args,{cwd,encoding:'utf8',maxBuffer:32*1024*1024,...opts});
const secret=[/-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/,/\b(?:ghp_|github_pat_|sk-proj-)[A-Za-z0-9_-]{20,}/,/\bAKIA[A-Z0-9]{16}\b/];
const receipts=[];
for(const plan of plans){
 const group=input.groups.find(x=>x.id===plan.id);const cwd=group.path;
 const head=run(cwd,['rev-parse','HEAD']).trim();if(head!==group.head)throw Error('Source HEAD drift '+plan.id);
 const indexPath=run(cwd,['rev-parse','--git-path','index']).trim();const physical=path.resolve(cwd,indexPath);const originalIndex=fs.readFileSync(physical);const before=crypto.createHash('sha256').update(originalIndex).digest('hex');
 const temp=path.resolve(input.cwd,`.scratch/capture-index-${plan.id}`);if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};
 run(cwd,['read-tree',head],{env});
 const changed=run(cwd,['diff','--name-only','HEAD','-z']).split('\0').filter(Boolean);
 const untracked=run(cwd,['ls-files','--others','--exclude-standard','-z']).split('\0').filter(Boolean);
 const excluded=untracked.filter(f=>f.startsWith('.ai-task-manager/runtime/'));
 const files=[...new Set([...changed,...untracked.filter(f=>!excluded.includes(f))])];const captured=[];
 for(const f of files){const full=path.join(cwd,f);if(!fs.existsSync(full)){run(cwd,['update-index','--force-remove','--',f],{env});captured.push({path:f,deleted:true});continue;}
  const stat=fs.lstatSync(full);if(!stat.isFile()&&!stat.isSymbolicLink())throw Error('Unsupported source '+full);
  const bytes=stat.isSymbolicLink()?Buffer.from(fs.readlinkSync(full)):fs.readFileSync(full);const scan=bytes.toString().replaceAll('github_pat_abcdefghijklmnopqrstuvwxyz','TEST_TOKEN').replaceAll('ghp_abcdefghijklmnop','TEST_TOKEN');if(secret.some(re=>re.test(scan)))throw Error('Potential credential in '+f);
  const sha=run(cwd,['hash-object','-w','--stdin'],{input:bytes}).trim(),mode=stat.isSymbolicLink()?'120000':stat.mode&0o111?'100755':'100644';
  run(cwd,['update-index','--add','--cacheinfo',`${mode},${sha},${f}`],{env});captured.push({path:f,blob:sha,sha256:crypto.createHash('sha256').update(bytes).digest('hex'),bytes:bytes.length});
 }
 const manifest={story:plan.issue,originalStory:plan.originalIssue??plan.issue,owner:'kburson',sourcePath:cwd,sourceHead:head,originalIndexSha256:before,sourceIndexEntries:run(cwd,['diff','--cached','--name-status']),purpose:plan.purpose,captured,excludedRuntimeFixtures:excluded,validation:'Content preservation only. No current functional test, lint, peer review or merge readiness claim.'};
 const doc=`docs/worktree-recovery/2026-10-09/${plan.id}/capture.json`;const bytes=Buffer.from(JSON.stringify(manifest,null,2)+'\n');const b=run(cwd,['hash-object','-w','--stdin'],{input:bytes}).trim();run(cwd,['update-index','--add','--cacheinfo',`100644,${b},${doc}`],{env});
 const tree=run(cwd,['write-tree'],{env}).trim();const commit=run(cwd,['commit-tree',tree,'-p',head],{input:`[#${plan.issue}] Recover ${plan.id} WIP for draft review\n\n${plan.purpose}\n\nRefs #1953\n`}).trim();
 run(cwd,['update-ref',`refs/heads/${plan.branch}`,commit,'0000000000000000000000000000000000000000']);
 if(crypto.createHash('sha256').update(fs.readFileSync(physical)).digest('hex')!==before)throw Error('Original index changed '+plan.id);
 for(const f of captured.filter(f=>!f.deleted)){if(run(cwd,['rev-parse',`${commit}:${f.path}`]).trim()!==f.blob)throw Error('Capture mismatch '+f.path);}
 receipts.push({...plan,source:cwd,sourceHead:head,commit,capturedPaths:captured.length,originalIndexPreserved:true});
 fs.writeFileSync('.scratch/recovery-captures.json',JSON.stringify(receipts,null,2)+'\n');console.log(JSON.stringify(receipts.at(-1)));
}
