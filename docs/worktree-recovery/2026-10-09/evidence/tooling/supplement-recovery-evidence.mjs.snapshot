import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import zlib from 'node:zlib';import {execFileSync} from 'node:child_process';
const git=(args,opts={})=>{if(args[0]==='hash-object'&&opts.input!==undefined){const file=path.resolve('.scratch/supplement-blob-input');fs.writeFileSync(file,opts.input);return execFileSync('git',['hash-object','-w','--no-filters',file],{encoding:'utf8',timeout:30000});}return execFileSync('git',args,{encoding:'utf8',maxBuffer:128*1024*1024,timeout:30000,...opts});};
const input=JSON.parse(fs.readFileSync('.scratch/recovery-input.json'));const index=JSON.parse(fs.readFileSync('.scratch/published-recovery-index.json'));const prefix='docs/worktree-recovery/2026-10-09';
const original=JSON.parse(zlib.gunzipSync(execFileSync('git',['show',index.commit+':'+prefix+'/file-dispositions.json.gz'],{maxBuffer:64*1024*1024})));
const known=new Map(original.filter(r=>r.storedPath).map(r=>[r.gitBlob,r.storedPath]));const reachable=new Set(git(['rev-list','--objects','--remotes=origin']).split('\n').map(l=>l.split(' ')[0]));const additions=[],records=[];
const hash=b=>crypto.createHash('sha1').update(Buffer.from(`blob ${b.length}\0`)).update(b).digest('hex');
function add(target,bytes){const b=git(['hash-object','-w','--stdin'],{input:bytes}).trim();additions.push({target,blob:b});return b;}
function capture(id,name,bytes){const b=hash(bytes),r={group:id,original:name,gitBlob:b,sha256:crypto.createHash('sha256').update(bytes).digest('hex'),bytes:bytes.length};if(known.has(b)){r.disposition='same-published-evidence-blob';r.storedPath=known.get(b);}else if(reachable.has(b)){r.disposition='already-reachable-on-origin';}else{let body=bytes;let target=prefix+'/evidence/'+id+'/'+name.replace(/^\.?\//,'');if(/\.(?:mjs|js|py|sh)$/.test(target))target+='.snapshot';if(bytes.length>500000){body=zlib.gzipSync(bytes);target+='.gz';r.encoding='gzip';if(!zlib.gunzipSync(body).equals(bytes))throw Error('Compression changed content');}r.storedPath=target;r.storedBlob=add(target,body);r.disposition='published-evidence';known.set(b,target);}records.push(r);}
for(const g of [...input.groups,{id:'D01',path:input.main}]){if(!fs.existsSync(path.join(g.path,'.git')))continue;const names=execFileSync('git',['ls-files','--others','--ignored','--exclude-standard','-z','.superpowers','tmp/pdfs','.claude/settings.local.json','.vscode'],{cwd:g.path,maxBuffer:64*1024*1024}).toString().split('\0').filter(Boolean);for(const name of names){const full=path.join(g.path,name),st=fs.lstatSync(full);if(!st.isFile())continue;const bytes=fs.readFileSync(full);const scan=bytes.toString().replaceAll('github_pat_abcdefghijklmnopqrstuvwxyz','TEST_TOKEN').replaceAll('ghp_abcdefghijklmnop','TEST_TOKEN');if(/-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|\b(ghp_|github_pat_|sk-proj-)[A-Za-z0-9_-]{20,}/.test(scan)){records.push({group:g.id,original:name,disposition:'credential-review-required',sha256:crypto.createHash('sha256').update(bytes).digest('hex')});continue;}capture(g.id,name,bytes);}}
for(const name of ['inspect-recovery.mjs','capture-wip.mjs','publish-recovery-captures.mjs','capture-historical-source.mjs','reconcile-archives.py','publish-archive-heads.mjs','publish-recovery-evidence.mjs','supplement-recovery-evidence.mjs']){capture('tooling',name,fs.readFileSync('.scratch/'+name));}
add(prefix+'/supplement-dispositions.json.gz',zlib.gzipSync(Buffer.from(JSON.stringify(records,null,2)+'\n')));
const temp=path.resolve('.scratch/supplement-index');if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};git(['read-tree',index.commit],{env});git(['update-index','-z','--index-info'],{env,input:additions.map(r=>`100644 ${r.blob}\t${r.target}\0`).join('')});const tree=git(['write-tree'],{env}).trim();const commit=git(['commit-tree',tree,'-p',index.commit],{input:'[#1953] Preserve additional task reports, publication QA and recovery tooling\n'}).trim();git(['update-ref','refs/heads/'+index.branch,commit,index.commit]);git(['push','origin',commit+':refs/heads/'+index.branch]);const receipt={commit,parent:index.commit,addedFiles:additions.length,dispositions:records.reduce((o,r)=>(o[r.disposition]=(o[r.disposition]??0)+1,o),{})};fs.writeFileSync('.scratch/recovery-supplement.json',JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));
