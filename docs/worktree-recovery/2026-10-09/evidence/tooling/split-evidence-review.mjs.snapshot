import fs from 'node:fs';import path from 'node:path';import zlib from 'node:zlib';import {execFileSync} from 'node:child_process';
const git=(args,opts={})=>{if(opts.input!==undefined){const file=path.resolve('.scratch/split-git-input');fs.writeFileSync(file,opts.input);const fd=fs.openSync(file,'r');const{input,...rest}=opts;try{return execFileSync('git',args,{encoding:'utf8',maxBuffer:128*1024*1024,timeout:60000,...rest,stdio:[fd,'pipe','pipe']});}finally{fs.closeSync(fd);}}return execFileSync('git',args,{encoding:'utf8',maxBuffer:128*1024*1024,timeout:60000,...opts});};const gh=args=>execFileSync('gh',args,{encoding:'utf8',maxBuffer:8*1024*1024,timeout:60000});
const base=git(['rev-parse','origin/trunk']).trim(),branch='codex/1953-protected-wip-review-index',head=git(['rev-parse',branch]).trim(),prefix='docs/worktree-recovery/2026-10-09';
const rows=git(['ls-tree','-r','--full-tree',head,prefix+'/evidence']).trim().split('\n').filter(Boolean).map(l=>{const [s,target]=l.split('\t');const[mode,type,blob]=s.split(' ');return{mode,type,blob,target};});
const grouping=new Map();function family(p){const id=p.slice((prefix+'/evidence/').length).split('/')[0];if(id==='P01')return['1861-runtime-evidence',1861,'Runtime kernel recovery evidence'];if(id==='P02')return['1918-criteria-evidence',1918,'Criteria-revision repair evidence'];if(['D08','P06'].includes(id))return['1725-architecture-evidence',1725,'MCP architecture and interrupted review evidence'];if(id==='P07')return['publication-qa-evidence',1953,'Book layout QA and retained task reports'];if(['P10','P11','P12','P13','P14','P15','P16','P17','P18','P08','P09'].includes(id))return['delivered-story-evidence',1953,'Original story delivery and reconciliation evidence'];return['local-and-archive-evidence',1953,'Cleanup, archive and recovery provenance evidence'];}
for(const r of rows){const[k,issue,title]=family(r.target);if(!grouping.has(k))grouping.set(k,{issue,title,rows:[]});grouping.get(k).rows.push(r);}
git(['push','origin',head+':refs/heads/codex/1953-complete-evidence-provenance']);
const parts=[];fs.mkdirSync('.scratch/evidence-parts',{recursive:true});
for(const[key,g]of grouping){for(let i=0;i<g.rows.length;i+=900){const list=g.rows.slice(i,i+900),part=Math.floor(i/900)+1,total=Math.ceil(g.rows.length/900),partBranch=`codex/1953-${key}-${part}`,temp=path.resolve(`.scratch/evidence-parts/${key}-${part}.index`);if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};git(['read-tree',base],{env});git(['update-index','-z','--index-info'],{env,input:list.map(r=>`${r.mode} ${r.blob}\t${r.target}\0`).join('')});const tree=git(['write-tree'],{env}).trim(),commit=git(['commit-tree',tree,'-p',base],{input:`[#${g.issue}] Publish ${g.title.toLowerCase()} part ${part}/${total}\n\nRefs #1953\n`}).trim();git(['update-ref','refs/heads/'+partBranch,commit,'0000000000000000000000000000000000000000']);git(['push','origin',commit+':refs/heads/'+partBranch]);const body=`.scratch/evidence-parts/${key}-${part}.md`;fs.writeFileSync(body,`${g.title}, part ${part} of ${total}. Owner: @kburson. Refs #${g.issue}; recovery coordination #1953.\n\nThis PR exposes ${list.length} original local evidence files for review. It changes no executable product source. Files are grouped by original worktree/story; the central review index in PR #1966 maps source HEADs, source PRs, original delivery PRs, content hashes and review dependencies.\n\nLarge logs/metadata are individually gzip-compressed with original content hashes. Code snippets ending .snapshot are inert historical copies. Test logs and review reports retain their original context and are not fresh validation or approval of the source recovery branches. Decide usefulness and retention separately from choosing code fixes to merge.\n`);const url=gh(['pr','create','--draft','--base','trunk','--head',partBranch,'--title',`[#${g.issue}] ${g.title} (${part}/${total})`,'--body-file',body]).trim();parts.push({family:key,issue:g.issue,owner:'kburson',branch:partBranch,commit,url,part,total,files:list.length,paths:list.map(r=>r.target)});fs.writeFileSync('.scratch/published-evidence-parts.json',JSON.stringify(parts,null,2)+'\n');console.log(JSON.stringify({family:key,part,total,files:list.length,url,commit}));}}
const remoteRefs=git(['ls-remote','--heads','origin']);for(const p of parts){if(!remoteRefs.includes(p.commit+'\trefs/heads/'+p.branch+'\n'))throw Error('Part remote mismatch');}
const placement=new Map(parts.flatMap(p=>p.paths.map(name=>[name,{branch:p.branch,url:p.url}])));
const old=JSON.parse(git(['show',head+':'+prefix+'/index.json']));old.evidencePRs=parts.map(({paths,...p})=>p);old.completeEvidenceProvenance={branch:'codex/1953-complete-evidence-provenance',head};
const manifest=JSON.parse(zlib.gunzipSync(execFileSync('git',['show',head+':'+prefix+'/file-dispositions.json.gz'],{maxBuffer:64*1024*1024})));const supplement=JSON.parse(zlib.gunzipSync(execFileSync('git',['show',head+':'+prefix+'/supplement-dispositions.json.gz'],{maxBuffer:64*1024*1024})));for(const r of [...manifest,...supplement]){if(r.storedPath&&placement.has(r.storedPath))Object.assign(r,{storedBranch:placement.get(r.storedPath).branch,evidencePR:placement.get(r.storedPath).url});}
old.supplementStats=supplement.reduce((o,r)=>(o[r.disposition]=(o[r.disposition]??0)+1,o),{});
let readme=git(['show',head+':'+prefix+'/README.md']);readme=readme.replace('Each unique meaningful local file is stored under evidence/', 'Each unique meaningful local file is stored under evidence/ in the linked evidence PR branches');readme+='\n## Evidence PRs\n\nReview these as retention/provenance decisions after the owning source PR. They do not add executable product changes. The index PR deliberately remains small; payloads are grouped into bounded review diffs.\n\n| Family | Owner story | Part | Files | PR |\n|---|---|---:|---:|---|\n';for(const p of parts)readme+=`| ${p.family} | #${p.issue} | ${p.part}/${p.total} | ${p.files} | [PR](${p.url}) |\n`;readme+='\nAdditional Superpowers task reports, publication QA images/PDFs and inert recovery-tool source copies are included in these evidence PRs. supplement-dispositions.json.gz records the final ignored-file sweep.\n';
const temp=path.resolve('.scratch/final-review-index');if(fs.existsSync(temp))fs.unlinkSync(temp);const env={...process.env,GIT_INDEX_FILE:temp};git(['read-tree',base],{env});const docs=[[prefix+'/README.md',Buffer.from(readme)],[prefix+'/index.json',Buffer.from(JSON.stringify(old,null,2)+'\n')],[prefix+'/file-dispositions.json.gz',zlib.gzipSync(Buffer.from(JSON.stringify(manifest,null,2)+'\n'))],[prefix+'/supplement-dispositions.json.gz',zlib.gzipSync(Buffer.from(JSON.stringify(supplement,null,2)+'\n'))]];const changes=[];for(const[name,b]of docs){const sha=git(['hash-object','-w','--stdin'],{input:b}).trim();changes.push(`100644 ${sha}\t${name}\0`);}git(['update-index','-z','--index-info'],{env,input:changes.join('')});const tree=git(['write-tree'],{env}).trim(),commit=git(['commit-tree',tree,'-p',head],{input:'[#1953] Keep the review index concise and link story-owned evidence PRs\n'}).trim();git(['update-ref','refs/heads/'+branch,commit,head]);git(['push','origin',commit+':refs/heads/'+branch]);const body='.scratch/recovery-pr-bodies/final-index.md';fs.writeFileSync(body,`Protected WIP is connected to owning stories, named origin branches and draft PRs for review. Owner: @kburson. Refs #1953.\n\nStart at docs/worktree-recovery/2026-10-09/README.md. It lists all 19 protected worktree groups plus the primary checkout's recovered evidence, the 10 source/collateral recovery PRs (#1956–#1965), ${parts.length} bounded evidence PRs, prior delivery PRs and a suggested review/dependency order.\n\nThis PR contains only four review-index/manifest files. Payloads live in the linked story-owned evidence PRs; original source commits are verified on named origin branches. ${old.archiveRecords.length} prior archives/control snapshots were inspected and unique meaningful files unpacked for direct review. Reproducible caches/fixtures and exact bytes already on origin are explicitly classified.\n\nContent hashes, original-index preservation and origin commit identity were checked. Functional tests, current lint, independent implementation review and merge readiness have not been established for the source snapshots. Nothing was merged or deleted by this recovery operation.\n`);gh(['pr','edit','1966','--body-file',body]);fs.writeFileSync('.scratch/final-recovery-index.json',JSON.stringify({branch,commit,url:'https://github.com/kburson/ai-task-manager/pull/1966',evidenceParts:parts.length,payloadFiles:rows.length,summary:old},null,2)+'\n');console.log(JSON.stringify({indexPR:1966,commit,evidenceParts:parts.length,payloadFiles:rows.length}));
