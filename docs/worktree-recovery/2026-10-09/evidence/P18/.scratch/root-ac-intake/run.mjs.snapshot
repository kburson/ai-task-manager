import fs from 'node:fs';import {spawnSync} from 'node:child_process';const args=process.argv.slice(2).filter(a=>a!=='--allow-foreign-worktree');const start=new Date().toISOString();const r=spawnSync(args[0],args.slice(1),{cwd:process.cwd(),encoding:'utf8',timeout:800000});const id=Date.now().toString();const receipt={command:args,cwd:process.cwd(),start,end:new Date().toISOString(),exitCode:r.status,error:r.error?.message,stdout:r.stdout,stderr:r.stderr};fs.writeFileSync('.scratch/root-ac-intake/run-'+id+'.json',JSON.stringify(receipt,null,2)+'\n');process.stdout.write(r.stdout||'');process.stderr.write(r.stderr||'');console.log('RECEIPT .scratch/root-ac-intake/run-'+id+'.json');process.exit(r.status??1);