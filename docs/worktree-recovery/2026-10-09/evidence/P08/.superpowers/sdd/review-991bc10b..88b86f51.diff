+      return {
+        kind: restoreExit === 0 ? 'restored' : 'restored-move-incomplete',
+        restoreExit,
+        ...snapshot,
+      };
+    }
+    return { kind: 'failed', restoreExit, ...snapshot };
+  } catch (error) {
+    return {
+      kind: 'indeterminate',
+      restoreExit,
+      state: null,
+      assignees: null,
+      error: error?.message || String(error),
