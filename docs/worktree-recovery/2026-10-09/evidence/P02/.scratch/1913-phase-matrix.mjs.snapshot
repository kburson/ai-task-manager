import test from 'node:test';
import assert from 'node:assert/strict';
import { budget, discoverOriginalCases, qualifyOriginalCases } from '../scripts/tests/helpers/criteria-revision-transition-profiles.mjs';
for (const mode of ['phase-11-prefix', 'phase-12-prefix']) {
  const cases = discoverOriginalCases().filter(x => x.mode === mode);
  assert.equal(cases.length,8);
  assert.deepEqual(cases.map(x=>x.fault.when+':'+x.fault.suffix).sort(),
    ['failBefore','failAfter'].flatMap(when=>['intent-write','intent-readback','effect-write','effect-readback'].map(suffix=>when+':'+suffix)).sort());
  test('all original '+mode+' faults', {timeout:budget,concurrency:true}, t=>qualifyOriginalCases(cases,t));
}
