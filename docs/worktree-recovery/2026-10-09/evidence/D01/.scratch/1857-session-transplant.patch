+      acknowledgeRuntimeLegacyPlan({
+        observedPlan: observed,
+        approvedPlanDigest: observed.digest,
+        ...roots,
+        adapters,
+      }),
+      { code: 'RUNTIME_MIGRATION_PLAN_CHANGED' }
+    );
