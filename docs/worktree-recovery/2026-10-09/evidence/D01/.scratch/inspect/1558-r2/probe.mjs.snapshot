import fs from 'node:fs';
import assert from 'node:assert/strict';
import {
  extractPlanTasks,
  selectDecompositionPlanSection,
  linkedPlanReference,
} from '../../../scripts/task-tracker/lib/decomposition-policy.mjs';
import { reconcileWbsCoverage } from '../../../scripts/task-tracker/lib/decomposition-wbs-coverage.mjs';

const planPath =
  'docs/superpowers/plans/2026-09-16-1558-ask-the-script-guidance-hydration-wbs-r2.md';
const planText = fs.readFileSync('.scratch/inspect/1558-r2/r2.md', 'utf8');
const commit = 'f4970b17a8296d789f220fb020aa59ff101cc54a';
const tasks = extractPlanTasks(planText);
const readPlanAtCommit = () => planText;

function body(task, sectionOverride) {
  return [
    '## Plan Metadata',
    '',
    `- **Source-plan**: ${planPath}`,
    `- **Source-plan-commit**: ${commit}`,
    `- **Source-plan-section**: ${sectionOverride || task.heading}`,
    '- **Baseline-plan**: docs/superpowers/plans/2026-09-16-1558-ask-the-script-guidance-replacement.md',
    '- **Baseline-plan-commit**: a168753999617066d98bbc1227c4b5d97fa531c5',
    '',
  ].join('\n');
}

const children = tasks.map((t, i) => ({ number: 2000 + i, title: t.title, body: body(t) }));

const ok = await reconcileWbsCoverage({
  tasks,
  acceptedPlanPath: planPath,
  acceptedPlanText: planText,
  children,
  readPlanAtCommit,
});
console.log(
  'POSITIVE ok=%s expected=%d covered=%d blockers=%j',
  ok.ok,
  ok.expectedCount,
  ok.coveredCount,
  ok.blockers
);

for (const c of children) {
  const key = linkedPlanReference(c.body)?.key;
  const sel = selectDecompositionPlanSection({
    body: c.body,
    planText,
    activePlanKey: 'Source-plan',
  });
  assert.equal(key, 'Source-plan');
  assert.ok(sel.ok && sel.applied, `section selection failed for #${c.number}: ${sel.diagnostic}`);
}
console.log('SECTION-SELECTION: 26/26 applied; linkedPlanReference key = Source-plan for all');

const neg = async (label, mut) => {
  const kids = JSON.parse(JSON.stringify(children));
  mut(kids);
  const r = await reconcileWbsCoverage({
    tasks,
    acceptedPlanPath: planPath,
    acceptedPlanText: planText,
    children: kids,
    readPlanAtCommit,
  });
  console.log(
    'NEG',
    label,
    r.ok,
    r.coveredCount,
    (r.blockers[0] || '').slice(0, 80)
  );
};

await neg('missing one child', (k) => k.splice(5, 1));
await neg('duplicate section claim', (k) => {
  k[6].body = k[5].body;
});
await neg('wrong title', (k) => {
  k[3].title = 'Something else';
});
await neg('legacy 1a heading', (k) => {
  k[0].body = body(
    tasks[0],
    '### Task 1a: Inventory source/effects/flags and freeze the legacy workflow baseline'
  );
});
await neg('wrong commit', (k) => {
  k[9].body = k[9].body.split(commit).join('b'.repeat(40));
});

// Implementation-plan precedence probe: does a competing key deactivate the real gate?
const withImpl = [
  '## Plan Metadata',
  '',
  '- **Implementation-plan**: docs/superpowers/plans/old.md',
  `- **Source-plan**: ${planPath}`,
  `- **Source-plan-commit**: ${commit}`,
  `- **Source-plan-section**: ${tasks[0].heading}`,
  '',
].join('\n');
const implKey = linkedPlanReference(withImpl)?.key;
const implSel = selectDecompositionPlanSection({
  body: withImpl,
  planText,
  activePlanKey: implKey,
});
console.log(
  'PRECEDENCE competing Implementation-plan -> linkedPlanReference key=%s, gate applied=%s ok=%s',
  implKey,
  implSel.applied,
  implSel.ok
);
