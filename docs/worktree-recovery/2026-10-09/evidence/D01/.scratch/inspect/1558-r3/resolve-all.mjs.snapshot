import fs from 'node:fs';
import path from 'node:path';
import { parseVerificationCommands } from '../../../scripts/task-tracker/lib/verification-commands.mjs';
import { parseProofMarker } from '../../../scripts/task-tracker/lib/proof-marker.mjs';
import { resolveVcListStrict } from '../../../scripts/task-tracker/lib/vc-ref.mjs';
import { parseAcceptanceCriteria } from '../../../scripts/task-tracker/lib/acceptance-criteria.mjs';
const OUT = '.scratch/inspect/1558-r3/frag';
const r3 = fs.readFileSync('.scratch/inspect/1558-r3/wbs-r3.md', 'utf8');
const parts = r3.split(/^### Task (\d+): (.+)$/m);
const tasks = [];
for (let i = 1; i < parts.length; i += 3) tasks.push({ n: Number(parts[i]), title: parts[i+1].trim(), body: parts[i+2] });
let totalACs = 0, fails = 0, go = [];
for (const t of tasks) {
  const rendered = fs.readFileSync(path.join(OUT, String(t.n), 'rendered.md'), 'utf8');
  const cmds = parseVerificationCommands(rendered);
  const planCmds = [...t.body.split('**Verification Commands:**')[1].matchAll(/^Run: `(.+)`\s*$/gm)].map(m=>m[1]);
  // supplied commands must be ids 1..n in order
  for (const [i, c] of planCmds.entries()) {
    const e = cmds.find(x => x.id === i+1);
    if (!e || e.command !== c) { console.log(`TASK ${t.n}: supplied cmd ${i+1} mismatch: got ${e && e.command}`); fails++; }
  }
  const plannedACs = [...t.body.matchAll(/^- \[ \] (.+<!-- aitm-verified vc-list="[^"]+" -->)\s*$/gm)];
  const actualACs = parseAcceptanceCriteria(rendered);
  if (actualACs.length !== plannedACs.length) { console.log(`TASK ${t.n}: AC count planned=${plannedACs.length} actual=${actualACs.length}`); fails++; }
  for (const [i, ac] of actualACs.entries()) {
    totalACs++;
    const planned = parseProofMarker(plannedACs[i][1]);
    const actual = parseProofMarker(ac.label);
    if (actual?.['vc-list'] !== planned['vc-list']) { console.log(`TASK ${t.n} AC${i+1}: vc-list drift ${actual?.['vc-list']} vs ${planned['vc-list']}`); fails++; continue; }
    const intended = planned['vc-list'].split(/\s+/).map(ref => {
      const o = Number(ref.slice(3));
      if (!(o >= 1 && o <= planCmds.length)) { console.log(`TASK ${t.n} AC${i+1}: ordinal ${o} out of range 1..${planCmds.length}`); fails++; return null; }
      return planCmds[o-1];
    });
    let resolved;
    try { resolved = resolveVcListStrict(actual['vc-list'], cmds); }
    catch (e) { console.log(`TASK ${t.n} AC${i+1}: THROW ${e.message}`); fails++; continue; }
    if (JSON.stringify(resolved) !== JSON.stringify(intended)) {
      console.log(`TASK ${t.n} AC${i+1}: resolved != intended`);
      console.log('  resolved:', JSON.stringify(resolved));
      console.log('  intended:', JSON.stringify(intended));
      fails++;
    }
    if ((t.n === 8 || t.n === 9) && planned['vc-list'] === 'vc:3') {
      go.push({ task: t.n, ac: i+1, resolved });
    }
  }
}
console.log('total ACs resolved:', totalACs, 'failures:', fails);
console.log('GO citations:', JSON.stringify(go, null, 2));
