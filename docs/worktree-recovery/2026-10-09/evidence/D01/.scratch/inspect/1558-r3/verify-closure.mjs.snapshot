// Verify the author's round-3 closure claims: full scope+interfaces+steps in the
// scope fragment, only marker-bearing AC lines in the AC fragment, kind: code.
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';
import { parseIssueKind } from '../../../scripts/task-tracker/lib/issue-kind.mjs';
import { parseVerificationCommands } from '../../../scripts/task-tracker/lib/verification-commands.mjs';
import { parseProofMarker } from '../../../scripts/task-tracker/lib/proof-marker.mjs';
import { resolveVcListStrict } from '../../../scripts/task-tracker/lib/vc-ref.mjs';
import { parseAcceptanceCriteria } from '../../../scripts/task-tracker/lib/acceptance-criteria.mjs';
const ROOT = path.resolve('.');
const OUT = '.scratch/inspect/1558-r3/frag2';
fs.rmSync(OUT, { recursive: true, force: true }); fs.mkdirSync(OUT, { recursive: true });
const r3 = fs.readFileSync('.scratch/inspect/1558-r3/wbs-r3.md','utf8');
const parts = r3.split(/^### Task (\d+): (.+)$/m);
const tasks = []; for (let i=1;i<parts.length;i+=3) tasks.push({n:Number(parts[i]), title:parts[i+1].trim(), body:parts[i+2]});
let citations = 0, fails = 0, kinds = new Set(), acCounts = {};
for (const t of tasks) {
  const d = path.join(OUT, String(t.n)); fs.mkdirSync(d, {recursive:true});
  const story = t.body.split('**User story:**')[1].split(/\n\n/).filter(x=>x.trim())[0].split('\n').map(s=>s.trim()).filter(Boolean);
  fs.writeFileSync(path.join(d,'user-story.txt'), story.join('\n')+'\n');
  // scope = everything from Scope/files through the text just before the AC block (incl. interfaces + steps)
  const scopeStart = t.body.search(/\*\*Scope\/files/);
  const acStart = t.body.search(/\*\*Acceptance criteria:\*\*/i);
  fs.writeFileSync(path.join(d,'scope.txt'), t.body.slice(scopeStart, acStart).trim()+'\n');
  const acs = [...t.body.matchAll(/^- \[ \] (.+<!-- aitm-verified vc-list="[^"]+" -->)\s*$/gm)].map(m=>'- [ ] '+m[1]);
  acCounts[t.n] = acs.length;
  fs.writeFileSync(path.join(d,'acceptance-criteria.txt'), acs.join('\n')+'\n');
  const cmds = [...t.body.split('**Verification Commands:**')[1].matchAll(/^Run: `(.+)`\s*$/gm)].map(m=>m[1]);
  fs.writeFileSync(path.join(d,'verification-commands.txt'), cmds.join('\n')+'\n');
  fs.writeFileSync(path.join(d,'story-origin.txt'), '- kind: code\n- parent: #1558\n');
  fs.writeFileSync(path.join(d,'plan-metadata.txt'),
    `- Source-plan: docs/superpowers/plans/2026-09-16-1558-ask-the-script-guidance-hydration-wbs-r3.md\n- Source-plan-commit: 55dedc066701a9fce1066ac4ebebce58ed147638\n- Source-plan-section: ### Task ${t.n}: ${t.title}\n`);
  let body;
  try {
    body = execFileSync('node', ['scripts/task-tracker/preflight-issue.mjs','--shape','sub-issue','--parent','1558',
      '--title',t.title,'--rank',String(t.n),'--priority','p1',
      '--user-story-file',path.join(d,'user-story.txt'),'--scope-file',path.join(d,'scope.txt'),
      '--ac-file',path.join(d,'acceptance-criteria.txt'),'--story-origin-file',path.join(d,'story-origin.txt'),
      '--plan-metadata-file',path.join(d,'plan-metadata.txt'),'--verification-commands-file',path.join(d,'verification-commands.txt')],
      {encoding:'utf8', cwd:ROOT, maxBuffer:20*1024*1024});
  } catch (e) { console.log(`TASK ${t.n}: RENDER FAILED exit=${e.status} ${String(e.stderr||'').split('\n')[0]}`); fails++; continue; }
  kinds.add(parseIssueKind(body));
  const vc = parseVerificationCommands(body);
  const parsed = parseAcceptanceCriteria(body);
  if (parsed.length !== acs.length) { console.log(`TASK ${t.n}: AC count ${parsed.length} != ${acs.length} (steps leaked?)`); fails++; }
  for (const ac of parsed) {
    const m = parseProofMarker(ac.label);
    try { const r = resolveVcListStrict(m['vc-list'], vc);
      const want = m['vc-list'].split(/\s+/).map(x=>cmds[Number(x.slice(3))-1]);
      if (JSON.stringify(r)!==JSON.stringify(want)) { console.log(`TASK ${t.n}: resolved!=intended`); fails++; }
      citations++;
    } catch(e) { console.log(`TASK ${t.n}: THROW ${e.message}`); fails++; }
  }
}
console.log('rendered:', tasks.length - fails >= 0 ? '26 attempted' : '', 'failures:', fails);
console.log('parsed kinds:', [...kinds].join(','));
console.log('total resolvable AC citations:', citations);
console.log('WBS 9 AC count:', acCounts[9]);
