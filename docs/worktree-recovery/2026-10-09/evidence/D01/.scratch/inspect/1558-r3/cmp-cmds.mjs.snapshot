import fs from 'node:fs';
const base = fs.readFileSync('.scratch/inspect/1558-r3/baseline.md','utf8');
const r3 = fs.readFileSync('.scratch/inspect/1558-r3/wbs-r3.md','utf8');
// baseline VC table
const baseVc = new Map();
for (const m of base.matchAll(/^- \[ \] `(.+?)` <!-- id=(\d+) -->\s*$/gm)) {
  baseVc.set(Number(m[2]), m[1]);
}
// VC27 = separate foundation gate
const fg = base.match(/mandatory prerequisite to Task 2\):\*\* `(.+?)`/);
baseVc.set(27, fg[1]);
console.log('baseline VC ids:', [...baseVc.keys()].sort((a,b)=>a-b).join(','));
// r3 tasks
const sections = r3.split(/^### Task (\d+): /m);
const tasks = [];
for (let i=1;i<sections.length;i+=2) tasks.push({n:Number(sections[i]), body:sections[i+1]});
console.log('r3 tasks:', tasks.length);
let problems = 0;
for (const t of tasks) {
  const vcBlock = t.body.split('**Verification Commands:**')[1] || '';
  const groups = [];
  let cur = null;
  for (const line of vcBlock.split('\n')) {
    const pn = line.match(/^Plan verifier name: (VC\d+)[^;]*; issue-local IDs?: (.+)\.\s*$/);
    if (pn) { cur = {name:pn[1], ids:[...pn[2].matchAll(/vc:(\d+)/g)].map(x=>Number(x[1])), cmds:[]}; groups.push(cur); continue; }
    const run = line.match(/^Run: `(.+)`\s*$/);
    if (run && cur) cur.cmds.push(run[1]);
  }
  const allIds = groups.flatMap(g=>g.ids);
  const expectSeq = allIds.every((v,i)=>v===i+1);
  if (!expectSeq) { console.log(`TASK ${t.n}: ids not 1..n ->`, allIds); problems++; }
  for (const g of groups) {
    if (g.ids.length !== g.cmds.length) { console.log(`TASK ${t.n} ${g.name}: ids=${g.ids.length} cmds=${g.cmds.length}`); problems++; }
    const bn = Number(g.name.slice(2));
    if (baseVc.has(bn)) {
      const parts = baseVc.get(bn).split(' && ');
      const same = parts.length===g.cmds.length && parts.every((p,i)=>p===g.cmds[i]);
      if (!same) {
        console.log(`TASK ${t.n} ${g.name}: MISMATCH vs baseline`);
        console.log('  baseline parts:', JSON.stringify(parts));
        console.log('  r3 cmds       :', JSON.stringify(g.cmds));
        problems++;
      }
    } else {
      console.log(`TASK ${t.n} ${g.name}: NEW stage verifier (${g.cmds.length} cmd) - not in baseline`);
    }
    for (const c of g.cmds) {
      for (const needle of ['&&','||',';','|','>','<','`','$(']) {
        if (c.includes(needle)) { console.log(`TASK ${t.n} ${g.name}: FORBIDDEN "${needle}" in ${c}`); problems++; }
      }
    }
  }
}
console.log('problems:', problems);
