import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';
const ROOT = process.cwd();
const OUT = path.join(ROOT, '.scratch/inspect/1558-r3/frag');
fs.rmSync(OUT, { recursive: true, force: true });
fs.mkdirSync(OUT, { recursive: true });
const r3 = fs.readFileSync('.scratch/inspect/1558-r3/wbs-r3.md', 'utf8');
const parts = r3.split(/^### Task (\d+): (.+)$/m);
const tasks = [];
for (let i = 1; i < parts.length; i += 3) tasks.push({ n: Number(parts[i]), title: parts[i + 1].trim(), body: parts[i + 2] });
if (tasks.length !== 26) throw new Error('expected 26 tasks, got ' + tasks.length);
const results = [];
for (const t of tasks) {
  const d = path.join(OUT, String(t.n));
  fs.mkdirSync(d, { recursive: true });
  // user story: 3 lines after "**User story:**"
  const storyBlock = t.body.split('**User story:**')[1].split(/\n\n/).filter(Boolean)[0];
  const story = storyBlock.split('\n').map(s => s.trim()).filter(Boolean);
  fs.writeFileSync(path.join(d, 'user-story.txt'), story.join('\n') + '\n');
  // AC lines: every `- [ ] ... <!-- aitm-verified vc-list="..." -->`
  const acs = [...t.body.matchAll(/^- \[ \] (.+<!-- aitm-verified vc-list="[^"]+" -->)\s*$/gm)].map(m => '- [ ] ' + m[1]);
  fs.writeFileSync(path.join(d, 'acceptance-criteria.txt'), acs.join('\n') + '\n');
  // verification commands: bare, in Run: order
  const vcBlock = t.body.split('**Verification Commands:**')[1];
  const cmds = [...vcBlock.matchAll(/^Run: `(.+)`\s*$/gm)].map(m => m[1]);
  fs.writeFileSync(path.join(d, 'verification-commands.txt'), cmds.join('\n') + '\n');
  // scope: use the scope paragraph, heading-free
  const scopeM = t.body.match(/\*\*Scope\/files(?: and boundary)?:\*\*\s*([\s\S]*?)\n\n/);
  fs.writeFileSync(path.join(d, 'scope.txt'), (scopeM ? scopeM[1].trim() : 'Scope placeholder for offline render.') + '\n');
  fs.writeFileSync(path.join(d, 'story-origin.txt'), `- kind: code\n- parent: #1558\n`);
  fs.writeFileSync(path.join(d, 'plan-metadata.txt'),
    `- Source-plan: docs/superpowers/plans/2026-09-16-1558-ask-the-script-guidance-hydration-wbs-r3.md\n` +
    `- Source-plan-commit: 55dedc066701a9fce1066ac4ebebce58ed147638\n` +
    `- Source-plan-section: ### Task ${t.n}: ${t.title}\n` +
    `- Baseline-plan: docs/superpowers/plans/2026-09-16-1558-ask-the-script-guidance-replacement.md\n` +
    `- Baseline-plan-commit: a168753999617066d98bbc1227c4b5d97fa531c5\n`);
  let rendered, err = null;
  try {
    rendered = execFileSync('node', ['scripts/task-tracker/preflight-issue.mjs',
      '--shape', 'sub-issue', '--parent', '1558', '--title', t.title,
      '--rank', String(t.n), '--priority', 'p1',
      '--user-story-file', path.join(d, 'user-story.txt'),
      '--scope-file', path.join(d, 'scope.txt'),
      '--ac-file', path.join(d, 'acceptance-criteria.txt'),
      '--story-origin-file', path.join(d, 'story-origin.txt'),
      '--plan-metadata-file', path.join(d, 'plan-metadata.txt'),
      '--verification-commands-file', path.join(d, 'verification-commands.txt'),
    ], { encoding: 'utf8', cwd: ROOT, maxBuffer: 20 * 1024 * 1024 });
  } catch (e) {
    err = `exit=${e.status} stderr=${String(e.stderr || '').trim()}`;
  }
  if (err) { console.log(`TASK ${t.n}: RENDER FAILED ${err}`); results.push({ n: t.n, ok: false, err }); continue; }
  fs.writeFileSync(path.join(d, 'rendered.md'), rendered);
  results.push({ n: t.n, ok: true, acs: acs.length, cmds: cmds.length });
}
console.log('rendered ok:', results.filter(r => r.ok).length, '/ 26');
fs.writeFileSync(path.join(OUT, 'summary.json'), JSON.stringify(results, null, 2));
