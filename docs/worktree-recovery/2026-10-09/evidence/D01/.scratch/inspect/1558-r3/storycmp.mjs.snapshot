import fs from 'node:fs';
function stories(file) {
  const src = fs.readFileSync(file,'utf8');
  const parts = src.split(/^### Task (\d+): /m);
  const out = new Map();
  for (let i=1;i<parts.length;i+=2) {
    const b = parts[i+1];
    const seg = b.split('**User story:**')[1];
    const blk = seg.split(/\n\n/).filter(x=>x.trim())[0];
    out.set(Number(parts[i]), blk.trim().replace(/\n/g,' | '));
  }
  return out;
}
const a = stories('wbs-r2.md'), b = stories('wbs-r3.md');
let changed = 0;
for (const [n, v] of b) {
  if (a.get(n) !== v) { changed++; console.log(`--- Task ${n}`); console.log(' r2:', a.get(n)); console.log(' r3:', v); }
}
console.log('stories changed:', changed, 'of', b.size);
