import { mutateIssueBody } from '../../scripts/task-tracker/lib/issue-body-mutate.mjs';

const scopeAmendment = `
### Amended scope — provider-agnostic review invocation

Flagged mid-refine: the reviewer that runs in this gate must not be hard-coded
to Claude Code specifically. This repo already maintains a vendor-neutral
provider registry (scripts/providers/index.mjs /
scripts/providers/provider-adapter.mjs) covering Claude, Codex, and Grok
for skill install, transcripts, and hooks. The Test-stage review invocation
must route through the configured/detected provider the same way, not assume
a single Claude-Code-specific review-skill invocation.

In scope (added): resolve which of the valid AI providers (Claude, Codex,
Grok) performs the review from the same provider-detection/config surface the
rest of AITM already uses, and invoke that provider's own review capability
(CLI/action, whatever each vendor exposes) rather than a single hard-coded
command. Findings still land as PR comments regardless of which provider
produced them.

Out of scope (added): building review capability for a provider that does not
already expose one; per-provider quality parity is not guaranteed or graded by
this issue.
`;

const acAmendment =
  '- [ ] The review invocation resolves the active/configured AI provider (Claude, Codex, or Grok) through the existing provider registry rather than assuming a single hard-coded reviewer, and posts findings to the PR the same way regardless of which provider ran. <!-- aitm-verified vc-list="vc:1" -->\n';

const result = await mutateIssueBody({
  issueNumber: 1525,
  repo: 'kburson/ai-task-manager',
  mutate: (base) => {
    let next = base;
    const scopeHeadingIdx = next.indexOf('## Story Origin');
    if (scopeHeadingIdx === -1) throw new Error('Story Origin heading not found');
    next =
      next.slice(0, scopeHeadingIdx).replace(/\s*$/, '') +
      '\n' +
      scopeAmendment.trim() +
      '\n\n' +
      next.slice(scopeHeadingIdx);

    const acHeadingMatch = next.match(/^#{1,4}\s+Acceptance Criteria\b[^\n]*$/m);
    if (!acHeadingMatch) throw new Error('Acceptance Criteria heading not found');
    const acEnd = next.indexOf('\n## Verification Commands');
    if (acEnd === -1) throw new Error('Verification Commands heading not found');
    next = next.slice(0, acEnd).replace(/\s*$/, '') + '\n' + acAmendment + next.slice(acEnd);
    return next;
  },
});
console.log(result.status, result.version);
