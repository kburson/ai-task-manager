import os,json,subprocess,collections,re,concurrent.futures,csv,difflib
R=os.getcwd();D=R+'/.scratch/worktree-audit/';inv=json.load(open(D+'classified.json'));held=[d for d in inv['registered'] if d['category']=='PRESERVE-COMMITS'];assert len(held)==69
repoRoots={d['repo']:os.path.dirname(d['common']) for d in held};prFiles={'ai-task-manager':'squash-prs.json','ai-peer-review':'squash-peer-prs.json','pws-mock-dashboard':'squash-pws-prs.json'}
def git(root,args,input=None):
 r=subprocess.run(['git','-C',root]+args,input=input,capture_output=True,text=True,timeout=120)
 if r.returncode:raise RuntimeError(r.stderr[:1000])
 return r.stdout

def parseLog(s):
 out={}
 for block in s.split('\x1e'):
  f=block.strip('\n').split('\x1f',3)
  if len(f)==4:out[f[0]]={'sha':f[0],'parents':f[1].split(),'subject':f[2],'body':f[3]}
 return out

def norm(s):
 s=re.sub(r'\[#\d+\]|\bissue\s*#?\d+|#\d+',' ',s.lower());s=re.sub(r'\([^)]*\)$',' ',s);return ' '.join(re.findall(r'[a-z0-9]+',s))

def patchIds(root,shas):
 if not shas:return {}
 show=subprocess.Popen(['git','-C',root,'show','--format=commit %H','--binary','--no-ext-diff','--no-renames','--stdin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
 show.stdin.write(('\n'.join(sorted(shas))+'\n').encode());show.stdin.close()
 patch=subprocess.run(['git','patch-id','--stable'],stdin=show.stdout,capture_output=True,text=True,timeout=180);show.stdout.close();err=show.stderr.read();code=show.wait()
 if code or patch.returncode:raise RuntimeError(str(err)+patch.stderr)
 return {l.split()[1]:l.split()[0] for l in patch.stdout.splitlines() if len(l.split())==2}

results=[];allCommits=[];repoStats={}
for repo,root in repoRoots.items():
 print('Reading '+repo,flush=True)
 trunk=parseLog(git(root,['log','--format=%H%x1f%P%x1f%s%x1f%B%x1e','origin/trunk']));trunkShas=set(trunk)
 w=[d.copy() for d in held if d['repo']==repo];unique=set()
 for d in w:
  p=d['worktree'];d['currentHead']=git(p,['rev-parse','HEAD']).strip();d['branchNow']=git(p,['branch','--show-current']).strip();d['statusNow']=git(p,['status','--porcelain=v1','-uall']).strip()
  local=parseLog(git(root,['log','--format=%H%x1f%P%x1f%s%x1f%B%x1e','origin/trunk..'+d['currentHead']]));d['localCommits']=list(local);d['commitRecords']=local;unique.update(local)
 print(repo+': '+str(len(unique))+' unique commits across '+str(len(w))+' held worktrees.',flush=True)
 prs=json.load(open(D+prFiles[repo]));merged=[p for p in prs if p['state']=='MERGED' and p['baseRefName']=='trunk' and p.get('mergeCommit') and p['mergeCommit']['oid'] in trunkShas]
 candidates=[p for p in merged if p['headRefOid'] not in trunkShas]
 types=git(root,['cat-file','--batch-check=%(objectname) %(objecttype)'],input='\n'.join(p['headRefOid'] for p in candidates)+'\n').splitlines() if candidates else []
 available={z.split()[0] for z in types if z.endswith(' commit')};candidates=[p for p in candidates if p['headRefOid'] in available]
 def source(p):return p,git(root,['rev-list',p['headRefOid'],'--not','origin/trunk']).splitlines()
 sources={};sourceUnion=set()
 with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
  for p,ss in pool.map(source,candidates):
   for sha in ss:sources.setdefault(sha,[]).append(p)
   sourceUnion.update(ss)
 print(repo+': '+str(len(candidates))+' locally available merged PR source heads; indexing patch equivalence.',flush=True)
 # Match rebased source commits and single-commit squashes via stable patch IDs.
 needed=unique|sourceUnion
 patch=patchIds(root,needed);sourcePatch={}
 for sha,ps in sources.items():
  if sha in patch:sourcePatch.setdefault(patch[sha],[]).append({'sha':sha,'prs':ps})
 # Only trunk commits referenced by subject or SHA matches need a patch computation.
 messageIndex={};weakIndex={}
 localRecords={s:r for d in w for s,r in d['commitRecords'].items()}
 for sha,c in localRecords.items():
  exact=[];partial=[];ns=norm(c['subject'])
  for ts,t in trunk.items():
   body=t['body'];kind=None
   if sha in body:kind='full-source-sha'
   elif re.search(r'(?<![0-9a-f])'+sha[:8]+r'(?![0-9a-f])',body):kind='short-source-sha'
   elif c['subject'] in body:kind='exact-subject'
   elif len(ns.split())>=5 and len(ns)>=25 and ns in norm(body):kind='normalized-subject'
   if kind:exact.append({'trunkSha':ts,'subject':t['subject'],'match':kind})
   elif len(ns.split())>=6:
    nst=norm(t['subject']);score=difflib.SequenceMatcher(None,ns,nst).ratio()
    if score>=0.86:partial.append({'trunkSha':ts,'subject':t['subject'],'match':'similar-title','similarity':round(score,3)})
  messageIndex[sha]=exact;weakIndex[sha]=partial[:5]
 referenced={m['trunkSha'] for ms in messageIndex.values() for m in ms}
 trunkPatch=patchIds(root,referenced);reverseTrunk=collections.defaultdict(list)
 for s,pid in trunkPatch.items():reverseTrunk[pid].append(s)
 # Exact full branch diff equality with a known merged PR squash is strong final-effect evidence.
 aggregate={}
 for d in w:
  exact=[p for p in candidates if p['headRefOid']==d['currentHead']]
  for p in exact:
   mc=p['mergeCommit']['oid'];parents=trunk[mc]['parents']
   if len(parents)!=1:continue
   base=git(root,['merge-base',d['currentHead'],parents[0]]).strip()
   def diffId(a,b):
    raw=git(root,['diff','--binary','--no-ext-diff','--no-renames',a,b]);rr=subprocess.run(['git','patch-id','--stable'],input=raw,capture_output=True,text=True,check=True)
    return rr.stdout.split()[0] if rr.stdout.strip() else None
   a=diffId(base,d['currentHead']);b=diffId(parents[0],mc)
   if a and a==b:aggregate[d['currentHead']]={'pr':p['number'],'trunkSha':mc,'patchId':a,'base':base}
 outCommits={}
 for sha,c in localRecords.items():
  info=dict(c);info['repo']=repo;info['trunkMessageMatches']=messageIndex[sha];info['similarTitleMatches']=weakIndex[sha];info['patchId']=patch.get(sha);info['sourcePRs']=[];info['equivalentSourceCommits']=[];info['trunkPatchMatches']=reverseTrunk.get(patch.get(sha),[])
  for p in sources.get(sha,[]):info['sourcePRs'].append({'pr':p['number'],'sourceHead':p['headRefOid'],'trunkSha':p['mergeCommit']['oid'],'url':p['url'],'mergeParents':len(trunk[p['mergeCommit']['oid']]['parents'])})
  if not info['sourcePRs'] and sha in patch:
   for z in sourcePatch.get(patch[sha],[]):
    for p in z['prs']:info['equivalentSourceCommits'].append({'sourceSha':z['sha'],'pr':p['number'],'trunkSha':p['mergeCommit']['oid'],'url':p['url']})
  if info['sourcePRs']:info['classification']='VERIFIED-MERGED-PR-SOURCE'
  elif info['equivalentSourceCommits']:info['classification']='VERIFIED-REBASED-PATCH-IN-PR'
  elif info['trunkPatchMatches']:info['classification']='VERIFIED-TRUNK-PATCH-EQUIVALENT'
  elif info['trunkMessageMatches']:info['classification']='MESSAGE-TRACE-ONLY'
  elif len(c['parents'])>1:info['classification']='UNVERIFIED-MERGE-COMMIT'
  elif sha not in patch:info['classification']='NO-CONTENT-PATCH'
  else:info['classification']='UNMATCHED'
  outCommits[sha]=info
 for d in w:
  del d['commitRecords'];d['commitDetails']=[outCommits[s] for s in d['localCommits']];d['aggregatePatchProof']=aggregate.get(d['currentHead']);counts=collections.Counter(z['classification'] for z in d['commitDetails']);d['commitClasses']=dict(counts)
  if not d['localCommits']:d['squashAssessment']='ALREADY-REACHABLE-FROM-ORIGIN-TRUNK'
  elif all(z['classification'].startswith('VERIFIED-') for z in d['commitDetails']):d['squashAssessment']='ALL-COMMITS-VERIFIED-IN-DELIVERED-PR-OR-PATCH'
  elif all(z['classification'].startswith('VERIFIED-') or z['classification'] in ['MESSAGE-TRACE-ONLY','NO-CONTENT-PATCH'] for z in d['commitDetails']):d['squashAssessment']='ALL-COMMITS-TRACED-SOME-MESSAGE-ONLY'
  else:d['squashAssessment']='PARTIAL-OR-UNMATCHED-INVESTIGATE'
  results.append(d)
 allCommits.extend(outCommits.values());repoStats[repo]={'root':root,'trunk':git(root,['rev-parse','origin/trunk']).strip(),'uniqueLocalCommits':len(unique),'mergedSourceHeadsAvailable':len(candidates),'commitClasses':dict(collections.Counter(z['classification'] for z in outCommits.values()))}
 print(repo+': '+str(repoStats[repo]['commitClasses']),flush=True)
obj={'policy':'Investigation only. No deletion. Commit ancestry, merged PR source provenance, stable patch equivalence, and message-only traces are distinguished.','repoStats':repoStats,'worktrees':results,'uniqueCommits':allCommits}
json.dump(obj,open(D+'squash-investigation.json','w'),indent=2)
print('SAVED',len(results),'worktrees',len(allCommits),'unique repo-qualified commits')
print('ASSESSMENTS',dict(collections.Counter(w['squashAssessment'] for w in results)))
