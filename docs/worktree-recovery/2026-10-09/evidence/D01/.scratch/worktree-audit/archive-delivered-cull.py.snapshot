import json,os,subprocess,hashlib,tarfile,time
R=os.getcwd();D=R+'/.scratch/worktree-audit/';A=R+'/.db/aitm/worktree-archives/2026-09-30/delivered-cull';os.makedirs(A,exist_ok=True)
manifest=[m for m in json.load(open(D+'delivered-cull-preflight.json')) if m['status']=='preflight-passed']
assert len(manifest)==40
for m in manifest:
 p=m['path'];label=('codex-'+p.split('/worktrees/')[1].replace('/','-')) if '/.codex/worktrees/' in p else ('claude-'+os.path.basename(p) if '/.claude/worktrees/' in p else 'project-'+os.path.basename(p))
 dest=A+'/'+label+'.tar.gz';hashes={};links={}
 with tarfile.open(dest,'w:gz',compresslevel=4) as tf:
  for base,dirs,files in os.walk(p,followlinks=False):
   dirs[:]=[n for n in dirs if n!='node_modules' and not (base==p and n=='.git')]
   for n in list(dirs):
    full=base+'/'+n
    if os.path.islink(full):
     rel=os.path.relpath(full,p);tf.add(full,arcname=rel,recursive=False);links[rel]=os.readlink(full);dirs.remove(n)
   for n in files:
    if base==p and n=='.git':continue
    full=base+'/'+n;rel=os.path.relpath(full,p)
    if os.path.islink(full):links[rel]=os.readlink(full)
    elif os.path.isfile(full):
     h=hashlib.sha256()
     with open(full,'rb') as f:
      for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
     hashes[rel]=h.hexdigest()
    else:raise RuntimeError('Unexpected special file '+full)
    tf.add(full,arcname=rel,recursive=False)
 with tarfile.open(dest,'r:gz') as tf:
  seen=set()
  for member in tf:
   if member.isfile():
    h=hashlib.sha256();f=tf.extractfile(member)
    for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
    assert hashes[member.name]==h.hexdigest(),member.name;seen.add(member.name)
   elif member.issym():assert links[member.name]==member.linkname;seen.add(member.name)
   else:raise RuntimeError('Unexpected archive member '+member.name)
  assert seen==set(hashes)|set(links)
 m.update(archive=dest,files=len(hashes),symlinks=len(links),archiveBytes=os.path.getsize(dest),status='archive-verified')
 json.dump(hashes,open(dest+'.sha256.json','w'),indent=2)
 json.dump(manifest,open(A+'/manifest.json','w'),indent=2)
 print('Verified archive '+label+' ('+str(len(hashes))+' files).',flush=True)
json.dump(manifest,open(A+'/manifest.json','w'),indent=2)
print('Prepared and verified all archives; no worktree removed yet.')
