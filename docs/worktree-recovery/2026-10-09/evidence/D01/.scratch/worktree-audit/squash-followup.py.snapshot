import json,subprocess,collections,concurrent.futures,os
D=os.getcwd()+'/.scratch/worktree-audit/'
x=json.load(open(D+'squash-investigation.json'))
files={'ai-task-manager':'squash-prs.json','ai-peer-review':'squash-peer-prs.json','pws-mock-dashboard':'squash-pws-prs.json'}
def git(root,args,input=None):
 r=subprocess.run(['git','-C',root]+args,input=input,capture_output=True,text=True,timeout=180);r.check_returncode();return r.stdout

def patchIds(root,shas,u0=False):
 if not shas:return {}
 args=['git','-C',root,'show','--format=commit %H','--binary','--no-ext-diff','--no-renames','--stdin']
 if u0:args.append('--unified=0')
 show=subprocess.Popen(args,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
 show.stdin.write(('\n'.join(sorted(shas))+'\n').encode());show.stdin.close()
 patch=subprocess.run(['git','patch-id','--stable'],stdin=show.stdout,capture_output=True,text=True,timeout=240);show.stdout.close();err=show.stderr.read();code=show.wait()
 if code or patch.returncode:raise RuntimeError(str(err)+patch.stderr)
 return {l.split()[1]:l.split()[0] for l in patch.stdout.splitlines() if len(l.split())==2}
for repo,stat in x['repoStats'].items():
 root=stat['root'];cs=[c for c in x['uniqueCommits'] if c['repo']==repo and not c['classification'].startswith('VERIFIED-')]
 if not cs:continue
 print(repo+': checking '+str(len(cs))+' unresolved commits against all trunk patches',flush=True)
 trunk=set(git(root,['rev-list','origin/trunk']).splitlines());tp=patchIds(root,trunk);rev=collections.defaultdict(list)
 for s,p in tp.items():rev[p].append(s)
 for c in cs:
  hits=rev.get(c['patchId'],[])
  if hits:c['trunkPatchMatches']=hits;c['classification']='VERIFIED-TRUNK-PATCH-EQUIVALENT'
 cs=[c for c in cs if not c['classification'].startswith('VERIFIED-')]
 ps=[p for p in json.load(open(D+files[repo])) if p['state']=='MERGED' and p['baseRefName']=='trunk' and p.get('mergeCommit') and p['mergeCommit']['oid'] in trunk and p['headRefOid'] not in trunk]
 types=git(root,['cat-file','--batch-check=%(objectname) %(objecttype)'],input='\n'.join(p['headRefOid'] for p in ps)+'\n').splitlines() if ps else [];avail={z.split()[0] for z in types if z.endswith(' commit')};ps=[p for p in ps if p['headRefOid'] in avail]
 def source(p):return p,git(root,['rev-list',p['headRefOid'],'--not','origin/trunk']).splitlines()
 sources={}
 with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
  for p,ss in pool.map(source,ps):
   for s in ss:sources.setdefault(s,[]).append(p)
 pp=patchIds(root,set(sources)|trunk|{c['sha'] for c in cs},True);reverse=collections.defaultdict(list)
 for s,p in pp.items():
  if s in sources or s in trunk:reverse[p].append(s)
 for c in cs:
  matches=[]
  for s in reverse.get(pp.get(c['sha']),[]):
   if s==c['sha']:continue
   if s in trunk:matches.append({'sha':s,'trunkSha':s,'kind':'trunk'})
   for p in sources.get(s,[]):matches.append({'sha':s,'pr':p['number'],'url':p['url'],'trunkSha':p['mergeCommit']['oid'],'kind':'merged-pr-source'})
  c['contextFreePatchMatches']=matches
  if matches:c['classification']='MATCHED-CONTEXT-FREE-DELTA-REVIEW'
  if c['classification']=='MESSAGE-TRACE-ONLY' and c['subject'] in ['Peer review revision 1','Peer review revision 2']:
   c['classification']='GENERIC-MESSAGE-COINCIDENCE';c['messageWarning']='Repeated generic review subject appears in unrelated issue squash messages; not credible delivery evidence.'
 stat['commitClasses']=dict(collections.Counter(c['classification'] for c in x['uniqueCommits'] if c['repo']==repo))
 print(repo+': '+str(stat['commitClasses']),flush=True)
lookup={(c['repo'],c['sha']):c for c in x['uniqueCommits']}
for w in x['worktrees']:
 w['commitDetails']=[lookup[w['repo'],s] for s in w['localCommits']];w['commitClasses']=dict(collections.Counter(c['classification'] for c in w['commitDetails']))
 if not w['localCommits']:w['squashAssessment']='ALREADY-REACHABLE-FROM-ORIGIN-TRUNK'
 elif all(c['classification'].startswith('VERIFIED-') for c in w['commitDetails']):w['squashAssessment']='ALL-COMMITS-VERIFIED-IN-DELIVERED-PR-OR-PATCH'
 elif all(c['classification'].startswith('VERIFIED-') or c['classification']=='MATCHED-CONTEXT-FREE-DELTA-REVIEW' for c in w['commitDetails']):w['squashAssessment']='ALL-DELTAS-MATCH-SOME-CONTEXT-FREE-REVIEW'
 else:w['squashAssessment']='PARTIAL-OR-UNMATCHED-INVESTIGATE'
json.dump(x,open(D+'squash-investigation.json','w'),indent=2)
print('Assessments',dict(collections.Counter(w['squashAssessment'] for w in x['worktrees'])),flush=True)
