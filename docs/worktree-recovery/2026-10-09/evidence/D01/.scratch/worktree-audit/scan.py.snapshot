import os,json,subprocess,re,concurrent.futures
R=os.getcwd();D=R+'/.scratch/worktree-audit';roots=[R+'/.worktrees',R+'/.claude/worktrees',os.path.expanduser('~/.codex/worktrees')]
def git(p,a):
 try:
  x=subprocess.run(['git','-C',p]+a,text=True,capture_output=True,timeout=20)
  return x.stdout.strip() if x.returncode==0 else 'ERROR: '+x.stderr.strip()
 except subprocess.TimeoutExpired:return 'ERROR: timeout'
def blocks(raw):
 out=[]
 for b in raw.split('\n\n'):
  d={}
  for l in b.splitlines():
   k,_,v=l.partition(' ');d[k]=v
  if 'worktree'in d:out.append(d)
 return out
physical=[];residue=[];empty=[]
for root in roots:
 if not os.path.isdir(root):continue
 for base,dirs,files in os.walk(root):
  dirs[:]=[d for d in dirs if d not in ['node_modules','.git','.tmp','.scratch','.venv','dist','build']]
  if os.path.lexists(base+'/.git'):
   common=git(base,['rev-parse','--git-common-dir']);physical.append({'path':base,'common':os.path.realpath(os.path.join(base,common)) if not common.startswith('ERROR:') else common})
 # root-level remaining folders (Codex has a wrapper directory)
 for n in os.listdir(root):
  p=root+'/'+n
  if not os.path.isdir(p):continue
  candidates=[p] if root!=roots[2] else [p+'/'+x for x in os.listdir(p) if os.path.isdir(p+'/'+x)]
  if not candidates:empty.append(p)
  for c in candidates:
   if not os.path.lexists(c+'/.git'):
    sample=[]
    for b,ds,fs in os.walk(c):
     ds[:]=[x for x in ds if x not in ['node_modules','.git']]
     for f in fs:
      sample.append(os.path.relpath(b+'/'+f,c))
      if len(sample)>=60:break
     if len(sample)>=60:break
    residue.append({'path':c,'sample':sample,'sampleCapped':len(sample)>=60})
commons={x['common'] for x in physical if not x['common'].startswith('ERROR:')};allreg=[]
for c in commons:
 main=os.path.dirname(c)
 for d in blocks(git(main,['worktree','list','--porcelain'])):
  p=d['worktree']
  if p==main:continue
  if not any(p.startswith(rt+'/') for rt in roots):continue
  d['common']=c;d['repo']=os.path.basename(main);allreg.append(d)
def inspect(d):
 p=d['worktree'];d['exists']=os.path.isdir(p);d['ownGit']=os.path.lexists(p+'/.git')
 if not d['exists'] or not d['ownGit']:return d
 d['top']=git(p,['rev-parse','--show-toplevel'])
 if os.path.realpath(d['top'])!=os.path.realpath(p):d['identityError']='Git resolves to parent';return d
 d['status']=git(p,['status','--porcelain=v1','-uall']);d['last']=git(p,['log','-1','--format=%cI %s']);d['ignoredRoots']=git(p,['status','--porcelain=v1','--ignored','--untracked-files=normal']).splitlines()
 d['runtimeFiles']=[]
 for sub in ['.scratch','.tmp','.superpowers','.db']:
  for b,ds,fs in os.walk(p+'/'+sub):
   ds[:]=[x for x in ds if x not in ['node_modules','.git','cache','guidance-cache']]
   for f in fs:
    d['runtimeFiles'].append(os.path.relpath(b+'/'+f,p))
    if len(d['runtimeFiles'])>=80:break
   if len(d['runtimeFiles'])>=80:break
  if len(d['runtimeFiles'])>=80:break
 d['runtimeFilesCapped']=len(d['runtimeFiles'])>=80
 main=os.path.dirname(d['common']);ref=git(main,['symbolic-ref','--short','refs/remotes/origin/HEAD']);d['target']=ref if not ref.startswith('ERROR:') else ('origin/trunk' if d['repo'] in ['ai-task-manager','ai-peer-review'] else 'origin/main')
 d['ahead']=git(p,['rev-list','--count',d['target']+'..HEAD'])
 d['localOnly']=git(p,['rev-list','--count','HEAD','--not','--remotes'])
 d['unique']=git(p,['log','--max-count=8','--oneline',d['target']+'..HEAD'])
 print(d['repo']+' '+p+' '+d['ahead']+' ahead, '+str(len(d['status'].splitlines()))+' dirty',flush=True)
 return d
with concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex:rows=list(ex.map(inspect,allreg))
obj={'roots':roots,'physical':physical,'registered':rows,'residue':residue,'emptyWrappers':empty}
json.dump(obj,open(D+'/all-locations.json','w'),indent=2)
print('TOTAL',len(physical),'physical',len(rows),'registered',len(residue),'residue',len(empty),'empty wrappers')
