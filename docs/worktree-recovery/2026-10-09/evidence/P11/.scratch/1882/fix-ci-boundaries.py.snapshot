from pathlib import Path
import json
for name in ['merge-back-cli','merge-back-verification']:
    old=Path('scripts/tests/unit/task-tracker')/(name+'.test.mjs')
    new=Path('scripts/tests/integration/task-tracker')/(name+'.test.mjs')
    old.rename(new)
p=Path('scripts/tests/unit/task-tracker/core/package-boundary.test.mjs');s=p.read_text()
s=s.replace('// @story ', '// @story #1882 ',1)
s=s.replace('  const recoveryEntryAllowance = 1;', "  const recoveryEntryAllowance = 1;\n  // #1882 ships exactly the provider runner and registered CLI routing helper.\n  const childIntegrationEntries = [\n    'scripts/task-tracker/lib/merge-back-verification.mjs',\n    'scripts/task-tracker/lib/merge-back-cli.mjs',\n  ];\n  for (const entry of childIntegrationEntries) assert.ok(files.includes(entry));")
s=s.replace('    recoveryEntryAllowance +', '    recoveryEntryAllowance +\n    childIntegrationEntries.length +')
p.write_text(s)
old='node --test scripts/tests/unit/task-tracker/merge-back.test.mjs scripts/tests/unit/task-tracker/merge-back-cli.test.mjs scripts/tests/unit/task-tracker/merge-back-verification.test.mjs'
new=old.replace('unit/task-tracker/merge-back-cli','integration/task-tracker/merge-back-cli').replace('unit/task-tracker/merge-back-verification','integration/task-tracker/merge-back-verification')
Path('.scratch/gh/1882-vcs-relocation.json').write_text(json.dumps({'schema':'aitm.issue-body-operation/v1','kind':'replace-exact','expected':old,'replacement':new},indent=2)+'\n')
