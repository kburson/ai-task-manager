from pathlib import Path
import json
root=Path('.scratch/gh');root.mkdir(exist_ok=True)
old='\n'.join(['- [ ] `node --test scripts/tests/unit/task-tracker/merge-back.test.mjs` <!-- id=1 -->','- [ ] `npm test` <!-- id=2 -->','- [ ] `npm run test:slow` <!-- id=3 -->'])
new='\n'.join(['- [ ] `node --test scripts/tests/unit/task-tracker/merge-back.test.mjs scripts/tests/unit/task-tracker/merge-back-cli.test.mjs scripts/tests/unit/task-tracker/merge-back-verification.test.mjs` <!-- id=1 -->','- [ ] `node scripts/maintenance/verify-ci-receipts.mjs` <!-- id=2 -->','- [ ] `node scripts/maintenance/verify-ci-receipts.mjs` <!-- id=3 -->'])
(root/'1882-vcs.json').write_text(json.dumps({'schema':'aitm.issue-body-operation/v1','kind':'replace-exact','expected':old,'replacement':new},indent=2)+'\n')
(root/'1882-functional-tests.json').write_text(json.dumps({'schema':'aitm.issue-body-operation/v1','kind':'replace-verifier-declaration','expected':'<!-- aitm-verified cmd="`npm test` `npm run test:slow`" -->','replacement':'<!-- aitm-verified cmd="`node scripts/maintenance/verify-ci-receipts.mjs`" -->'},indent=2)+'\n')
(root/'1882-pr.md').write_text('Child integration currently ignores a project verification provider and launches all host suites, then removes the checkout needed for completion. This change runs the validated project Test plan and issue declarations, preserves Node defaults, and adds `--preserve-worktree` for completing approval and closure from the child checkout.\n\nIntegration runs in the authoritative parent checkout, pins the tested commit, and refuses failed evidence, source changes, malformed provider configuration, or changed parent checkout before merging. Stale CI evidence requires pushing the rebased child and obtaining fresh CI receipts.\n\nValidation: red-to-green behavioral regressions; 42 focused tests pass, repository lint passes. Canonical TIA and complete CI verification follow on this PR.\n\nRefs #1882\n')
