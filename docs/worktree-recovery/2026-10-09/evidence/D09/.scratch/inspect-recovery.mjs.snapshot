import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { execFileSync } from 'node:child_process';
const input=JSON.parse(fs.readFileSync('.scratch/recovery-input.json'));
const git=(cwd,args)=>execFileSync('git',args,{cwd,encoding:'utf8',maxBuffer:128*1024*1024});
const refs=git(input.cwd,['ls-remote','--heads','origin']).trim().split('\n').map(x=>x.split('\t')[0]);
const reachable=new Set(git(input.cwd,['rev-list','--objects',...new Set(refs)]).split('\n').map(x=>x.split(' ')[0]));
const blob=b=>crypto.createHash('sha1').update(Buffer.from(`blob ${b.length}\0`)).update(b).digest('hex');
const secretPatterns=[/-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/,/\b(?:ghp_|github_pat_|sk-proj-)[A-Za-z0-9_-]{20,}/,/\bAKIA[A-Z0-9]{16}\b/,/\b(?:api[_-]?key|access[_-]?token|password|client[_-]?secret)\s*["']?\s*[:=]\s*["'][A-Za-z0-9_\/.+-]{24,}["']/i];
const groups=[];
for(const r of [...input.groups,{id:'D01',path:input.main,head:git(input.main,['rev-parse','HEAD']).trim(),branch:'refs/heads/trunk'}]){
 const row={id:r.id,path:r.path,head:r.head,branch:r.branch,prs:r.prs??[],entries:[],errors:[]};
 const valid=fs.existsSync(path.join(r.path,'.git'));
 row.valid=valid;
 if(!valid){groups.push(row);continue;}
 const tracked=new Set(git(r.path,['ls-files','-z']).split('\0').filter(Boolean));
 const changed=git(r.path,['diff','--name-only','HEAD','-z']).split('\0').filter(Boolean);
 const untracked=git(r.path,['ls-files','--others','--exclude-standard','-z']).split('\0').filter(Boolean);
 const ignored=git(r.path,['ls-files','--others','--ignored','--exclude-standard','-z','.scratch','.aitm','.ai-task-manager/runtime','.db']).split('\0').filter(Boolean);
 const seen=new Set();
 for(const f of [...changed,...untracked,...ignored]){
  if(seen.has(f))continue;seen.add(f);
  const full=path.join(r.path,f);let st;try{st=fs.lstatSync(full);}catch{row.entries.push({path:f,kind:'deleted',tracked:tracked.has(f),publish:true});continue;}
  const generated=/^(?:\.scratch\/(?:test|npm-cache|archive-proof-[^/]+)|\.ai-task-manager\/runtime)(?:\/|$)/.test(f)||/\/node_modules(?:\/|$)|\/\.git(?:\/|$)/.test(f);
  if(generated){row.entries.push({path:f,kind:'generated-cache-or-fixture',size:st.size,publish:false});continue;}
  if(st.isDirectory()){row.entries.push({path:f,kind:'nested-directory',publish:false});continue;}
  const bytes=st.isSymbolicLink()?Buffer.from(fs.readlinkSync(full)):fs.readFileSync(full);
  const sha=blob(bytes),available=reachable.has(sha),secret=secretPatterns.some(re=>re.test(bytes.toString('utf8')));
  const archive=f.startsWith('.db/')&&f.endsWith('.tar.gz');
  row.entries.push({path:f,kind:archive?'prior-worktree-archive':tracked.has(f)?'tracked-change':untracked.includes(f)?'untracked':'ignored-evidence',size:bytes.length,sha256:crypto.createHash('sha256').update(bytes).digest('hex'),gitBlob:sha,alreadyOnOrigin:available,secret,symlink:st.isSymbolicLink(),publish:!available&&!secret&&!archive,source:full});
 }
 groups.push(row);
}
fs.writeFileSync('.scratch/recovery-inspection.json',JSON.stringify({originRefs:refs,groups},null,2)+'\n');
for(const g of groups){const publish=g.entries.filter(e=>e.publish);console.log(JSON.stringify({id:g.id,files:g.entries.length,publishFiles:publish.length,publishBytes:publish.reduce((n,e)=>n+(e.size??0),0),secrets:g.entries.filter(e=>e.secret).map(e=>e.path),largest:publish.filter(e=>e.size>5e6).map(e=>({path:e.path,size:e.size})),archiveCount:g.entries.filter(e=>e.kind==='prior-worktree-archive').length}));}
