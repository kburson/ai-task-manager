{
  "schema": "aitm.plan-estimation-input/v1",
  "wbs": [
    {
      "id": "history-extraction",
      "description": "Create and filter the immutable source-history boundary",
      "baseHumanHours": 4,
      "signals": {
        "modules": ["git-history", "filter-repo"],
        "dependencies": ["source-commit", "retained-path-rules"]
      },
      "independentlyReviewable": true
    },
    {
      "id": "extraction-verifier",
      "description": "Test and implement the closed extraction verifier",
      "baseHumanHours": 5,
      "signals": {
        "modules": ["verification", "unit-tests"],
        "dependencies": ["manifest-schema", "git-observation"]
      },
      "independentlyReviewable": true
    },
    {
      "id": "provenance-scan",
      "description": "Capture provenance inventories and scan complete history",
      "baseHumanHours": 3,
      "signals": {
        "modules": ["provenance", "security"],
        "dependencies": ["gitleaks", "contributor-audit"]
      },
      "independentlyReviewable": true
    },
    {
      "id": "license-bootstrap",
      "description": "Verify signed relicensing and commit the standalone boundary",
      "baseHumanHours": 2,
      "signals": {
        "modules": ["licensing", "repository-bootstrap"],
        "dependencies": ["signed-declaration", "apache-license"]
      },
      "independentlyReviewable": true
    }
  ],
  "testImpact": {
    "lanes": ["unit", "security", "git-history"],
    "isolation": "fresh standalone repository clone",
    "expectedMinutes": 30
  },
  "risks": [
    "Relicensing signer authority is unavailable",
    "Secret scanning finds retained credentials or private material",
    "History filtering retains a path outside the closed allowlist"
  ],
  "comparableIssueIds": []
}
