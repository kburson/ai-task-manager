          "scripts/task-tracker/lib/shelve-transaction.mjs"
        ],
        "dependencies": [
          "Legacy blocker marker parser",
          "Versioned issue body mutation"
        ]
      }
    },
    {
      "id": "verification-and-docs",
      "description": "Add focused regression coverage and update operator documentation",
      "baseHumanHours": 1,
      "independentlyReviewable": true,
      "signals": {
        "modules": [
          "scripts/tests/unit/task-tracker",
          "docs/guides"
        ],
        "dependencies": [
          "Node test runner",
          "Repository quality pipeline"
        ]
      }
    }
  ],
  "testImpact": {
    "lanes": [
      "unit",
      "integration",
      "slow"
    ],
    "isolation": "Injected GitHub and Project adapters for focused tests; repository suites run serially in the governed worktree",
    "expectedMinutes": 18
