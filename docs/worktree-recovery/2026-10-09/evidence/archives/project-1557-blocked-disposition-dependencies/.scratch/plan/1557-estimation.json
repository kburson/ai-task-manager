      "description": "Implement interruption-safe migration and remove runtime legacy authority reads",
      "baseHumanHours": 1.5,
      "independentlyReviewable": true,
      "signals": {
        "modules": [
          "scripts/task-tracker/verbs/migrate-dependencies.mjs",
