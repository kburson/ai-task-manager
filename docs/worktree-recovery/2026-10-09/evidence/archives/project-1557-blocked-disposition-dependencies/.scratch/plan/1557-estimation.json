{
  "schema": "aitm.plan-estimation-input/v1",
  "wbs": [
    {
      "id": "native-adapter",
      "description": "Implement and verify the native GitHub dependency adapter",
      "baseHumanHours": 1.5,
      "independentlyReviewable": true,
      "signals": {
        "modules": [
          "scripts/task-tracker/lib/native-dependencies.mjs",
          "scripts/gh/lib/github-projects.mjs"
        ],
        "dependencies": [
          "GitHub issue dependency read API",
          "GitHub issue dependency mutation CLI"
        ]
      }
    },
    {
      "id": "projection-and-gates",
      "description": "Implement transient Disposition projection and lifecycle gate reconciliation",
      "baseHumanHours": 2,
      "independentlyReviewable": true,
      "signals": {
        "modules": [
          "scripts/task-tracker/lib/dependency-disposition.mjs",
          "scripts/task-tracker/lib/blocked-by-guard.mjs",
          "scripts/task-tracker/lib/epic-children-gate.mjs"
        ],
        "dependencies": [
          "GitHub Projects Status field",
          "GitHub Projects Disposition field"
        ]
      }
    },
    {
      "id": "commands-and-reconciliation",
      "description": "Rewrite block and unblock set commands and eager and lazy reconciliation callers",
      "baseHumanHours": 2,
      "independentlyReviewable": true,
      "signals": {
        "modules": [
          "scripts/task-tracker/verbs/block.mjs",
          "scripts/task-tracker/verbs/unblock.mjs",
          "scripts/task-tracker/lib/unpark-dependents.mjs",
          "scripts/task-tracker/verbs/pull-next.mjs"
        ],
        "dependencies": [
