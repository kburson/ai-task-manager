// Add vc:8 and the reopened-close recovery ACs to #1490 through the governed mutator.
import { loadConfig } from '../../scripts/task-tracker/config.mjs';
import { mutateIssueBody } from '../../scripts/task-tracker/lib/issue-body-mutate.mjs';

const VC8 =
  'node --test scripts/tests/unit/task-tracker/lib/reopened-close-recovery.test.mjs ' +
  'scripts/tests/unit/task-tracker/lib/delivered-close-supersession.test.mjs ' +
  'scripts/tests/unit/task-tracker/lib/close-convergence.test.mjs ' +
  'scripts/tests/unit/task-tracker/verbs/close-delivered-idempotence.test.mjs';

const NEW_ACS = [
  '- [ ] `--restart-reopened-transaction` authorizes only a single valid transaction whose eight completed steps are exactly the ordered terminal sequence, whose accepted SHA differs from current authority, on an OPEN/REOPENED issue in Review with disposition Delivered and a clean unambiguous binding. <!-- aitm-verified vc-list="vc:8" -->',
  '- [ ] Durable supersession evidence naming both transactions, both accepted SHAs, both delivery authorities, actor, timestamp, and the `completed-close-reopened-corrective-delivery` reason is written and read-back verified BEFORE the active marker is replaced. <!-- aitm-verified vc-list="vc:8" -->',
  '- [ ] The replacement transaction is bound to the current accepted SHA with zero completed steps, and the normal eight-step close saga then converges through Done and issue closure. <!-- aitm-verified vc-list="vc:8" -->',
  '- [ ] Partial, reordered, malformed, duplicate, same-SHA, non-REOPENED, non-Review, non-Delivered, dirty, unbound, and stale-evidence states each refuse before mutation, and without the flag the existing `terminal-state-conflict` refusal is unchanged. <!-- aitm-verified vc-list="vc:8" -->',
  '- [ ] The recovery is idempotent across a lost response, reusing the same replacement identity, and `--restart-stale-transaction`, ordinary close, and generic issue-body marker protection are all unchanged. <!-- aitm-verified vc-list="vc:8" -->',
];

const cfg = loadConfig();
const write = await mutateIssueBody({
  issueNumber: 1490,
  repo: cfg.repo,
  mutate: (fresh) => {
    if (fresh.includes('--restart-reopened-transaction` authorizes only')) return fresh;
    const lines = fresh.split('\n');

    // Append vc:8 after the last existing Verification Command entry.
    const vcStart = lines.findIndex((l) => l.trim() === '## Verification Commands');
    if (vcStart === -1) throw new Error('amend: VC section missing');
    let vcLast = vcStart;
    let maxId = 0;
    for (let i = vcStart + 1; i < lines.length; i += 1) {
      if (lines[i].startsWith('## ')) break;
      const id = lines[i].match(/<!-- id=(\d+) -->/);
      if (id) {
        vcLast = i;
        maxId = Math.max(maxId, Number(id[1]));
      }
    }
    lines.splice(vcLast + 1, 0, `- [ ] \`${VC8}\` <!-- id=${maxId + 1} -->`);

    // Append the new ACs after the last existing acceptance criterion.
    const acStart = lines.findIndex((l) => l.trim() === '## Acceptance Criteria');
    if (acStart === -1) throw new Error('amend: AC section missing');
    let acLast = acStart;
    for (let i = acStart + 1; i < lines.length; i += 1) {
      if (lines[i].startsWith('## ')) break;
      if (/^- \[.\] /.test(lines[i])) acLast = i;
    }
    lines.splice(acLast + 1, 0, ...NEW_ACS);
    return lines.join('\n');
  },
});
console.log('acs amended:', typeof write?.body === 'string');
