import { execFileSync } from 'node:child_process';
import { readDeliveredCloseTransactions } from '../../scripts/task-tracker/lib/close-convergence.mjs';

const body = execFileSync(
  'gh',
  ['issue', 'view', '1490', '-R', 'kburson/ai-task-manager', '--json', 'body', '--jq', '.body'],
  { encoding: 'utf8' }
);
const transactions = readDeliveredCloseTransactions(body);
console.log('delivered-close transactions:', transactions.length);
for (const t of transactions) {
  console.log(JSON.stringify(t, null, 2));
}
