// Disposable, exact-target retirement of #1490's stranded Test receipt.
// The receipt id is read from the decoded marker payload, not transcribed.
import { loadConfig } from '../../scripts/task-tracker/config.mjs';
import { retireVerificationReceipt } from '../../scripts/task-tracker/lib/verification-receipt-retirement.mjs';

const cfg = loadConfig();
const result = await retireVerificationReceipt({
  cfg,
  issueNumber: 1490,
  stage: 'test',
  receiptId: '01M1KGH3WQKXPBGY8YPD0SXEGZ',
});
console.log('retire status:', result.status);
console.log('still present:', result.body.includes('01M1KGH3WQKXPBGY8YPD0SXEGZ'));
