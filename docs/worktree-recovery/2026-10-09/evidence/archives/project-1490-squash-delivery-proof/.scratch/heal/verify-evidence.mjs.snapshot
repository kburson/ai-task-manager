import { readFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';

const HEAD = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
const body = readFileSync('./.scratch/gh/1490-body.md', 'utf8');

console.log('final HEAD:', HEAD);
console.log('--- markers naming a sha ---');
const marker = /<!-- (aitm-[a-z-]+)[^>]*?sha="([0-9a-f]{40})"[^>]*-->/g;
let m;
while ((m = marker.exec(body)) !== null) {
  console.log((m[2] === HEAD ? 'OK   ' : 'STALE') + '  ' + m[1] + '  ' + m[2].slice(0, 12));
}

console.log('--- checkbox proof shas ---');
const counts = new Map();
for (const line of body.split('\n')) {
  if (!/^\s*- \[.\] /.test(line)) continue;
  const sha = (line.match(/\bsha="([0-9a-f]{40})"/) || [])[1];
  if (!sha) continue;
  const key = sha === HEAD ? 'final HEAD' : 'STALE ' + sha.slice(0, 12);
  counts.set(key, (counts.get(key) || 0) + 1);
}
for (const [key, count] of counts) console.log(count + ' checkbox(es) @ ' + key);

console.log('--- AC section ---');
const start = body.indexOf('## Acceptance Criteria');
const end = body.indexOf('## Verification Commands');
for (const line of body.slice(start, end).split('\n')) {
  const box = line.match(/^- \[(.)\] (.{0,52})/);
  if (!box) continue;
  const vc = (line.match(/vc-list="([^"]*)"/) || [])[1];
  const sha = (line.match(/\bsha="([0-9a-f]{40})"/) || [])[1];
  console.log(
    '[' + box[1] + '] vc=' + vc + ' sha=' + (sha ? sha.slice(0, 8) : 'none') + ' :: ' + box[2].trim()
  );
}
