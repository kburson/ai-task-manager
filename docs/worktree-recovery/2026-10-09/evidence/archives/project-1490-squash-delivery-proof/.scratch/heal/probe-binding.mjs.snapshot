// Read-only: determine WHICH conflict branch fires for #1490 and with what values.
import { readFileSync } from 'node:fs';
import { currentSessionId } from '../../scripts/task-tracker/word-counter.mjs';

const MAIN = '/Users/kpburson/projects/Vibe-Coding/ai-task-manager';
const sessionId = currentSessionId();
console.log('invoking sessionId:', sessionId);

const ledger = JSON.parse(readFileSync(`${MAIN}/.tmp/aitm/fleet/closed-bindings.json`, 'utf8'));
const entry = ledger.sessions?.[sessionId]?.['#1490'] ?? null;
console.log('ledger closedAt for this session/#1490:', JSON.stringify(entry));

const occupancy = JSON.parse(readFileSync(`${MAIN}/.tmp/aitm/fleet/occupancy.json`, 'utf8'));
const row = occupancy['1490'] ?? null;
console.log('occupancy row for 1490:', JSON.stringify(row));

if (entry && row) {
  const closedMs = Date.parse(entry.closedAt);
  const boundMs = Date.parse(row.boundAt);
  console.log('--- branch A (occupancy) analysis ---');
  console.log('  foreign session? ', row.sid !== sessionId, `(row.sid=${row.sid})`);
  console.log('  bound after close?', boundMs > closedMs, `(boundAt=${row.boundAt} vs closedAt=${entry.closedAt})`);
}
