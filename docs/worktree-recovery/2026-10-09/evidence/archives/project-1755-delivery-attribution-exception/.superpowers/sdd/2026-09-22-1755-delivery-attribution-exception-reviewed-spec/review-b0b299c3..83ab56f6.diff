+
+test('raw first-line mapping subjects retain tabs and edge spaces', () => {
+  const mappings = [
+    { oid: A, messageHeadline: ' leading subject ', issueNumber: 1755 },
+    { oid: B, messageHeadline: 'tab\tsubject', issueNumber: 1755 },
