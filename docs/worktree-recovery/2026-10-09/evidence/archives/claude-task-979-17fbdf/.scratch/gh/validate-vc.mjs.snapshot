import { readFileSync } from 'node:fs';
import { validateVerificationCommand } from '../../scripts/task-tracker/lib/verification-allowlist.mjs';

const body = readFileSync('.scratch/gh/1784-body7.md', 'utf8');
let inVc = false;
for (const line of body.split('\n')) {
  if (/^## Verification Commands/.test(line)) {
    inVc = true;
    continue;
  }
  if (inVc && /^## /.test(line)) break;
  if (!inVc) continue;
  const m = line.match(/^- \[[ x]\] `(.+)` <!-- id=(\d+) -->/);
  if (!m) continue;
  const r = validateVerificationCommand(m[1], { projectDir: process.cwd() });
  console.log(`${r.ok ? 'ok   ' : 'BAD  '} id=${m[2]} ${r.ok ? '' : r.reason} :: ${m[1].slice(0, 80)}`);
}
