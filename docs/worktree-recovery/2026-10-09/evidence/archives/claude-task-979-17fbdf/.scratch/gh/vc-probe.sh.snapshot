#!/bin/sh
set -u
P='docs/peer-reviews/spec/2026-09-22-2026-09-22-1755-delivery-attribution-exception-design-review-cc015b243c3fe236325ac37f5899783f/review-cc015b243c3fe236325ac37f5899783f-reviewer-response-3.md'

echo "--- vc2 candidate"
node -e 'const c=require("crypto"),f=require("fs");const p=process.argv[1];const h=c.createHash("sha256").update(f.readFileSync(p)).digest("hex");console.log(h);process.exit(h==="3a7e022fa7c1bc11c61e894d04b68658b78b287dfd917ea12a9736cfbebe9993"?0:1)' "$P"
echo "vc2 exit=$?"

echo "--- vc5 candidate"
node -e 'const{execFileSync}=require("child_process");const out=execFileSync("git",["diff","--name-status","origin/trunk...HEAD"],{encoding:"utf8"}).trim();console.log(out);const want="A\t"+process.argv[1];process.exit(out===want?0:1)' "$P"
echo "vc5 exit=$?"
