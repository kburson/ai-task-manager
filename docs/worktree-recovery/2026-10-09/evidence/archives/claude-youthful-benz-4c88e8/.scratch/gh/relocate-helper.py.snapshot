p = 'scripts/task-tracker/verbs/close.mjs'
s = open(p).read()

start = s.index('// #1562 - a pull request merged with a method')
end = s.index('}\n\n', s.index('export function buildDeliveryGateRefusal')) + len('}\n\n')
block = s[start:end]
assert 'buildDeliveryGateRefusal' in block

s = s[:start] + s[end:]

note = (
    '\n'
    '// #1562 - deliberately at the END of this file. `scripts/tests/fixtures/\n'
    '// state-engine-policy-baseline.mjs` characterizes timing-emitter call sites\n'
    "// by hardcoded line number, so inserting anything above them shifts every\n"
    '// entry and turns an unrelated change into fixture churn. Appending keeps the\n'
    '// diff honest. Function declarations hoist, so the call site above is fine.\n'
)
s = s.rstrip('\n') + '\n' + note + block.rstrip('\n') + '\n'
open(p, 'w').write(s)
print('relocated', len(block.split('\n')), 'lines')
