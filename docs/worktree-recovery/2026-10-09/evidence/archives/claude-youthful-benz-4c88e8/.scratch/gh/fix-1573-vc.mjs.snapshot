import { mutateIssueBody } from '../../scripts/task-tracker/lib/issue-body-mutate.mjs';
import { loadConfig } from '../../scripts/task-tracker/config.mjs';

const cfg = await loadConfig();

// One well-formed list. Keeps the shape's default entries (they are the real
// docs-only verifiers) and adds the targeted help test, with unique ids.
const VC = [
  '- [ ] `npm run lint` <!-- id=1 -->',
  '- [ ] `npm run format:check` <!-- id=2 -->',
  '- [ ] `node --test scripts/tests/unit/task-tracker/verbs/help.test.mjs` <!-- id=3 -->',
  '- [ ] `npm run test:unit` <!-- id=4 -->',
  '- [ ] `npm test` <!-- id=5 -->',
  '- [ ] `npm run test:slow` <!-- id=6 -->',
  '- [ ] `git log --oneline -1` <!-- id=7 -->',
];

const HEAD = new RegExp('^## ');

const res = await mutateIssueBody({
  issueNumber: 1573,
  repo: cfg.repo,
  mutate: (body) => {
    const lines = body.split('\n');
    const start = lines.findIndex((l) => l.trim() === '## Verification Commands');
    if (start === -1) throw new Error('Verification Commands heading not found');
    let end = lines.length;
    for (let i = start + 1; i < lines.length; i += 1) {
      if (HEAD.test(lines[i])) {
        end = i;
        break;
      }
    }
    return [
      ...lines.slice(0, start),
      '## Verification Commands',
      '',
      ...VC,
      '',
      ...lines.slice(end),
    ].join('\n');
  },
});
console.log('vc:', JSON.stringify(res?.status ?? res));
