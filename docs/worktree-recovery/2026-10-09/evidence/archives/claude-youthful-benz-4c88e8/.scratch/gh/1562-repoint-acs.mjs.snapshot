import { mutateIssueBody } from '../../scripts/task-tracker/lib/issue-body-mutate.mjs';
import { loadConfig } from '../../scripts/task-tracker/config.mjs';

const cfg = await loadConfig();

// AC label prefix -> vc citation. Each AC now cites the test file that actually
// proves it, rather than a whole lane.
const CITATIONS = [
  ['A merged pull request whose observed merge method differs', 'vc:3 vc:6'],
  ['The receipt written by that lane records the merge method actually observed', 'vc:3'],
  ['The lane requires an explicit flag and an operator-supplied reason', 'vc:6'],
  ['The lane refuses when the pull request is unmerged', 'vc:4 vc:5'],
  ['`delivery-verification.mjs` still refuses to write a receipt', 'vc:4'],
  ['The operator-facing refusal message names the recovery lane', 'vc:7'],
];

// AC2 wording is narrowed to match the separate-record design recorded in the
// deep dive: the receipt carries the observed method, the divergence flag lives
// in the reconciliation record beside it. Recorded openly, not edited silently.
const AC2_OLD =
  'The receipt written by that lane records the merge method actually observed and flags it as divergent from the configured intent';
const AC2_NEW =
  'The receipt records the merge method actually observed, and an append-only reconciliation record beside it flags the divergence from the configured intent';

const BOX = new RegExp('^- \\[[ x]\\] ');

const res = await mutateIssueBody({
  issueNumber: 1562,
  repo: cfg.repo,
  mutate: (body) => {
    const lines = body.split('\n');
    let inAc = false;
    return lines
      .map((line) => {
        if (line.startsWith('## ')) inAc = line.trim() === '## Acceptance Criteria';
        if (!inAc || !BOX.test(line)) return line;
        let next = line.replace(AC2_OLD, AC2_NEW);
        for (const [prefix, cite] of CITATIONS) {
          if (!next.includes(prefix) && !next.includes(AC2_NEW.slice(0, 40))) continue;
          if (next.includes(prefix) || (prefix.startsWith('The receipt') && next.includes(AC2_NEW.slice(0, 40)))) {
            next = next.replace(/vc-list="[^"]*"/, `vc-list="${cite}"`);
            break;
          }
        }
        return next;
      })
      .join('\n');
  },
});
console.log('repoint:', JSON.stringify(res?.status ?? res));
