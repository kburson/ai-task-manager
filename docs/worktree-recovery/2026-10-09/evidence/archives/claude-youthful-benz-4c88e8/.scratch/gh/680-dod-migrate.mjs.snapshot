import { mutateIssueBody } from '../../scripts/task-tracker/lib/issue-body-mutate.mjs';
import { loadConfig } from '../../scripts/task-tracker/config.mjs';

const cfg = await loadConfig();

const LEGACY = [
  '- [ ] Passed final human review',
  '- [ ] Story closed and moved to Done',
  '- [ ] Timing data flushed to issue',
].join('\n');

const CURRENT = [
  '### Lifecycle (verified at Review)',
  '',
  '- [ ] Agent Review Passed',
  '- [ ] Final Review Passed',
  '',
  '### Housekeeping (verified at Close)',
  '',
  '- [ ] Story closed and moved to Done',
  '- [ ] Timing data flushed to issue',
].join('\n');

const res = await mutateIssueBody({
  issueNumber: 680,
  repo: cfg.repo,
  mutate: (body) => {
    if (!body.includes(LEGACY)) {
      throw new Error('legacy DoD lifecycle block not found verbatim — refusing to guess');
    }
    // Drop the now-stale legacy subsection heading that preceded the three boxes.
    return body
      .replace(LEGACY, CURRENT)
      .replace(/### Lifecycle \(auto-ticked at Review\/Close\)\n\n(?=### Lifecycle)/, '');
  },
});
console.log('dod-migrate:', JSON.stringify(res?.status ?? res));
