# ai-task-manager — user configuration files (do not commit)
.ai-task-manager/task-tracker-state.json
.ai-task-manager/task-tracker-queue.json
.ai-task-manager/task-fleet.json
.ai-task-manager/pickup-directive.md.bak
.ai-task-manager/definition-of-done.md.bak
# pickup-directive.md + definition-of-done.md are skill-installed but
# team-editable shared templates (like task-tracker.json) — tracked in git so
# fresh worktrees and the Test gate receive them with no seeding step (#569).
# Install-output copies of templates/ (regenerable; templates/ is the source)
.ai-task-manager/session-boot.md
.ai-task-manager/session-state-template.md
.ai-task-manager/worker-report.md
.ai-task-manager/epic-body.md
.ai-task-manager/solo-issue-body.md
.ai-task-manager/sub-issue-body.md
.ai-task-manager/references/
# Runtime project-field caches (ephemeral)
.ai-task-manager/project-fields.json
.ai-task-manager/project-field-events.json
# Content-addressed verifier-result cache (#446) — ephemeral; MUST stay ignored
# so writing it never dirties the tree (a dirty tree disables every cache hit).
.ai-task-manager/cache/
.ai-task-manager/orchestrator.lock
# Per-issue advisory lock dirs (mkdir-based; ephemeral) — #214
.ai-task-manager/locks/
# Per-app ephemeral session state (markers, transcripts) — never committed
.ai-task-manager/claude/
.ai-task-manager/codex/
# Per-host install artifacts (Claude Code / Codex / Agents — regenerable from skill/)
.claude/
.agents/

.worktrees/
.claude/task-tracker.json
.claude/task-tracker-state.json
.claude/task-tracker-queue.json
.claude/task-fleet.json
# Session-scoped auto-mode overrides (#89) — per-chat, never committed
.claude/task-tracker.session.*.json

