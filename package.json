{
  "name": "@kburson/ai-task-manager",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Bind AI coding sessions to GitHub issues and track time, context, state, and completion workflow",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Kendrick Burson <spam.kpb@gmail.com>",
  "homepage": "https://github.com/kburson/ai-task-manager",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-task-manager": "bin/cli.mjs",
    "aitm": "bin/aitm.mjs",
    "github-project-report": "scripts/reports/generate-value-report.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs --lane fast",
    "test:unit": "node scripts/run-tests.mjs --lane unit",
    "test:integration": "node scripts/run-tests.mjs --lane integration",
    "test:slow": "node scripts/run-tests.mjs --lane slow",
    "test:timing-tz:utc": "TZ=UTC node --test scripts/tests/unit/task-tracker/core/gh-timing-comment.test.mjs scripts/tests/unit/task-tracker/core/gh-timing-comment-backdated-row.test.mjs",
    "test:timing-tz:chicago": "TZ=America/Chicago node --test scripts/tests/unit/task-tracker/core/gh-timing-comment.test.mjs scripts/tests/unit/task-tracker/core/gh-timing-comment-backdated-row.test.mjs",
    "test:unit:utc": "TZ=UTC node scripts/run-tests.mjs --lane unit",
    "test:coverage": "c8 node scripts/run-tests.mjs --lane all",
    "test:coverage:fast": "c8 node scripts/run-tests.mjs --lane fast",
    "publish:articles": "node scripts/articles/publish-articles.mjs",
    "book": "node scripts/articles/compose-book.mjs",
    "doctor:book": "node scripts/articles/compose-book.mjs --doctor",
    "lint:book-markers": "node scripts/maintenance/lint-book-markers.mjs",
    "log-time": "node scripts/gh/log-issue-time.mjs",
    "report:value": "node scripts/reports/generate-value-report.mjs",
    "report:value:pdf": "node scripts/reports/generate-value-report.mjs --pdf",
    "prepare": "node scripts/task-tracker/ensure-self-link.mjs",
    "link:self": "node scripts/task-tracker/ensure-self-link.mjs",
    "release": "npm publish --access public",
    "sync:templates": "node scripts/sync-templates.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:spell": "cspell --no-progress \"**/*.{md,mjs,js,json}\"",
    "lint:tmp": "node scripts/maintenance/lint-no-system-tmp.mjs",
    "lint:fleet-sandbox": "node scripts/maintenance/lint-fleet-sandbox-isolation.mjs",
    "lint:test-layout": "node scripts/tests/tools/audit-test-layout.mjs",
    "lint:story-tags": "node scripts/tests/tools/audit-story-tags.mjs",
    "lint:line-cap": "node scripts/tests/tools/audit-line-cap.mjs",
    "lint:test-reach": "node scripts/maintenance/lint-test-coverage-reach.mjs",
    "lint:doc-anchors": "node scripts/maintenance/lint-doc-anchors.mjs",
    "lint:article-citations": "node scripts/maintenance/lint-article-citations.mjs",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:spell && npm run lint:tmp && npm run lint:fleet-sandbox && npm run lint:test-layout && npm run lint:story-tags && npm run lint:line-cap && npm run lint:test-reach && npm run lint:doc-anchors && npm run lint:article-citations",
    "quality": "npm run format:check && npm run lint && npm test"
  },
  "files": [
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE",
    "bin/",
    "config/",
    "skill/",
    "hooks/",
    "scripts/",
    "!scripts/tests/**",
    "!scripts/maintenance/**",
    "!scripts/articles/**",
    "!**/*.test.mjs",
    "statusline/",
    "docs/README.md",
    "docs/QUICKSTART.md",
    "docs/DESIGN.md",
    "docs/guides/",
    "docs/ai-memory/",
    "!docs/ai-memory/archive/**",
    "templates/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai-agent",
    "github",
    "github-projects",
    "task-tracker",
    "time-tracking",
    "ai",
    "anthropic",
    "agile",
    "scrum",
    "kanban"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kburson/ai-task-manager.git"
  },
  "bugs": {
    "url": "https://github.com/kburson/ai-task-manager/issues"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "c8": "^10.1.3",
    "cspell": "^8.19.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.42.0"
  },
  "dependencies": {
    "espree": "^10.4.0"
  }
}
