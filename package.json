{
  "name": "@burson.kendrick/claude-gh-task-manager",
  "version": "1.0.11",
  "description": "Claude Code /task skill — bind AI sessions to GitHub issues and auto-log time + context words",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-gh-task-manager": "bin/cli.mjs",
    "github-project-report": "scripts/reports/generate-value-report.mjs"
  },
  "scripts": {
    "log-time": "node scripts/gh/log-issue-time.mjs",
    "report:value": "node scripts/reports/generate-value-report.mjs --html",
    "report:value:pdf": "node scripts/reports/generate-value-report.mjs --pdf"
  },
  "files": [
    "bin/",
    "skill/",
    "hooks/",
    "scripts/",
    "statusline/",
    "docs/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "github",
    "task-tracker",
    "time-tracking",
    "ai",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kburson/claude-gh-task-manager.git"
  },
  "bugs": {
    "url": "https://github.com/kburson/claude-gh-task-manager/issues"
  },
  "devDependencies": {
    "@burson.kendrick/claude-gh-task-manager": "^1.0.0",
    "puppeteer": "^24.42.0"
  }
}
