{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD040": false,
    "MD036": false,
    "MD026": false,
    "MD029": false,
    "MD028": false,
    "MD001": false,
    "MD060": false,
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md", "!.tmp/**"],
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".worktrees/**",
    ".claude/worktrees/**",
    "reports/**",
    "coverage/**",
    "output/**",
    "docs/postmortems/**",
    "docs/ai-memory/**",
    ".ai-task-manager/memory/**"
  ]
}
